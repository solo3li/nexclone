@model NexClone.Backend.Core.Entities.Plan
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer
@{
    ViewData["Title"] = "Manage Wallets for " + Model.Name;
    var walletTypes = ViewBag.WalletTypes as List<NexClone.Backend.Core.Entities.WalletType> ?? new List<NexClone.Backend.Core.Entities.WalletType>();
    var tools = ViewBag.Tools as List<NexClone.Backend.Core.Entities.ToolConfiguration> ?? new List<NexClone.Backend.Core.Entities.ToolConfiguration>();
}

<div class="bx--grid" style="padding-left: 0;">
    
    <!-- Page Header -->
    <div class="bx--row" style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h2 style="margin: 0; font-weight: 400; font-size: 1.5rem;">@ViewData["Title"]</h2>
            <p style="color: #525252; margin: 0.25rem 0 0 0; font-size: 0.875rem;">@Localizer["Configure wallet credit allocations and tool-to-wallet routing for this plan."]</p>
        </div>
        <a href="@Url.Action("Index")" class="bx--btn bx--btn--secondary">@Localizer["Back to Plans"]</a>
    </div>

    <form asp-action="ManageWallets" method="post">
        <input type="hidden" asp-for="Id" />

        <!-- Section 1: Base Wallet Allocations -->
        <div class="bx--row" style="margin-bottom: 2rem;">
            <div class="bx--col">
                <div style="background: #ffffff; border: 1px solid #e0e0e0;">
                    <div style="background: #0f62fe; padding: 1rem 1.5rem;">
                        <h3 style="color: white; margin: 0; font-size: 1rem; font-weight: 600;">
                            @Localizer["1. Base Wallet Allocations"]
                        </h3>
                        <p style="color: rgba(255,255,255,0.75); margin: 0.25rem 0 0 0; font-size: 0.8rem;">
                            @Localizer["Define how many credits this plan grants to each wallet type when a user subscribes."]
                        </p>
                    </div>

                    <div style="padding: 1.5rem;">
                        @if (!walletTypes.Any())
                        {
                            <div style="padding: 1rem; background: #fff8e1; border-left: 4px solid #f59e0b; margin-bottom: 1rem; color: #78350f;">
                                No Wallet Types found. Please create some from 
                                <a href="@Url.Action("Index", "WalletTypesAdmin")" style="color: #0f62fe; font-weight: bold;">@Localizer["Wallet Types"]</a> first.
                            </div>
                        }

                        <div class="bx--data-table-container" style="margin-bottom: 1rem;">
                            <table class="bx--data-table bx--data-table--zebra" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th><span class="bx--table-header-label">@Localizer["Wallet Type"]</span></th>
                                        <th><span class="bx--table-header-label">@Localizer["Credits to Grant on Subscription"]</span></th>
                                        <th><span class="bx--table-header-label">@Localizer["Action"]</span></th>
                                    </tr>
                                </thead>
                                <tbody id="baseWalletsBody">
                                    @foreach (var pw in Model.PackageWallets)
                                    {
                                        <tr>
                                            <td>
                                                <div class="bx--select">
                                                    <select name="walletTypeIds" class="bx--select-input" required>
                                                        @foreach (var wt in walletTypes)
                                                        {
                                                            if (wt.Id == pw.WalletTypeId)
                                                            {
                                                                <option value="@wt.Id" selected>@wt.Name (@wt.Code)</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@wt.Id">@wt.Name (@wt.Code)</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                            </td>
                                            <td>
                                                <input type="number" name="creditsAmounts" class="bx--text-input" step="0.01" min="0" value="@pw.CreditsAmount" required style="max-width: 180px;" />
                                            </td>
                                            <td>
                                                <button type="button" class="bx--btn bx--btn--sm bx--btn--danger" onclick="removeRow(this)">@Localizer["Remove"]</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (!Model.PackageWallets.Any())
                        {
                            <div id="baseWalletsEmpty" style="text-align: center; padding: 1.5rem; color: #8d8d8d; border: 1px dashed #e0e0e0; margin-bottom: 1rem;">
                                @Localizer["No wallet allocations added yet. Click the button below to add one."]
                            </div>
                        }
                        <button type="button" class="bx--btn bx--btn--sm bx--btn--tertiary" onclick="addBaseWalletRow()">
                            @Localizer["+ Add Wallet Allocation"]
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 2: Tool-to-Wallet Routing -->
        <div class="bx--row" style="margin-bottom: 2rem;">
            <div class="bx--col">
                <div style="background: #ffffff; border: 1px solid #e0e0e0;">
                    <div style="background: #6929c4; padding: 1rem 1.5rem;">
                        <h3 style="color: white; margin: 0; font-size: 1rem; font-weight: 600;">
                            @Localizer["2. Tool-to-Wallet Routing"]
                        </h3>
                        <p style="color: rgba(255,255,255,0.75); margin: 0.25rem 0 0 0; font-size: 0.8rem;">
                            @Localizer["Choose which wallet each tool deducts credits from. Tools not listed here will default to the GENERAL wallet."]
                        </p>
                    </div>

                    <div style="padding: 1.5rem;">
                        @if (!tools.Any())
                        {
                            <div style="padding: 1rem; background: #fff8e1; border-left: 4px solid #f59e0b; margin-bottom: 1rem; color: #78350f;">
                                No Tools configured. Add tools from 
                                <a href="@Url.Action("Index", "ToolConfigAdmin")" style="color: #0f62fe; font-weight: bold;">@Localizer["Tool Settings"]</a> first.
                            </div>
                        }

                        <div class="bx--data-table-container" style="margin-bottom: 1rem;">
                            <table class="bx--data-table bx--data-table--zebra" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th><span class="bx--table-header-label">@Localizer["Tool"]</span></th>
                                        <th><span class="bx--table-header-label">@Localizer["Deduct Credits From Wallet"]</span></th>
                                        <th><span class="bx--table-header-label">@Localizer["Action"]</span></th>
                                    </tr>
                                </thead>
                                <tbody id="toolWalletsBody">
                                    @foreach (var ptw in Model.PackageToolWallets)
                                    {
                                        <tr>
                                            <td>
                                                <div class="bx--select">
                                                    <select name="toolIds" class="bx--select-input" required>
                                                        @foreach (var tool in tools)
                                                        {
                                                            if (tool.Id == ptw.ToolConfigurationId)
                                                            {
                                                                <option value="@tool.Id" selected>@tool.ToolName</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@tool.Id">@tool.ToolName</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="bx--select">
                                                    <select name="toolWalletTypeIds" class="bx--select-input" required>
                                                        @foreach (var wt in walletTypes)
                                                        {
                                                            if (wt.Id == ptw.WalletTypeId)
                                                            {
                                                                <option value="@wt.Id" selected>@wt.Name (@wt.Code)</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@wt.Id">@wt.Name (@wt.Code)</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                            </td>
                                            <td>
                                                <button type="button" class="bx--btn bx--btn--sm bx--btn--danger" onclick="removeRow(this)">@Localizer["Remove"]</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (!Model.PackageToolWallets.Any())
                        {
                            <div id="toolWalletsEmpty" style="text-align: center; padding: 1.5rem; color: #8d8d8d; border: 1px dashed #e0e0e0; margin-bottom: 1rem;">
                                @Localizer["No tool routing rules added yet. Click the button below to assign a tool to a wallet."]
                            </div>
                        }
                        <button type="button" class="bx--btn bx--btn--sm bx--btn--tertiary" onclick="addToolWalletRow()">
                            @Localizer["+ Add Tool Routing Rule"]
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Save -->
        <div class="bx--row">
            <div class="bx--col">
                <div style="display: flex; gap: 1rem;">
                    <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Save Wallet Configuration"]</button>
                    <a href="@Url.Action("Index")" class="bx--btn bx--btn--secondary">@Localizer["Cancel"]</a>
                </div>
            </div>
        </div>

    </form>
</div>

@section Scripts {
    <script>
        // Build wallet type options HTML server-side data
        var walletOptions = `@foreach (var wt in walletTypes) {<text><option value="@wt.Id">@wt.Name (@wt.Code)</option></text>}`;
        var toolOptions = `@foreach (var tool in tools) {<text><option value="@tool.Id">@tool.ToolName</option></text>}`;

        function removeRow(btn) {
            btn.closest('tr').remove();
        }

        function addBaseWalletRow() {
            var tbody = document.getElementById('baseWalletsBody');
            var tr = document.createElement('tr');
            tr.innerHTML = `
                <td>
                    <div class="bx--select">
                        <select name="walletTypeIds" class="bx--select-input" required>
                            <option value="">-- Select Wallet Type --</option>
                            ${walletOptions}
                        </select>
                    </div>
                </td>
                <td>
                    <input type="number" name="creditsAmounts" class="bx--text-input" step="0.01" min="0" value="0" required style="max-width: 180px;" />
                </td>
                <td>
                    <button type="button" class="bx--btn bx--btn--sm bx--btn--danger" onclick="removeRow(this)">@Localizer["Remove"]</button>
                </td>
            `;
            tbody.appendChild(tr);
            var emptyMsg = document.getElementById('baseWalletsEmpty');
            if (emptyMsg) emptyMsg.style.display = 'none';
        }

        function addToolWalletRow() {
            var tbody = document.getElementById('toolWalletsBody');
            var tr = document.createElement('tr');
            tr.innerHTML = `
                <td>
                    <div class="bx--select">
                        <select name="toolIds" class="bx--select-input" required>
                            <option value="">-- Select Tool --</option>
                            ${toolOptions}
                        </select>
                    </div>
                </td>
                <td>
                    <div class="bx--select">
                        <select name="toolWalletTypeIds" class="bx--select-input" required>
                            <option value="">-- Select Wallet --</option>
                            ${walletOptions}
                        </select>
                    </div>
                </td>
                <td>
                    <button type="button" class="bx--btn bx--btn--sm bx--btn--danger" onclick="removeRow(this)">@Localizer["Remove"]</button>
                </td>
            `;
            tbody.appendChild(tr);
            var emptyMsg = document.getElementById('toolWalletsEmpty');
            if (emptyMsg) emptyMsg.style.display = 'none';
        }
    </script>
}

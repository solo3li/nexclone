@model NexClone.Backend.Core.Entities.Plan
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

<div class="bx--grid" style="padding-left: 0; max-width: 800px; margin-left: 0;">
    <div class="bx--row" style="margin-bottom: 2rem;">
        <h2 style="margin: 0; font-weight: 400; font-size: 1.5rem;">@ViewData["Title"]</h2>
    </div>

    <form action="@Url.Action("Create")" method="post" style="background: #ffffff; padding: 2rem; border: 1px solid #e0e0e0;">
        @Html.AntiForgeryToken()

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
            <div class="bx--form-item">
                <label for="Name" class="bx--label">@Localizer["Plan Name"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="Name" type="text" class="bx--text-input" name="Name" required value="@Model?.Name">
                </div>
            </div>
            <div class="bx--form-item">
                <label for="NameAr" class="bx--label">@Localizer["Plan Name (Arabic)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="NameAr" type="text" class="bx--text-input" name="NameAr" required value="@Model?.NameAr" dir="rtl">
                </div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
            <div class="bx--form-item">
                <label for="Description" class="bx--label">@Localizer["Description"]</label>
                <div class="bx--text-input__field-wrapper">
                    <textarea id="Description" class="bx--text-area" name="Description" rows="2">@Model?.Description</textarea>
                </div>
            </div>
            <div class="bx--form-item">
                <label for="DescriptionAr" class="bx--label">@Localizer["Description (Arabic)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <textarea id="DescriptionAr" class="bx--text-area" name="DescriptionAr" rows="2" dir="rtl">@Model?.DescriptionAr</textarea>
                </div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
            <div class="bx--form-item">
                <label for="Features" class="bx--label">@Localizer["Features (one per line)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <textarea id="Features" class="bx--text-area" name="Features" rows="6" placeholder="Feature 1&#10;Feature 2&#10;Feature 3">@Model?.Features</textarea>
                </div>
            </div>
            <div class="bx--form-item">
                <label for="FeaturesAr" class="bx--label">@Localizer["Features (Arabic) (one per line)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <textarea id="FeaturesAr" class="bx--text-area" name="FeaturesAr" rows="6" dir="rtl" placeholder="ميزة 1&#10;ميزة 2&#10;ميزة 3">@Model?.FeaturesAr</textarea>
                </div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
            <div class="bx--form-item">
                <label for="DurationDays" class="bx--label">@Localizer["Duration (Days)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="DurationDays" type="number" class="bx--text-input" name="DurationDays" required min="1" value="@(Model?.DurationDays ?? 30)">
                </div>
            </div>
            <div class="bx--form-item">
                <label for="GracePeriodDays" class="bx--label">@Localizer["Grace Period (Days)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="GracePeriodDays" type="number" class="bx--text-input" name="GracePeriodDays" required min="0" value="@(Model?.GracePeriodDays ?? 3)">
                </div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
            <div class="bx--form-item">
                <label for="PriceUsd" class="bx--label">@Localizer["Price (USD)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="PriceUsd" type="number" class="bx--text-input" name="PriceUsd" required min="0" step="0.01" value="@(Model?.PriceUsd ?? 0)">
                </div>
            </div>
            <div class="bx--form-item">
                <label for="PriceEgp" class="bx--label">@Localizer["Price (EGP)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="PriceEgp" type="number" class="bx--text-input" name="PriceEgp" required min="0" step="0.01" value="@(Model?.PriceEgp ?? 0)">
                </div>
            </div>
        </div>

        <h4 class="bx--type-productive-heading-03" style="margin-top: 2rem; margin-bottom: 1rem;">@Localizer["Taxes & Fees"]</h4>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; background: #ffffff; padding: 1.5rem; border: 1px solid #e0e0e0; margin-bottom: 2rem;">
            <div class="bx--form-item">
                <label for="TaxPercentageUsd" class="bx--label">@Localizer["Tax Percentage (USD) (%)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="TaxPercentageUsd" type="number" class="bx--text-input" name="TaxPercentageUsd" required min="0" max="100" step="0.01" value="@(Model?.TaxPercentageUsd ?? 0)">
                </div>
            </div>
            <div class="bx--form-item">
                <label for="TaxPercentageEgp" class="bx--label">@Localizer["Tax Percentage (EGP) (%)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="TaxPercentageEgp" type="number" class="bx--text-input" name="TaxPercentageEgp" required min="0" max="100" step="0.01" value="@(Model?.TaxPercentageEgp ?? 0)">
                </div>
            </div>
            <div class="bx--form-item">
                <label for="FixedFeeUsd" class="bx--label">@Localizer["Fixed Fee (USD)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="FixedFeeUsd" type="number" class="bx--text-input" name="FixedFeeUsd" required min="0" step="0.01" value="@(Model?.FixedFeeUsd ?? 0)">
                </div>
            </div>
            <div class="bx--form-item">
                <label for="FixedFeeEgp" class="bx--label">@Localizer["Fixed Fee (EGP)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="FixedFeeEgp" type="number" class="bx--text-input" name="FixedFeeEgp" required min="0" step="0.01" value="@(Model?.FixedFeeEgp ?? 0)">
                </div>
            </div>
        </div>

        <h4 style="margin-bottom: 1.5rem; font-weight: 400; font-size: 1.25rem;">@Localizer["Economy Limits"]</h4>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2.5rem;">
            <div class="bx--form-item">
                <label for="StandardCredits" class="bx--label">@Localizer["Standard Credits"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="StandardCredits" type="number" class="bx--text-input" name="StandardCredits" required min="0" value="@(Model?.StandardCredits ?? 0)">
                </div>
            </div>
            <div class="bx--form-item">
                <label for="PremiumCredits" class="bx--label">@Localizer["Premium Credits"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="PremiumCredits" type="number" class="bx--text-input" name="PremiumCredits" required min="0" value="@(Model?.PremiumCredits ?? 0)">
                </div>
            </div>
        </div>

        <!-- AI Tools & Feature Access Permissions -->
        <h4 style="margin-bottom: 1.5rem; font-weight: 400; font-size: 1.25rem;">@Localizer["AI Tools Access & Permissions"]</h4>
        <div style="background: #ffffff; border: 1px solid #e0e0e0; border-radius: 6px; padding: 1.75rem; box-shadow: 0 2px 6px rgba(0,0,0,0.04); margin-bottom: 2.5rem;">
            <p style="margin: 0 0 1.25rem 0; font-size: 0.9rem; color: #525252;">
                @Localizer["Select which AI features and tools subscribers of this plan have permission to access. Operational limits and pricing are managed centrally in each tool's settings."]
            </p>

            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
                <!-- 1. Text to Image -->
                <div style="background: #fbfbfb; border: 1px solid #e8e8e8; border-radius: 4px; padding: 1rem;">
                    <div class="bx--checkbox-wrapper">
                        <input type="checkbox" id="TextToImageEnabled" name="TextToImageEnabled" value="true" class="bx--checkbox" @(Model?.TextToImageEnabled != false ? "checked" : "") />
                        <label for="TextToImageEnabled" class="bx--checkbox-label">
                            <span class="bx--checkbox-label-text" style="font-weight: 700;">🖼️ @Localizer["Text to Image"]</span>
                        </label>
                        <input type="hidden" name="TextToImageEnabled" value="false" />
                    </div>
                </div>

                <!-- 2. Text to Video -->
                <div style="background: #fbfbfb; border: 1px solid #e8e8e8; border-radius: 4px; padding: 1rem;">
                    <div class="bx--checkbox-wrapper">
                        <input type="checkbox" id="TextToVideoEnabled" name="TextToVideoEnabled" value="true" class="bx--checkbox" @(Model?.TextToVideoEnabled != false ? "checked" : "") />
                        <label for="TextToVideoEnabled" class="bx--checkbox-label">
                            <span class="bx--checkbox-label-text" style="font-weight: 700;">🎬 @Localizer["Text to Video"]</span>
                        </label>
                        <input type="hidden" name="TextToVideoEnabled" value="false" />
                    </div>
                </div>

                <!-- 3. Image to Video -->
                <div style="background: #fbfbfb; border: 1px solid #e8e8e8; border-radius: 4px; padding: 1rem;">
                    <div class="bx--checkbox-wrapper">
                        <input type="checkbox" id="ImageToVideoEnabled" name="ImageToVideoEnabled" value="true" class="bx--checkbox" @(Model?.ImageToVideoEnabled != false ? "checked" : "") />
                        <label for="ImageToVideoEnabled" class="bx--checkbox-label">
                            <span class="bx--checkbox-label-text" style="font-weight: 700;">🎞️ @Localizer["Image to Video"]</span>
                        </label>
                        <input type="hidden" name="ImageToVideoEnabled" value="false" />
                    </div>
                </div>

                <!-- 4. Reference to Video -->
                <div style="background: #fbfbfb; border: 1px solid #e8e8e8; border-radius: 4px; padding: 1rem;">
                    <div class="bx--checkbox-wrapper">
                        <input type="checkbox" id="ReferenceToVideoEnabled" name="ReferenceToVideoEnabled" value="true" class="bx--checkbox" @(Model?.ReferenceToVideoEnabled != false ? "checked" : "") />
                        <label for="ReferenceToVideoEnabled" class="bx--checkbox-label">
                            <span class="bx--checkbox-label-text" style="font-weight: 700;">📽️ @Localizer["Reference to Video"]</span>
                        </label>
                        <input type="hidden" name="ReferenceToVideoEnabled" value="false" />
                    </div>
                </div>

                <!-- 5. Advanced Lip-Sync -->
                <div style="background: #fbfbfb; border: 1px solid #e8e8e8; border-radius: 4px; padding: 1rem;">
                    <div class="bx--checkbox-wrapper">
                        <input type="checkbox" id="LipSyncEnabled" name="LipSyncEnabled" value="true" class="bx--checkbox" @(Model?.LipSyncEnabled != false ? "checked" : "") />
                        <label for="LipSyncEnabled" class="bx--checkbox-label">
                            <span class="bx--checkbox-label-text" style="font-weight: 700;">👄 @Localizer["Advanced Lip-Sync"]</span>
                        </label>
                        <input type="hidden" name="LipSyncEnabled" value="false" />
                    </div>
                </div>

                <!-- 6. Motion Control -->
                <div style="background: #fbfbfb; border: 1px solid #e8e8e8; border-radius: 4px; padding: 1rem;">
                    <div class="bx--checkbox-wrapper">
                        <input type="checkbox" id="MotionControlEnabled" name="MotionControlEnabled" value="true" class="bx--checkbox" @(Model?.MotionControlEnabled != false ? "checked" : "") />
                        <label for="MotionControlEnabled" class="bx--checkbox-label">
                            <span class="bx--checkbox-label-text" style="font-weight: 700;">🕺 @Localizer["Motion Control"]</span>
                        </label>
                        <input type="hidden" name="MotionControlEnabled" value="false" />
                    </div>
                </div>

                <!-- 7. Voice to Text (STT) -->
                <div style="background: #fbfbfb; border: 1px solid #e8e8e8; border-radius: 4px; padding: 1rem;">
                    <div class="bx--checkbox-wrapper">
                        <input type="checkbox" id="SttEnabled" name="SttEnabled" value="true" class="bx--checkbox" @(Model?.SttEnabled != false ? "checked" : "") />
                        <label for="SttEnabled" class="bx--checkbox-label">
                            <span class="bx--checkbox-label-text" style="font-weight: 700;">🎙️ @Localizer["Voice to Text (VTT)"]</span>
                        </label>
                        <input type="hidden" name="SttEnabled" value="false" />
                    </div>
                </div>

                <!-- 8. Text to Voice (TTS) -->
                <div style="background: #fbfbfb; border: 1px solid #e8e8e8; border-radius: 4px; padding: 1rem;">
                    <div class="bx--checkbox-wrapper">
                        <input type="checkbox" id="TtsEnabled" name="TtsEnabled" value="true" class="bx--checkbox" @(Model?.TtsEnabled != false ? "checked" : "") />
                        <label for="TtsEnabled" class="bx--checkbox-label">
                            <span class="bx--checkbox-label-text" style="font-weight: 700;">🗣️ @Localizer["Text to Voice (TTS)"]</span>
                        </label>
                        <input type="hidden" name="TtsEnabled" value="false" />
                    </div>
                </div>
            </div>

            <!-- Allowed Voices for TTS -->
            <div class="bx--form-item">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                    <label class="bx--label" style="font-weight: 700; font-size: 0.95rem; margin-bottom: 0; color: #161616;">
                        🗣️ @Localizer["Allowed TTS Voices for this Plan (Leave empty for all voices)"]
                    </label>
                    <div class="bx--checkbox-wrapper">
                        <input type="checkbox" id="selectAllVoices" class="bx--checkbox" />
                        <label for="selectAllVoices" class="bx--checkbox-label">
                            <span class="bx--checkbox-label-text">@Localizer["Select All"]</span>
                        </label>
                    </div>
                </div>
                <div style="max-height: 220px; overflow-y: auto; border: 1px solid #e0e0e0; border-radius: 4px; padding: 1rem; background: #fff; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem;">
                    @if (ViewBag.AllVoices != null)
                    {
                        foreach (var voice in ViewBag.AllVoices as List<NexClone.Backend.Core.Catalogs.VoiceCatalogItem>)
                        {
                            <div class="bx--checkbox-wrapper">
                                <input type="checkbox" id="voice_@voice.VoiceName" name="selectedVoices" value="@voice.VoiceName" class="bx--checkbox" />
                                <label for="voice_@voice.VoiceName" class="bx--checkbox-label" title="@voice.Name">
                                    <span class="bx--checkbox-label-text">@voice.Name (@voice.VoiceName)</span>
                                </label>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
            <div class="bx--form-item bx--checkbox-wrapper">
                <input type="checkbox" id="IsDefaultRegistrationPlan" name="IsDefaultRegistrationPlan" value="true" class="bx--checkbox" />
                <label for="IsDefaultRegistrationPlan" class="bx--checkbox-label" title="Set as Default Registration Plan">
                    <span class="bx--checkbox-label-text" style="font-weight: bold;">@Localizer["Set as Default Registration Plan"]</span>
                </label>
                <input type="hidden" name="IsDefaultRegistrationPlan" value="false" />
                <div class="bx--form__helper-text">@Localizer["If checked, this plan will be automatically assigned to new users upon registration. Only one plan can be default."]</div>
            </div>
            
            <div class="bx--form-item bx--checkbox-wrapper">
                <input type="checkbox" id="IsFreeTrial" name="IsFreeTrial" value="true" class="bx--checkbox" />
                <label for="IsFreeTrial" class="bx--checkbox-label" title="Is this a Free Trial plan?">
                    <span class="bx--checkbox-label-text" style="font-weight: bold;">@Localizer["Is this a Free Trial plan?"]</span>
                </label>
                <input type="hidden" name="IsFreeTrial" value="false" />
            </div>
        </div>

        <!-- ── Affiliate Commission Settings ─────────────────────────────────── -->
        <hr style="border:0; border-top: 1px solid #393939; margin-top: 2rem; margin-bottom: 2rem;" />
        <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 1rem;">🤝 Affiliate Commission Settings</h3>
        <p style="margin-bottom: 1.5rem; color: #a8a8a8;">
            Advanced settings per currency. Leave as 0 to disable commission for this plan.
        </p>

        <h4 style="font-size: 0.875rem; font-weight: 600; margin-bottom: 1rem; margin-top: 1.5rem;">First Purchase Commission</h4>
        <div class="bx--row" style="margin-bottom: 1.5rem;">
            <div class="bx--col-lg-4 bx--col-md-4">
                <div class="bx--form-item">
                    <label for="AffiliateFirstCommissionType" class="bx--label">Commission Type</label>
                    <div class="bx--select">
                        <select id="AffiliateFirstCommissionType" class="bx--select-input" name="AffiliateFirstCommissionType">
                            <option value="Percentage" selected>Percentage (%)</option>
                            <option value="Fixed">Fixed Amount</option>
                        </select>
                        <svg class="bx--select__arrow" width="10" height="5" viewBox="0 0 10 5">
                            <path d="M0 0l5 4.998L10 0z" fill-rule="evenodd" />
                        </svg>
                    </div>
                </div>
            </div>
            <div class="bx--col-lg-4 bx--col-md-4">
                <div class="bx--form-item">
                    <label for="AffiliateFirstCommissionValueUsd" class="bx--label">Value (USD)</label>
                    <div class="bx--text-input__field-wrapper">
                        <input id="AffiliateFirstCommissionValueUsd" type="number" min="0" step="0.01" class="bx--text-input" name="AffiliateFirstCommissionValueUsd" value="@(Model?.AffiliateFirstCommissionValueUsd ?? 0)" />
                    </div>
                </div>
            </div>
            <div class="bx--col-lg-4 bx--col-md-4">
                <div class="bx--form-item">
                    <label for="AffiliateFirstCommissionValueEgp" class="bx--label">Value (EGP)</label>
                    <div class="bx--text-input__field-wrapper">
                        <input id="AffiliateFirstCommissionValueEgp" type="number" min="0" step="0.01" class="bx--text-input" name="AffiliateFirstCommissionValueEgp" value="@(Model?.AffiliateFirstCommissionValueEgp ?? 0)" />
                    </div>
                </div>
            </div>
        </div>

        <h4 style="font-size: 0.875rem; font-weight: 600; margin-bottom: 1rem; margin-top: 1.5rem;">Recurring Commission (Renewals)</h4>
        <div class="bx--row" style="margin-bottom: 1.5rem;">
            <div class="bx--col-lg-4 bx--col-md-4">
                <div class="bx--form-item">
                    <label for="AffiliateRecurringCommissionType" class="bx--label">Commission Type</label>
                    <div class="bx--select">
                        <select id="AffiliateRecurringCommissionType" class="bx--select-input" name="AffiliateRecurringCommissionType">
                            <option value="Percentage" selected>Percentage (%)</option>
                            <option value="Fixed">Fixed Amount</option>
                        </select>
                        <svg class="bx--select__arrow" width="10" height="5" viewBox="0 0 10 5">
                            <path d="M0 0l5 4.998L10 0z" fill-rule="evenodd" />
                        </svg>
                    </div>
                </div>
            </div>
            <div class="bx--col-lg-4 bx--col-md-4">
                <div class="bx--form-item">
                    <label for="AffiliateRecurringCommissionValueUsd" class="bx--label">Value (USD)</label>
                    <div class="bx--text-input__field-wrapper">
                        <input id="AffiliateRecurringCommissionValueUsd" type="number" min="0" step="0.01" class="bx--text-input" name="AffiliateRecurringCommissionValueUsd" value="@(Model?.AffiliateRecurringCommissionValueUsd ?? 0)" />
                    </div>
                </div>
            </div>
            <div class="bx--col-lg-4 bx--col-md-4">
                <div class="bx--form-item">
                    <label for="AffiliateRecurringCommissionValueEgp" class="bx--label">Value (EGP)</label>
                    <div class="bx--text-input__field-wrapper">
                        <input id="AffiliateRecurringCommissionValueEgp" type="number" min="0" step="0.01" class="bx--text-input" name="AffiliateRecurringCommissionValueEgp" value="@(Model?.AffiliateRecurringCommissionValueEgp ?? 0)" />
                    </div>
                </div>
            </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 1rem;">
            <a href="@Url.Action("Index")" class="bx--btn bx--btn--secondary">@Localizer["Cancel"]</a>
            <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Create Plan"]</button>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const selectAllCb = document.getElementById('selectAllVoices');
        const voiceCbs = document.querySelectorAll('input[name="selectedVoices"]');

        if (selectAllCb && voiceCbs.length > 0) {
            const updateSelectAll = () => {
                let allChecked = true;
                voiceCbs.forEach(cb => { if (!cb.checked) allChecked = false; });
                selectAllCb.checked = allChecked;
            };
            
            updateSelectAll();

            selectAllCb.addEventListener('change', function () {
                const isChecked = this.checked;
                voiceCbs.forEach(cb => { cb.checked = isChecked; });
            });

            voiceCbs.forEach(cb => {
                cb.addEventListener('change', updateSelectAll);
            });
        }
    });
</script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        function handleTaxInputs(percId, fixedId) {
            const percEl = document.getElementById(percId);
            const fixedEl = document.getElementById(fixedId);
            if (!percEl || !fixedEl) return;

            function updateState() {
                const percVal = parseFloat(percEl.value) || 0;
                const fixedVal = parseFloat(fixedEl.value) || 0;
                if (percVal > 0) {
                    fixedEl.value = '0';
                    fixedEl.setAttribute('readonly', true);
                } else {
                    fixedEl.removeAttribute('readonly');
                }
                
                if (fixedVal > 0) {
                    percEl.value = '0';
                    percEl.setAttribute('readonly', true);
                } else {
                    percEl.removeAttribute('readonly');
                }
            }

            percEl.addEventListener('input', updateState);
            fixedEl.addEventListener('input', updateState);
            updateState();
        }

        handleTaxInputs('TaxPercentageUsd', 'FixedFeeUsd');
        handleTaxInputs('TaxPercentageEgp', 'FixedFeeEgp');
    });
</script>

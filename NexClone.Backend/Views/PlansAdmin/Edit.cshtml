@model NexClone.Backend.Core.Entities.Plan
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

<div class="bx--grid" style="padding-left: 0; max-width: 800px; margin-left: 0;">
    <div class="bx--row" style="margin-bottom: 2rem;">
        <h2 style="margin: 0; font-weight: 400; font-size: 1.5rem;">@ViewData["Title"]</h2>
    </div>

    <form action="@Url.Action("Edit")" method="post" style="background: #ffffff; padding: 2rem; border: 1px solid #e0e0e0;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
            <div class="bx--form-item">
                <label for="Name" class="bx--label">@Localizer["Plan Name"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="Name" type="text" class="bx--text-input" name="Name" required value="@Model.Name">
                </div>
            </div>
            <div class="bx--form-item">
                <label for="NameAr" class="bx--label">@Localizer["Plan Name (Arabic)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="NameAr" type="text" class="bx--text-input" name="NameAr" required value="@Model.NameAr" dir="rtl">
                </div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
            <div class="bx--form-item">
                <label for="Description" class="bx--label">@Localizer["Description"]</label>
                <div class="bx--text-input__field-wrapper">
                    <textarea id="Description" class="bx--text-area" name="Description" rows="3">@Model.Description</textarea>
                </div>
            </div>
            <div class="bx--form-item">
                <label for="DescriptionAr" class="bx--label">@Localizer["Description (Arabic)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <textarea id="DescriptionAr" class="bx--text-area" name="DescriptionAr" rows="3" dir="rtl">@Model.DescriptionAr</textarea>
                </div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
            <div class="bx--form-item">
                <label for="DurationDays" class="bx--label">@Localizer["Duration (Days)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="DurationDays" type="number" class="bx--text-input" name="DurationDays" required min="1" value="@Model.DurationDays">
                </div>
            </div>
            <div class="bx--form-item">
                <label for="GracePeriodDays" class="bx--label">@Localizer["Grace Period (Days)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="GracePeriodDays" type="number" class="bx--text-input" name="GracePeriodDays" required min="0" value="@Model.GracePeriodDays">
                </div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
            <div class="bx--form-item">
                <label for="PriceUsd" class="bx--label">@Localizer["Price (USD)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="PriceUsd" type="number" class="bx--text-input" name="PriceUsd" required min="0" step="0.01" value="@Model.PriceUsd">
                </div>
            </div>
            <div class="bx--form-item">
                <label for="PriceEgp" class="bx--label">@Localizer["Price (EGP)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="PriceEgp" type="number" class="bx--text-input" name="PriceEgp" required min="0" step="0.01" value="@Model.PriceEgp">
                </div>
            </div>
        </div>

        <hr style="border: none; border-top: 1px solid #e0e0e0; margin-bottom: 2rem;">
        <div style="background: #e0f2fe; border-left: 4px solid #0284c7; padding: 1rem; margin-bottom: 2rem; border-radius: 4px;">
            <p style="margin: 0; color: #0c4a6e; font-size: 0.9rem;">
                <strong>Note:</strong> You can configure Wallet Allocations (which wallet gets how many credits) and Tool Overrides (which tool deducts from which wallet) by clicking the <strong>Wallets</strong> button on the main Plans list.
            </p>
        </div>
        <h4 style="margin-bottom: 1.5rem; font-weight: 400; font-size: 1.25rem;">@Localizer["Economy Limits"]</h4>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2.5rem;">
            <div class="bx--form-item">
                <label for="MonthlyCredits" class="bx--label">@Localizer["Monthly Credits"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="MonthlyCredits" type="number" class="bx--text-input" name="MonthlyCredits" required min="0" value="@Model.MonthlyCredits">
                </div>
                <div class="bx--form__helper-text">@Localizer["Credits granted per month"]</div>
            </div>
        </div>

        <h4 style="margin-bottom: 1.5rem; font-weight: 400; font-size: 1.1rem;">@Localizer["Text-to-Voice (TTS) Settings"]</h4>
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; margin-bottom: 2.5rem; background: #f4f4f4; padding: 1.5rem;">
            <div class="bx--form-item bx--checkbox-wrapper">
                <input type="checkbox" id="TtsEnabled" name="TtsEnabled" value="true" class="bx--checkbox" @(Model.TtsEnabled ? "checked" : "") />
                <label for="TtsEnabled" class="bx--checkbox-label" title="Enable TTS">
                    <span class="bx--checkbox-label-text" style="font-weight: bold;">@Localizer["Enable TTS"]</span>
                </label>
                <input type="hidden" name="TtsEnabled" value="false" />
            </div>
            <div class="bx--form-item">
                <label for="TtsMaxCharsPerRequest" class="bx--label">@Localizer["Max Chars per request"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="TtsMaxCharsPerRequest" type="number" class="bx--text-input" name="TtsMaxCharsPerRequest" required min="-1" value="@Model.TtsMaxCharsPerRequest">
                </div>
                <div class="bx--form__helper-text">@Localizer["-1 for unlimited"]</div>
            </div>
            <div class="bx--form-item">
                <label for="TtsCharactersBlock" class="bx--label">@Localizer["Characters Block Size"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="TtsCharactersBlock" type="number" class="bx--text-input" name="TtsCharactersBlock" required min="1" value="@Model.TtsCharactersBlock">
                </div>
                <div class="bx--form__helper-text">@Localizer["Cost will be calculated per this amount"]</div>
            </div>
            <div class="bx--form-item">
                <label for="TtsCostPerChar" class="bx--label">@Localizer["Cost Standard (per Block)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="TtsCostPerChar" type="number" class="bx--text-input" name="TtsCostPerChar" required min="0" step="0.0001" value="@Model.TtsCostPerChar">
                </div>
            </div>
                <!-- Removed Medium Cost -->
            <div class="bx--form-item">
                <label for="TtsCostPerCharHigh" class="bx--label">@Localizer["Cost High (per Block)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="TtsCostPerCharHigh" type="number" class="bx--text-input" name="TtsCostPerCharHigh" required min="0" step="0.0001" value="@Model.TtsCostPerCharHigh">
                </div>
            </div>
            <div class="bx--form-item bx--checkbox-wrapper">
                <input type="checkbox" id="TtsCustomInstructionsEnabled" name="TtsCustomInstructionsEnabled" value="true" class="bx--checkbox" @(Model.TtsCustomInstructionsEnabled ? "checked" : "") />
                <label for="TtsCustomInstructionsEnabled" class="bx--checkbox-label" title="Enable Custom Instructions">
                    <span class="bx--checkbox-label-text" style="font-weight: bold;">@Localizer["Enable Custom Instructions"]</span>
                </label>
                <input type="hidden" name="TtsCustomInstructionsEnabled" value="false" />
            </div>
            <div class="bx--form-item" style="grid-column: span 3;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <label class="bx--label" style="margin-bottom: 0;">@Localizer["Allowed Voices (Select multiple. Leave empty for all voices)"]</label>
                    <div class="bx--checkbox-wrapper">
                        <input type="checkbox" id="selectAllVoices" class="bx--checkbox" />
                        <label for="selectAllVoices" class="bx--checkbox-label">
                            <span class="bx--checkbox-label-text">@Localizer["Select All"]</span>
                        </label>
                    </div>
                </div>
                <div style="max-height: 200px; overflow-y: auto; border: 1px solid #e0e0e0; padding: 1rem; background: #fff; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem;">
                    @if (ViewBag.AllVoices != null)
                    {
                        foreach (var voice in ViewBag.AllVoices as List<NexClone.Backend.Core.Entities.Voice>)
                        {
                            bool isChecked = Model.AllowedVoices != null && Model.AllowedVoices.Split(',').Contains(voice.VoiceName);
                            <div class="bx--checkbox-wrapper">
                                <input type="checkbox" id="voice_@voice.VoiceName" name="selectedVoices" value="@voice.VoiceName" class="bx--checkbox" @(isChecked ? "checked" : "") />
                                <label for="voice_@voice.VoiceName" class="bx--checkbox-label" title="@voice.Name">
                                    <span class="bx--checkbox-label-text">@voice.Name (@voice.VoiceName)</span>
                                </label>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <h4 style="margin-bottom: 1.5rem; font-weight: 400; font-size: 1.1rem;">@Localizer["Voice-to-Text (STT) Settings"]</h4>
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; margin-bottom: 2.5rem; background: #f4f4f4; padding: 1.5rem;">
            <div class="bx--form-item bx--checkbox-wrapper">
                <input type="checkbox" id="SttEnabled" name="SttEnabled" value="true" class="bx--checkbox" @(Model.SttEnabled ? "checked" : "") />
                <label for="SttEnabled" class="bx--checkbox-label" title="Enable STT">
                    <span class="bx--checkbox-label-text" style="font-weight: bold;">@Localizer["Enable STT"]</span>
                </label>
                <input type="hidden" name="SttEnabled" value="false" />
            </div>
            <div class="bx--form-item">
                <label for="SttMaxFileSizeMb" class="bx--label">@Localizer["Max File Size (MB)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="SttMaxFileSizeMb" type="number" class="bx--text-input" name="SttMaxFileSizeMb" required min="-1" value="@Model.SttMaxFileSizeMb">
                </div>
                <div class="bx--form__helper-text">@Localizer["-1 for unlimited"]</div>
            </div>
            <div class="bx--form-item">
                <label for="SttCostPerMinute" class="bx--label">@Localizer["Cost Per Minute (Credits)"]</label>
                <input id="SttCostPerMinute" name="SttCostPerMinute" type="number" step="0.0001" class="bx--text-input" value="@Model.SttCostPerMinute" />
            </div>
        </div>

        <h4 style="margin-bottom: 1.5rem; font-weight: 400; font-size: 1.1rem;">@Localizer["Avatar Video & Lip-Sync Settings"]</h4>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2.5rem; background: #f4f4f4; padding: 1.5rem;">
            <!-- Avatar Video -->
            <div class="bx--form-item bx--checkbox-wrapper">
                <input type="checkbox" id="AvatarVideoEnabled" name="AvatarVideoEnabled" value="true" class="bx--checkbox" @(Model.AvatarVideoEnabled ? "checked" : "") />
                <label for="AvatarVideoEnabled" class="bx--checkbox-label" title="Enable Avatar Image-to-Video">
                    <span class="bx--checkbox-label-text" style="font-weight: bold;">@Localizer["Enable Avatar Video"]</span>
                </label>
                <input type="hidden" name="AvatarVideoEnabled" value="false" />
            </div>
            <div class="bx--form-item">
                <label for="AvatarVideoCostPerGeneration" class="bx--label">@Localizer["Cost Per Generation (Credits)"]</label>
                <input id="AvatarVideoCostPerGeneration" name="AvatarVideoCostPerGeneration" type="number" step="0.01" class="bx--text-input" value="@Model.AvatarVideoCostPerGeneration" />
            </div>
            <div class="bx--form-item">
                <label for="AvatarVideoMaxFileSizeMb" class="bx--label">@Localizer["Max Image Size (MB)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="AvatarVideoMaxFileSizeMb" type="number" class="bx--text-input" name="AvatarVideoMaxFileSizeMb" required min="-1" value="@Model.AvatarVideoMaxFileSizeMb">
                </div>
                <div class="bx--form__helper-text">@Localizer["-1 for unlimited"]</div>
            </div>
            <div class="bx--form-item">
                <label for="AvatarVideoMaxAudioFileSizeMb" class="bx--label">@Localizer["Max Audio Size (MB)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="AvatarVideoMaxAudioFileSizeMb" type="number" class="bx--text-input" name="AvatarVideoMaxAudioFileSizeMb" required min="-1" value="@Model.AvatarVideoMaxAudioFileSizeMb">
                </div>
                <div class="bx--form__helper-text">@Localizer["-1 for unlimited"]</div>
            </div>
            <div class="bx--form-item">
                <label for="AvatarVideoMaxCharsPerRequest" class="bx--label">@Localizer["Max Prompt Characters"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="AvatarVideoMaxCharsPerRequest" type="number" class="bx--text-input" name="AvatarVideoMaxCharsPerRequest" required min="-1" value="@Model.AvatarVideoMaxCharsPerRequest">
                </div>
                <div class="bx--form__helper-text">@Localizer["-1 for unlimited"]</div>
            </div>

            <!-- Lip-Sync -->
            <div class="bx--form-item bx--checkbox-wrapper">
                <input type="checkbox" id="LipSyncEnabled" name="LipSyncEnabled" value="true" class="bx--checkbox" @(Model.LipSyncEnabled ? "checked" : "") />
                <label for="LipSyncEnabled" class="bx--checkbox-label" title="Enable Advanced Lip-Sync">
                    <span class="bx--checkbox-label-text" style="font-weight: bold;">@Localizer["Enable Advanced Lip-Sync"]</span>
                </label>
                <input type="hidden" name="LipSyncEnabled" value="false" />
            </div>
            <div class="bx--form-item">
                <label for="LipSyncCostPerGeneration" class="bx--label">@Localizer["Cost Per Generation (Credits)"]</label>
                <input id="LipSyncCostPerGeneration" name="LipSyncCostPerGeneration" type="number" step="0.01" class="bx--text-input" value="@Model.LipSyncCostPerGeneration" />
            </div>
            <div class="bx--form-item">
                <label for="LipSyncMaxVideoFileSizeMb" class="bx--label">@Localizer["Max Video Size (MB)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="LipSyncMaxVideoFileSizeMb" type="number" class="bx--text-input" name="LipSyncMaxVideoFileSizeMb" required min="-1" value="@Model.LipSyncMaxVideoFileSizeMb">
                </div>
                <div class="bx--form__helper-text">@Localizer["-1 for unlimited"]</div>
            </div>
            <div class="bx--form-item">
                <label for="LipSyncMaxAudioFileSizeMb" class="bx--label">@Localizer["Max Audio Size (MB)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="LipSyncMaxAudioFileSizeMb" type="number" class="bx--text-input" name="LipSyncMaxAudioFileSizeMb" required min="-1" value="@Model.LipSyncMaxAudioFileSizeMb">
                </div>
                <div class="bx--form__helper-text">@Localizer["-1 for unlimited"]</div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 2rem;">
            <div class="bx--form-item bx--checkbox-wrapper">
                <input type="checkbox" id="IsDefaultRegistrationPlan" name="IsDefaultRegistrationPlan" value="true" class="bx--checkbox" @(Model.IsDefaultRegistrationPlan ? "checked" : "") />
                <label for="IsDefaultRegistrationPlan" class="bx--checkbox-label" title="Set as Default Registration Plan">
                    <span class="bx--checkbox-label-text" style="font-weight: bold;">@Localizer["Set as Default Registration Plan"]</span>
                </label>
                <input type="hidden" name="IsDefaultRegistrationPlan" value="false" />
                <div class="bx--form__helper-text">@Localizer["If checked, this plan will be automatically assigned to new users upon registration. Only one plan can be default."]</div>
            </div>
            
            <div class="bx--form-item bx--checkbox-wrapper">
                <input type="checkbox" id="IsFreeTrial" name="IsFreeTrial" value="true" class="bx--checkbox" @(Model.IsFreeTrial ? "checked" : "") />
                <label for="IsFreeTrial" class="bx--checkbox-label" title="Is this a Free Trial plan?">
                    <span class="bx--checkbox-label-text" style="font-weight: bold;">@Localizer["Is this a Free Trial plan?"]</span>
                </label>
                <input type="hidden" name="IsFreeTrial" value="false" />
            </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 1rem;">
            <a href="@Url.Action("Index")" class="bx--btn bx--btn--secondary">@Localizer["Cancel"]</a>
            <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Save Changes"]</button>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const selectAllCb = document.getElementById('selectAllVoices');
        const voiceCbs = document.querySelectorAll('input[name="selectedVoices"]');

        if (selectAllCb && voiceCbs.length > 0) {
            const updateSelectAll = () => {
                let allChecked = true;
                voiceCbs.forEach(cb => { if (!cb.checked) allChecked = false; });
                selectAllCb.checked = allChecked;
            };
            
            updateSelectAll();

            selectAllCb.addEventListener('change', function () {
                const isChecked = this.checked;
                voiceCbs.forEach(cb => { cb.checked = isChecked; });
            });

            voiceCbs.forEach(cb => {
                cb.addEventListener('change', updateSelectAll);
            });
        }
    });
</script>

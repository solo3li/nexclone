@model IEnumerable<NexClone.Backend.Core.Entities.Plan>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

<div class="bx--grid" style="padding-left: 0;">
    <div class="bx--row" style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center;">
        <h2 style="margin: 0; font-weight: 400; font-size: 1.5rem;">@ViewData["Title"]</h2>
        <a href="@Url.Action("Create")" class="bx--btn bx--btn--primary">
            Add New Plan
            <svg focusable="false" preserveAspectRatio="xMidYMid meet" style="will-change: transform;" xmlns="http://www.w3.org/2000/svg" class="bx--btn__icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M9 7L9 3 7 3 7 7 3 7 3 9 7 9 7 13 9 13 9 9 13 9 13 7z"></path></svg>
        </a>
    </div>

    <div class="bx--row">
        <div class="bx--col">
            <div class="bx--data-table-container">
                <table class="bx--data-table bx--data-table--zebra">
                    <thead>
                        <tr>
                            <th><span class="bx--table-header-label">@Localizer["Name"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Duration (Days)"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Grace Period"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Price (USD)"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Price (EGP)"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Credits (Std / Prem)"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Allowed Tools"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Name</strong>
                                    @if (item.IsFreeTrial)
                                    {
                                        <span style="background: #e0f2fe; color: #0369a1; padding: 2px 6px; border-radius: 4px; font-size: 0.75rem; font-weight: bold; margin-left: 0.5rem;">@Localizer["Free Trial"]</span>
                                    }
                                    @if (item.IsDefaultRegistrationPlan)
                                    {
                                        <span style="background: #dcfce7; color: #15803d; padding: 2px 6px; border-radius: 4px; font-size: 0.75rem; font-weight: bold; margin-left: 0.5rem;">@Localizer["Default"]</span>
                                    }
                                </td>
                                <td>@item.DurationDays</td>
                                <td>@item.GracePeriodDays days</td>
                                <td>$@item.PriceUsd</td>
                                <td>EGP @item.PriceEgp</td>
                                <td>
                                    <div style="font-size: 0.85rem;">
                                        <span style="color: #0f62fe; font-weight: 600;">@item.StandardCredits Std</span> / 
                                        <span style="color: #8a3ffc; font-weight: 600;">@item.PremiumCredits Prem</span>
                                    </div>
                                </td>
                                <td>
                                    <div style="display: flex; gap: 4px; flex-wrap: wrap; max-width: 250px;">
                                        @if (item.TextToImageEnabled) { <span class="bx--tag bx--tag--cool-gray" style="font-size: 0.7rem; margin: 0;">T2I</span> }
                                        @if (item.TextToVideoEnabled) { <span class="bx--tag bx--tag--blue" style="font-size: 0.7rem; margin: 0;">T2V</span> }
                                        @if (item.ImageToVideoEnabled) { <span class="bx--tag bx--tag--teal" style="font-size: 0.7rem; margin: 0;">I2V</span> }
                                        @if (item.ReferenceToVideoEnabled) { <span class="bx--tag bx--tag--cyan" style="font-size: 0.7rem; margin: 0;">R2V</span> }
                                        @if (item.LipSyncEnabled) { <span class="bx--tag bx--tag--magenta" style="font-size: 0.7rem; margin: 0;">LipSync</span> }
                                        @if (item.MotionControlEnabled) { <span class="bx--tag bx--tag--purple" style="font-size: 0.7rem; margin: 0;">Motion</span> }
                                        @if (item.SttEnabled) { <span class="bx--tag bx--tag--green" style="font-size: 0.7rem; margin: 0;">VTT</span> }
                                        @if (item.TtsEnabled) { <span class="bx--tag bx--tag--warm-gray" style="font-size: 0.7rem; margin: 0;">TTS</span> }
                                    </div>
                                </td>
                                <td>
                                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                        <a href="@Url.Action("ManageGateways", new { id = item.Id })" class="bx--btn bx--btn--sm bx--btn--primary" title="Payment Gateways">💳 Gateways</a>
                                        <a href="@Url.Action("ManageWallets", new { id = item.Id })" class="bx--btn bx--btn--sm bx--btn--tertiary" title="Manage Wallets">💳 @Localizer["Wallets"]</a>
                                        <a href="@Url.Action("Edit", new { id = item.Id })" class="bx--btn bx--btn--sm bx--btn--ghost">@Localizer["Edit"]</a>
                                        <form action="@Url.Action("Delete", new { id = item.Id })" method="post" data-confirm="Are you sure you want to delete this plan?">
                                            <button type="submit" class="bx--btn bx--btn--sm bx--btn--danger">@Localizer["Delete"]</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.Any())
                {
                    <div style="text-align: center; padding: 2rem; color: #525252; background: #ffffff; border-bottom: 1px solid #e0e0e0;">
                        @Localizer["No plans found. Create one to get started."]
                    </div>
                }
            </div>
        </div>
    </div>
</div>

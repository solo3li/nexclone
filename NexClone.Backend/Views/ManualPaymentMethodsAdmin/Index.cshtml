@model IEnumerable<NexClone.Backend.Core.Entities.ManualPaymentMethod>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

<div class="table-header">
    <a href="/ManualPaymentMethodsAdmin/Create" class="btn btn-primary" hx-boost="true">@Localizer["Add Payment Method"]</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="bx--data-table">
            <thead>
                <tr>
                    <th>@Localizer["Name"]</th>
                    <th>@Localizer["Account Details"]</th>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.AccountDetails</td>
                        <td>
                            <span class="badge @(item.IsActive ? "badge-success" : "badge-danger")">
                                @(item.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="table-actions">
                            <a href="/ManualPaymentMethodsAdmin/Edit/@item.Id" class="btn btn-secondary btn-sm" hx-boost="true">@Localizer["Edit"]</a>
                            <form action="/ManualPaymentMethodsAdmin/Delete/@item.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this payment method?');">@Localizer["Delete"]</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

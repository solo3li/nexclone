@model IEnumerable<NexClone.Backend.Core.Entities.SystemUpdate>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["System Updates"];
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <h1 class="page-title" style="margin: 0; font-weight: 600;">@Localizer["System Updates"]</h1>
    <a asp-action="Create" class="bx--btn bx--btn--primary" style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none;">
        <i class='bx bx-plus' style="font-size: 1.25rem;"></i>
        @Localizer["Add Update"]
    </a>
</div>

<div class="bx--data-table-container">
    <div class="bx--data-table-header">
        <h4 class="bx--data-table-header__title">@Localizer["Update History"]</h4>
        <p class="bx--data-table-header__description">@Localizer["A log of system modifications and updates."]</p>
    </div>
    
    <table class="bx--data-table bx--data-table--sort">
        <thead>
            <tr>
                <th><span class="bx--table-header-label">@Localizer["Title"]</span></th>
                <th><span class="bx--table-header-label">@Localizer["Description"]</span></th>
                <th><span class="bx--table-header-label">@Localizer["Date"]</span></th>
                <th><span class="bx--table-header-label">@Localizer["Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="font-weight: 600;">@item.Title</td>
                    <td>@Html.Raw(item.Description.Replace("\n", "<br/>"))</td>
                    <td>@item.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                    <td>
                        <div style="display: flex; gap: 0.5rem;">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="bx--btn bx--btn--sm bx--btn--secondary" title="@Localizer["Edit"]">
                                <i class='bx bx-edit-alt'></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('@Localizer["Are you sure you want to delete this update log?"]');" style="display:inline;">
                                <button type="submit" class="bx--btn bx--btn--sm bx--btn--danger" title="@Localizer["Delete"]">
                                    <i class='bx bx-trash'></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" style="text-align: center; padding: 2rem; color: #525252;">
                        @Localizer["No updates found."]
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@model IEnumerable<NexClone.Backend.Core.Entities.SystemUpdate>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["System Updates"];
}

<style>
    .su-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem; }
    .su-header h1 { font-size: 1.8rem; font-weight: 800; margin: 0; color: var(--admin-text-primary); display: flex; align-items: center; gap: 0.6rem; }
    .su-header h1 i { color: var(--admin-primary); }
    .su-header p { margin: 4px 0 0; color: var(--admin-text-secondary); font-size: 0.9rem; }

    .btn-add-su {
        display: inline-flex; align-items: center; gap: 0.5rem;
        background: linear-gradient(135deg, var(--admin-primary) 0%, #a855f7 100%);
        color: #fff; font-weight: 700; font-size: 0.88rem;
        padding: 0.7rem 1.4rem; border-radius: 10px; text-decoration: none; border: none; cursor: pointer;
        box-shadow: 0 4px 18px rgba(139,92,246,.35); transition: var(--trans-bounce);
    }
    .btn-add-su:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(139,92,246,.45); color: #fff; }

    .timeline-container {
        position: relative;
        max-width: 850px;
        margin: 0 auto;
        padding: 1rem 0;
    }

    .timeline-container::before {
        content: '';
        position: absolute;
        top: 0; bottom: 0; left: 24px;
        width: 3px;
        background: linear-gradient(180deg, var(--admin-primary) 0%, rgba(139,92,246,0.1) 100%);
        border-radius: 3px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 2.5rem;
        padding-left: 60px;
    }

    .timeline-item::before {
        content: '';
        position: absolute;
        left: 17px; top: 22px;
        width: 16px; height: 16px;
        border-radius: 50%;
        background: var(--admin-primary);
        border: 3px solid var(--admin-surface);
        box-shadow: 0 0 0 3px rgba(139,92,246,0.4);
        z-index: 1;
    }

    .timeline-card {
        background: var(--admin-surface);
        border: 1px solid var(--admin-border-light);
        border-radius: var(--admin-radius-lg);
        box-shadow: var(--shadow-soft);
        overflow: hidden;
        position: relative;
        transition: var(--trans-smooth);
    }

    .timeline-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-float);
    }

    .timeline-date {
        position: absolute; top: 1.25rem; right: 1.25rem;
        font-size: 0.8rem; font-weight: 700;
        color: var(--admin-primary);
        background: rgba(139,92,246,0.1);
        padding: 0.35rem 0.85rem; border-radius: 20px;
        display: flex; align-items: center; gap: 4px;
    }

    .timeline-section { padding: 1.5rem 1.75rem; }
    .timeline-section-ar { direction: rtl; text-align: right; }
    .timeline-section-en { direction: ltr; text-align: left; background: rgba(139,92,246,0.03); border-top: 1px dashed var(--admin-border-light); }

    .timeline-title {
        font-size: 1.2rem; font-weight: 800;
        color: var(--admin-text-primary);
        margin-bottom: 0.75rem; padding-right: 9rem;
    }

    .timeline-section-ar .timeline-title { padding-right: 0; padding-left: 9rem; }

    .timeline-description {
        font-size: 0.92rem; color: var(--admin-text-secondary);
        line-height: 1.65; margin: 0;
    }

    .timeline-actions {
        padding: 1rem 1.5rem;
        background: rgba(0,0,0,0.02);
        border-top: 1px solid var(--admin-border-light);
        display: flex; justify-content: flex-end; gap: 0.5rem;
    }

    .btn-su-action {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 6px 14px; border-radius: 8px; font-size: 0.8rem; font-weight: 700;
        text-decoration: none; border: none; cursor: pointer; transition: var(--trans-smooth);
    }
    .btn-su-edit { background: rgba(139,92,246,.1); color: var(--admin-primary); }
    .btn-su-edit:hover { background: var(--admin-primary); color: #fff; transform: translateY(-1px); }
    .btn-su-delete { background: rgba(239,68,68,.1); color: #ef4444; }
    .btn-su-delete:hover { background: #ef4444; color: #fff; transform: translateY(-1px); }

    .empty-su { text-align: center; padding: 4rem 2rem; color: var(--admin-text-secondary); background: var(--admin-surface); border-radius: var(--admin-radius-lg); border: 1px dashed var(--admin-border-light); }
    .empty-su i { font-size: 3.5rem; opacity: 0.3; display: block; margin-bottom: 0.75rem; }
</style>

<div class="su-header">
    <div>
        <h1><i class='bx bx-git-commit'></i> @Localizer["System Updates"]</h1>
        <p>@Localizer["Publish release notes, system changelogs, and updates to users."]</p>
    </div>
    <a asp-action="Create" class="btn-add-su">
        <i class='bx bx-plus-circle'></i> @Localizer["Add Update"]
    </a>
</div>

<div class="timeline-container">
    @if (!Model.Any())
    {
        <div class="empty-su">
            <i class='bx bx-history'></i>
            <h4>@Localizer["No updates found."]</h4>
            <p>@Localizer["Click 'Add Update' to create the first timeline entry."]</p>
        </div>
    }

    @foreach (var item in Model)
    {
        <div class="timeline-item">
            <div class="timeline-card">
                <div class="timeline-date">
                    <i class='bx bx-calendar'></i>
                    @item.CreatedAt.ToString("MMM dd, yyyy")
                </div>

                <!-- Arabic Version -->
                <div class="timeline-section timeline-section-ar">
                    <div class="timeline-title">@item.TitleAr</div>
                    <div class="timeline-description">@item.DescriptionAr</div>
                </div>

                <!-- English Version -->
                <div class="timeline-section timeline-section-en">
                    <div class="timeline-title">@item.TitleEn</div>
                    <div class="timeline-description">@item.DescriptionEn</div>
                </div>

                <!-- Actions -->
                <div class="timeline-actions">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-su-action btn-su-edit">
                        <i class='bx bx-edit'></i> @Localizer["Edit"]
                    </a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" data-confirm="@Localizer["Are you sure you want to delete this update?"]" style="margin:0;">
                        <button type="submit" class="btn-su-action btn-su-delete">
                            <i class='bx bx-trash'></i> @Localizer["Delete"]
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

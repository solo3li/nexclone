@model NexClone.Backend.Core.Entities.SystemUpdate
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Add System Update"];
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <h1 class="page-title" style="margin: 0; font-weight: 600;">@Localizer["Add System Update"]</h1>
    <a asp-action="Index" class="bx--btn bx--btn--secondary" style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none;">
        <i class='bx bx-arrow-back'></i>
        @Localizer["Back to List"]
    </a>
</div>

<div class="bx--data-table-container" style="padding: 2rem; background: #fff;">
    <form asp-action="Create" method="post">
        
        <h4 style="margin-bottom: 1rem; border-bottom: 1px solid #e0e0e0; padding-bottom: 0.5rem;">@Localizer["Arabic Content"]</h4>
        
        <div class="bx--form-item" style="margin-bottom: 1.5rem;">
            <label asp-for="TitleAr" class="bx--label">@Localizer["Title (Arabic)"]</label>
            <input asp-for="TitleAr" class="bx--text-input" placeholder="@Localizer["Enter update title in Arabic"]" required dir="rtl" />
            <span asp-validation-for="TitleAr" class="text-danger" style="color: #da1e28; font-size: 0.875rem; margin-top: 0.25rem; display: block;"></span>
        </div>

        <div class="bx--form-item" style="margin-bottom: 2rem;">
            <label asp-for="DescriptionAr" class="bx--label">@Localizer["Description (Arabic)"]</label>
            <textarea asp-for="DescriptionAr" class="bx--text-area" rows="4" placeholder="@Localizer["Describe the update details in Arabic..."]" required dir="rtl" style="width: 100%; border: 1px solid #8d8d8d; padding: 1rem; font-family: inherit; font-size: 0.875rem; background-color: #f4f4f4; resize: vertical;"></textarea>
            <span asp-validation-for="DescriptionAr" class="text-danger" style="color: #da1e28; font-size: 0.875rem; margin-top: 0.25rem; display: block;"></span>
        </div>

        <h4 style="margin-bottom: 1rem; border-bottom: 1px solid #e0e0e0; padding-bottom: 0.5rem;">@Localizer["English Content"]</h4>

        <div class="bx--form-item" style="margin-bottom: 1.5rem;">
            <label asp-for="TitleEn" class="bx--label">@Localizer["Title (English)"]</label>
            <input asp-for="TitleEn" class="bx--text-input" placeholder="@Localizer["Enter update title in English"]" required dir="ltr" />
            <span asp-validation-for="TitleEn" class="text-danger" style="color: #da1e28; font-size: 0.875rem; margin-top: 0.25rem; display: block;"></span>
        </div>

        <div class="bx--form-item" style="margin-bottom: 2rem;">
            <label asp-for="DescriptionEn" class="bx--label">@Localizer["Description (English)"]</label>
            <textarea asp-for="DescriptionEn" class="bx--text-area" rows="4" placeholder="@Localizer["Describe the update details in English..."]" required dir="ltr" style="width: 100%; border: 1px solid #8d8d8d; padding: 1rem; font-family: inherit; font-size: 0.875rem; background-color: #f4f4f4; resize: vertical;"></textarea>
            <span asp-validation-for="DescriptionEn" class="text-danger" style="color: #da1e28; font-size: 0.875rem; margin-top: 0.25rem; display: block;"></span>
        </div>

        <div style="display: flex; justify-content: flex-end;">
            <button type="submit" class="bx--btn bx--btn--primary" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                <i class='bx bx-save'></i>
                @Localizer["Save Update"]
            </button>
        </div>
    </form>
</div>

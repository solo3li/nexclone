@model Dictionary<string, NexClone.Backend.Core.Entities.ToolConfiguration>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

@{
    ViewData["Title"] = "Tool Settings Dashboard";
}

<style>
    .tool-card {
        background: #ffffff;
        border: 1px solid #e0e0e0;
        padding: 1.5rem;
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        height: 100%;
        text-decoration: none;
        color: inherit;
    }
    .tool-card:hover {
        border-color: #0f62fe;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        transform: translateY(-2px);
    }
    .tool-icon {
        width: 48px;
        height: 48px;
        background: #f4f4f4;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        color: #0f62fe;
    }
    .tool-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        text-transform: capitalize;
    }
    .tool-status {
        margin-top: auto;
        padding-top: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .status-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.875rem;
        font-weight: 500;
    }
    .status-active {
        background: #defbe6;
        color: #198038;
    }
    .status-maintenance {
        background: #fcf1cd;
        color: #f1c21b;
    }
    .status-comingsoon {
        background: #e5f6ff;
        color: #00539a;
    }
    .status-inactive {
        background: #f4f4f4;
        color: #525252;
    }
    .manage-btn {
        color: #0f62fe;
        font-weight: 500;
        display: flex;
        align-items: center;
    }
    .manage-btn svg {
        margin-left: 0.5rem;
        transition: transform 0.2s ease;
    }
    .tool-card:hover .manage-btn svg {
        transform: translateX(4px);
    }
</style>

<div class="bx--grid bx--grid--full-width">
    <div class="bx--row" style="margin-bottom: 2rem;">
        <div class="bx--col">
            <h1 class="bx--type-productive-heading-05">@Localizer["Advanced Tool Configurations"]</h1>
            <p style="margin-top: 0.5rem; color: #525252;">@Localizer["Manage individual settings, scheduling, and fallbacks for each tool independently."]</p>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div data-notification class="bx--inline-notification bx--inline-notification--error" role="alert" style="margin-bottom: 2rem;">
            <div class="bx--inline-notification__details">
                <svg focusable="false" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bx--inline-notification__icon" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M10,1c-5,0-9,4-9,9s4,9,9,9s9-4,9-9S15,1,10,1z M13.5,14.5l-8-8l1-1l8,8L13.5,14.5z"></path></svg>
                <div class="bx--inline-notification__text-wrapper">
                    <p class="bx--inline-notification__title">@Localizer["Error"]</p>
                    <p class="bx--inline-notification__subtitle">@TempData["ErrorMessage"]</p>
                </div>
            </div>
        </div>
    }

    <div class="bx--row">
        @foreach (var kvp in Model)
        {
            var toolName = kvp.Key;
            var config = kvp.Value;
            var formattedName = toolName.Replace("-", " ");
            
            // Determine Icon based on tool name
            string iconSvg = "";
            if (toolName.Contains("video") || toolName == "motion-control" || toolName == "advanced-lip-sync") {
                iconSvg = "<svg width='24' height='24' viewBox='0 0 32 32' fill='currentColor'><path d='M26,4H6C4.9,4,4,4.9,4,6v20c0,1.1,0.9,2,2,2h20c1.1,0,2-0.9,2-2V6C28,4.9,27.1,4,26,4z M26,26H6V6h20V26z'></path><polygon points='12,10 12,22 22,16'></polygon></svg>";
            } else if (toolName.Contains("image")) {
                iconSvg = "<svg width='24' height='24' viewBox='0 0 32 32' fill='currentColor'><path d='M30,8v16c0,1.1-0.9,2-2,2H4c-1.1,0-2-0.9-2-2V8c0-1.1,0.9-2,2-2h24C29.1,6,30,6.9,30,8z M28,8H4v16h24V8z'></path><circle cx='10' cy='13' r='2'></circle><polygon points='16,14 20,18 24,14 28,18 28,24 4,24 4,20 10,14'></polygon></svg>";
            } else if (toolName.Contains("voice") || toolName.Contains("text")) {
                iconSvg = "<svg width='24' height='24' viewBox='0 0 32 32' fill='currentColor'><path d='M16,2C8.3,2,2,8.3,2,16s6.3,14,14,14s14-6.3,14-14S23.7,2,16,2z M16,28C9.4,28,4,22.6,4,16S9.4,4,16,4s12,5.4,12,12S22.6,28,16,28z'></path><path d='M11.5,11.5h9v2h-9V11.5z M11.5,15.5h9v2h-9V15.5z M11.5,19.5h5v2h-5V19.5z'></path></svg>";
            }

            <div class="bx--col-sm-4 bx--col-md-4 bx--col-lg-4" style="margin-bottom: 2rem;">
                <a href="/ToolConfigAdmin/Edit/@toolName" class="tool-card">
                    <div class="tool-icon">
                        @Html.Raw(iconSvg)
                    </div>
                    <div class="tool-title">@formattedName</div>
                    
                    <div class="tool-status">
                        @if (config.IsComingSoon)
                        {
                            <span class="status-badge status-comingsoon">@Localizer["Coming Soon"]</span>
                        }
                        else if (config.IsMaintenanceMode)
                        {
                            <span class="status-badge status-maintenance">@Localizer["Maintenance"]</span>
                        }
                        else if (config.IsActive)
                        {
                            <span class="status-badge status-active">@Localizer["Active"]</span>
                        }
                        else
                        {
                            <span class="status-badge status-inactive">@Localizer["Inactive"]</span>
                        }
                        
                        <div class="manage-btn">
                            @Localizer["Manage"]
                            <svg focusable="false" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" fill="currentColor" width="16" height="16" viewBox="0 0 32 32" aria-hidden="true"><path d="M11.59 16L22 5.59 20.59 4.17 8.76 16 20.59 27.83 22 26.41 11.59 16z" transform="rotate(180 16 16)"></path></svg>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

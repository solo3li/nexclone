@model Dictionary<string, NexClone.Backend.Core.Entities.ToolConfiguration>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

@{
    ViewData["Title"] = "Tool Settings";
    var providers = ViewBag.Providers as SelectList;
}

<style>
    .tc-header { margin-bottom: 2rem; }
    .tc-header h1 { font-size: 1.8rem; font-weight: 800; margin: 0; color: var(--admin-text-primary); display: flex; align-items: center; gap: 0.6rem; }
    .tc-header h1 i { color: var(--admin-primary); }
    .tc-header p { margin: 4px 0 0; color: var(--admin-text-secondary); font-size: 0.9rem; }

    /* Custom Tabs */
    .tc-tabs-bar {
        display: flex; gap: 0.5rem; border-bottom: 2px solid var(--admin-border-light);
        margin-bottom: 2rem; overflow-x: auto; padding-bottom: 2px;
    }
    .tc-tab-btn {
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.75rem 1.25rem; border-radius: 12px 12px 0 0;
        font-weight: 700; font-size: 0.88rem; color: var(--admin-text-secondary);
        background: transparent; border: none; cursor: pointer; transition: var(--trans-smooth);
        white-space: nowrap; border-bottom: 3px solid transparent; margin-bottom: -2px;
    }
    .tc-tab-btn:hover { color: var(--admin-primary); background: rgba(139,92,246,.04); }
    .tc-tab-btn.active {
        color: var(--admin-primary); background: var(--admin-surface);
        border-bottom-color: var(--admin-primary);
        box-shadow: 0 -4px 15px rgba(139,92,246,.08);
    }

    /* Cards */
    .tc-card {
        background: var(--admin-surface);
        border: 1px solid var(--admin-border-light);
        border-radius: var(--admin-radius-lg);
        box-shadow: var(--shadow-soft);
        padding: 1.75rem; margin-bottom: 1.75rem;
    }
    .tc-card-title {
        font-size: 1.1rem; font-weight: 800; color: var(--admin-text-primary);
        margin: 0 0 1.25rem 0; display: flex; align-items: center; justify-content: space-between;
    }
    .tc-card-title i { color: var(--admin-primary); margin-right: 0.4rem; }

    /* Toggle switches */
    .tc-toggle-row { display: flex; gap: 2rem; flex-wrap: wrap; }
    .tc-toggle-item { display: flex; align-items: center; gap: 0.75rem; background: var(--admin-bg, #f8fafc); padding: 0.9rem 1.25rem; border-radius: 12px; border: 1px solid var(--admin-border-light); flex: 1; min-width: 240px; }
    .tc-toggle-item label { font-weight: 700; font-size: 0.9rem; color: var(--admin-text-primary); margin: 0; cursor: pointer; }

    /* Rule block */
    .rule-block {
        background: var(--admin-bg, #f8fafc);
        padding: 1.5rem; border: 1px solid var(--admin-border-light);
        border-left: 4px solid var(--admin-primary); border-radius: 14px;
        position: relative; transition: var(--trans-smooth);
    }
    .rule-block:hover { box-shadow: var(--shadow-soft); }

    /* Buttons */
    .btn-tc-primary {
        display: inline-flex; align-items: center; gap: 0.5rem;
        background: linear-gradient(135deg, var(--admin-primary) 0%, #a855f7 100%);
        color: #fff; font-weight: 700; font-size: 0.88rem;
        padding: 0.7rem 1.5rem; border-radius: 10px; text-decoration: none; border: none; cursor: pointer;
        box-shadow: 0 4px 15px rgba(139,92,246,.3); transition: var(--trans-bounce);
    }
    .btn-tc-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(139,92,246,.4); color: #fff; }

    .btn-tc-add {
        display: inline-flex; align-items: center; gap: 0.4rem;
        background: rgba(139,92,246,.1); color: var(--admin-primary);
        font-weight: 700; font-size: 0.82rem; padding: 0.5rem 1rem; border-radius: 8px; border: none; cursor: pointer; transition: var(--trans-smooth);
    }
    .btn-tc-add:hover { background: var(--admin-primary); color: #fff; transform: translateY(-1px); }

    .btn-tc-remove {
        position: absolute; top: 1rem; right: 1rem;
        background: rgba(239,68,68,.1); color: #ef4444;
        font-weight: 700; font-size: 0.78rem; padding: 0.4rem 0.8rem; border-radius: 6px; border: none; cursor: pointer; transition: var(--trans-smooth);
    }
    .btn-tc-remove:hover { background: #ef4444; color: #fff; }

    .tc-notif { padding: 1rem 1.5rem; border-radius: 12px; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem; font-weight: 600; font-size: 0.9rem; }
    .tc-notif-ok { background: rgba(34,197,94,.1); color: #16a34a; border: 1px solid rgba(34,197,94,.2); }
    .tc-notif-err { background: rgba(239,68,68,.1); color: #dc2626; border: 1px solid rgba(239,68,68,.2); }
</style>

<div class="tc-header">
    <h1><i class='bx bx-slider-alt'></i> @Localizer["Advanced Tool Configurations"]</h1>
    <p>@Localizer["Manage individual settings, scheduling, and fallbacks for each tool independently."]</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="tc-notif tc-notif-ok"><i class='bx bx-check-circle'></i> @TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="tc-notif tc-notif-err"><i class='bx bx-x-circle'></i> @TempData["ErrorMessage"]</div>
}

<!-- Tab Navigation -->
<div class="tc-tabs-bar">
    @{ int tabIdx = 0; }
    @foreach (var tool in Model.Keys)
    {
        <button class="tc-tab-btn @(tabIdx == 0 ? "active" : "")" data-target="#tab-panel-@tool">
            <i class='bx bx-cog'></i> @tool.ToUpper().Replace("-", " ")
        </button>
        tabIdx++;
    }
</div>

<!-- Tab Contents -->
@{ int panelIdx = 0; }
@foreach (var kvp in Model)
{
    var toolName = kvp.Key;
    var config = kvp.Value;

    <div id="tab-panel-@toolName" class="tc-tab-panel" style="display: @(panelIdx == 0 ? "block" : "none");">
        <form asp-action="SaveConfig" method="post">
            <input type="hidden" name="ToolName" value="@toolName" />

            <!-- General Settings Card -->
            <div class="tc-card">
                <div class="tc-card-title">
                    <span><i class='bx bx-toggle-left'></i> @Localizer["General Settings"]</span>
                </div>
                <div class="tc-toggle-row">
                    <div class="tc-toggle-item">
                        <input type="checkbox" id="IsActive-@toolName" name="IsActive" value="true" @(config.IsActive ? "checked" : "") style="width:18px;height:18px;cursor:pointer;">
                        <input type="hidden" name="IsActive" value="false">
                        <label for="IsActive-@toolName">@Localizer["Is Active (Enable/Disable Tool)"]</label>
                    </div>
                    <div class="tc-toggle-item">
                        <input type="checkbox" id="IsMaintenanceMode-@toolName" name="IsMaintenanceMode" value="true" @(config.IsMaintenanceMode ? "checked" : "") style="width:18px;height:18px;cursor:pointer;">
                        <input type="hidden" name="IsMaintenanceMode" value="false">
                        <label for="IsMaintenanceMode-@toolName">@Localizer["Maintenance Mode"]</label>
                    </div>
                </div>
            </div>

            <!-- Routing Rules Card -->
            <div class="tc-card">
                <div class="tc-card-title">
                    <span><i class='bx bx-git-repo-forked'></i> @Localizer["Routing Rules (Models)"]</span>
                    <button type="button" class="btn-tc-add" onclick="addRule('@toolName')">
                        <i class='bx bx-plus'></i> @Localizer["+ Add Model"]
                    </button>
                </div>

                <div id="rules-container-@toolName" style="display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 1.5rem;">
                    @{
                        var sortedRules = config.RoutingRules?.ToList() ?? new List<NexClone.Backend.Core.Entities.ToolRoutingRule>();
                    }
                    @for (int r = 0; r < sortedRules.Count; r++)
                    {
                        var rule = sortedRules[r];
                        <div class="rule-block">
                            <button type="button" class="btn-tc-remove" onclick="this.closest('.rule-block').remove(); updateRuleIndices('@toolName');">
                                <i class='bx bx-trash'></i> @Localizer["Remove"]
                            </button>

                            @if (toolName == "text-to-voice")
                            {
                                <div class="bx--form-item" style="margin-bottom: 1rem; max-width: 300px;">
                                    <label class="bx--label">@Localizer["Quality Level"]</label>
                                    <select name="RoutingRules[@r].QualityLevel" class="bx--select-input rule-quality-input" required>
                                        <option value="Standard" selected="@(rule.QualityLevel == "Standard")">Standard</option>
                                        <option value="High" selected="@(rule.QualityLevel == "High")">High</option>
                                    </select>
                                </div>
                            }
                            else
                            {
                                <input type="hidden" name="RoutingRules[@r].QualityLevel" value="Standard" class="rule-quality-input" />
                            }

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                                <div class="bx--form-item">
                                    <label class="bx--label">@Localizer["Provider Name"]</label>
                                    <select name="RoutingRules[@r].ProviderName" class="bx--select-input" required>
                                        <option value="">-- Select Provider --</option>
                                        @if (providers != null)
                                        {
                                            foreach (var p in providers)
                                            {
                                                <option value="@p.Text" selected="@(rule.ProviderName == p.Text)">@p.Text</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="bx--form-item">
                                    <label class="bx--label">@Localizer["Model Name (Optional)"]</label>
                                    <input type="text" name="RoutingRules[@r].ModelName" class="bx--text-input" value="@rule.ModelName" placeholder="e.g. tts-1 or gemini-2.0" />
                                </div>
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                                <div class="bx--form-item">
                                    <label class="bx--label">@Localizer["Max Daily Requests"]</label>
                                    <input type="number" name="RoutingRules[@r].MaxDailyRequests" class="bx--text-input" value="@rule.MaxDailyRequests" placeholder="Unlimited" min="1" />
                                </div>
                                <div class="bx--form-item">
                                    <label class="bx--label">@Localizer["Max Requests/Min"]</label>
                                    <input type="number" name="RoutingRules[@r].MaxRequestsPerMinute" class="bx--text-input" value="@rule.MaxRequestsPerMinute" placeholder="Unlimited" min="1" />
                                </div>
                                <div class="bx--form-item">
                                    <label class="bx--label">@Localizer["Active From Time"]</label>
                                    <input type="time" name="RoutingRules[@r].ActiveFromTime" class="bx--text-input" value="@(rule.ActiveFromTime.HasValue ? rule.ActiveFromTime.Value.ToString(@"hh\:mm") : "")" />
                                </div>
                                <div class="bx--form-item">
                                    <label class="bx--label">@Localizer["Active To Time"]</label>
                                    <input type="time" name="RoutingRules[@r].ActiveToTime" class="bx--text-input" value="@(rule.ActiveToTime.HasValue ? rule.ActiveToTime.Value.ToString(@"hh\:mm") : "")" />
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <button type="submit" class="btn-tc-primary">
                    <i class='bx bx-save'></i> Save @toolName.ToUpper() Settings
                </button>
            </div>
        </form>
    </div>
    panelIdx++;
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const tabBtns = document.querySelectorAll('.tc-tab-btn');
            tabBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    tabBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');

                    document.querySelectorAll('.tc-tab-panel').forEach(panel => panel.style.display = 'none');
                    const target = document.querySelector(this.getAttribute('data-target'));
                    if (target) target.style.display = 'block';
                });
            });
        });

        const providerOptions = [
            @if (providers != null)
            {
                foreach (var p in providers)
                {
                    <text>{ value: '@p.Text', text: '@p.Text' },</text>
                }
            }
        ];

        window.addRule = function(toolName) {
            const container = document.getElementById(`rules-container-${toolName}`);
            const count = container.querySelectorAll('.rule-block').length;

            let optionsHtml = '<option value="">-- Select Provider --</option>';
            providerOptions.forEach(p => {
                optionsHtml += `<option value="${p.value}">${p.text}</option>`;
            });

            const html = `
                <div class="rule-block">
                    <button type="button" class="btn-tc-remove" onclick="this.closest('.rule-block').remove(); updateRuleIndices('${toolName}');">
                        <i class='bx bx-trash'></i> @Localizer["Remove"]
                    </button>
                    ${toolName === "text-to-voice" ? `
                    <div class="bx--form-item" style="margin-bottom: 1rem; max-width: 300px;">
                        <label class="bx--label">@Localizer["Quality Level"]</label>
                        <select name="RoutingRules[${count}].QualityLevel" class="bx--select-input rule-quality-input" required>
                            <option value="Standard">Standard</option>
                            <option value="High">High</option>
                        </select>
                    </div>
                    ` : `<input type="hidden" name="RoutingRules[${count}].QualityLevel" value="Standard" class="rule-quality-input" />`}

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                        <div class="bx--form-item">
                            <label class="bx--label">@Localizer["Provider Name"]</label>
                            <select name="RoutingRules[${count}].ProviderName" class="bx--select-input" required>
                                ${optionsHtml}
                            </select>
                        </div>
                        <div class="bx--form-item">
                            <label class="bx--label">@Localizer["Model Name (Optional)"]</label>
                            <input type="text" name="RoutingRules[${count}].ModelName" class="bx--text-input" placeholder="e.g. tts-1 or gemini-2.0" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                        <div class="bx--form-item">
                            <label class="bx--label">@Localizer["Max Daily Requests"]</label>
                            <input type="number" name="RoutingRules[${count}].MaxDailyRequests" class="bx--text-input" placeholder="Unlimited" min="1" />
                        </div>
                        <div class="bx--form-item">
                            <label class="bx--label">@Localizer["Max Requests/Min"]</label>
                            <input type="number" name="RoutingRules[${count}].MaxRequestsPerMinute" class="bx--text-input" placeholder="Unlimited" min="1" />
                        </div>
                        <div class="bx--form-item">
                            <label class="bx--label">@Localizer["Active From Time"]</label>
                            <input type="time" name="RoutingRules[${count}].ActiveFromTime" class="bx--text-input" />
                        </div>
                        <div class="bx--form-item">
                            <label class="bx--label">@Localizer["Active To Time"]</label>
                            <input type="time" name="RoutingRules[${count}].ActiveToTime" class="bx--text-input" />
                        </div>
                    </div>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', html);
        };

        window.updateRuleIndices = function(toolName) {
            const container = document.getElementById(`rules-container-${toolName}`);
            const blocks = container.querySelectorAll('.rule-block');

            blocks.forEach((block, index) => {
                const qualityInput = block.querySelector('.rule-quality-input');
                if (qualityInput) qualityInput.name = `RoutingRules[${index}].QualityLevel`;

                block.querySelector('select[name^="RoutingRules"][name$=".ProviderName"]').name = `RoutingRules[${index}].ProviderName`;
                block.querySelector('input[name$=".ModelName"]').name = `RoutingRules[${index}].ModelName`;
                block.querySelector('input[name$=".MaxDailyRequests"]').name = `RoutingRules[${index}].MaxDailyRequests`;

                const rpmInput = block.querySelector('input[name$=".MaxRequestsPerMinute"]');
                if (rpmInput) rpmInput.name = `RoutingRules[${index}].MaxRequestsPerMinute`;

                block.querySelector('input[name$=".ActiveFromTime"]').name = `RoutingRules[${index}].ActiveFromTime`;
                block.querySelector('input[name$=".ActiveToTime"]').name = `RoutingRules[${index}].ActiveToTime`;
            });
        };
    </script>
}

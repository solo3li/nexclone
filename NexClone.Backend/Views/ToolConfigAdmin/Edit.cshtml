@model NexClone.Backend.Core.Entities.ToolConfiguration
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

@{
    ViewData["Title"] = $"Manage {Model.ToolName.ToUpper().Replace("-", " ")}";
    var providers = ViewBag.Providers as SelectList;
    var toolName = Model.ToolName;
    var config = Model;
}

<div class="bx--grid bx--grid--full-width">
    <div class="bx--row" style="margin-bottom: 2rem; align-items: center;">
        <div class="bx--col" style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1 class="bx--type-productive-heading-05">@ViewData["Title"]</h1>
                <p style="margin-top: 0.5rem; color: #525252;">@Localizer["Manage settings, scheduling, and fallbacks for this tool."]</p>
            </div>
            <div>
                <a href="/ToolConfigAdmin" class="bx--btn bx--btn--secondary">
                    <svg focusable="false" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" fill="currentColor" width="16" height="16" viewBox="0 0 32 32" aria-hidden="true" style="margin-right: 0.5rem;"><path d="M13 26L14.41 24.59 6.83 17 29 17 29 15 6.83 15 14.41 7.41 13 6 3 16 13 26z"></path></svg>
                    @Localizer["Back to Tools"]
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div data-notification class="bx--inline-notification bx--inline-notification--success" role="alert" style="margin-bottom: 1rem;">
            <div class="bx--inline-notification__details">
                <svg focusable="false" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bx--inline-notification__icon" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M10,1c-4.9,0-9,4.1-9,9s4.1,9,9,9s9-4.1,9-9S14.9,1,10,1z M8.7,13.5l-3.2-3.2l1-1l2.2,2.2l4.8-4.8l1,1L8.7,13.5z"></path></svg>
                <div class="bx--inline-notification__text-wrapper">
                    <p class="bx--inline-notification__title">@Localizer["Success"]</p>
                    <p class="bx--inline-notification__subtitle">@TempData["SuccessMessage"]</p>
                </div>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div data-notification class="bx--inline-notification bx--inline-notification--error" role="alert" style="margin-bottom: 1rem;">
            <div class="bx--inline-notification__details">
                <svg focusable="false" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bx--inline-notification__icon" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M10,1c-5,0-9,4-9,9s4,9,9,9s9-4,9-9S15,1,10,1z M13.5,14.5l-8-8l1-1l8,8L13.5,14.5z"></path></svg>
                <div class="bx--inline-notification__text-wrapper">
                    <p class="bx--inline-notification__title">@Localizer["Error"]</p>
                    <p class="bx--inline-notification__subtitle">@TempData["ErrorMessage"]</p>
                </div>
            </div>
        </div>
    }

    <div class="bx--row">
        <div class="bx--col-lg-12">
            <div class="bx--row" style="margin-top: 2rem;">
                <div class="bx--col-lg-12">
                    <form asp-action="SaveConfig" method="post" class="bx--form">
                        <input type="hidden" name="ToolName" value="@toolName" />
                        
                        <div style="background: #f4f4f4; padding: 2rem; border: 1px solid #e0e0e0; margin-bottom: 2rem;">
                            <h3 class="bx--type-productive-heading-03" style="margin-bottom: 1.5rem;">@Localizer["General Settings"]</h3>
                            
                            <div class="bx--form-item" style="margin-bottom: 1.5rem;">
                                <div class="bx--toggle-c">
                                    <input type="checkbox" id="IsActive-@toolName" class="bx--toggle-input" name="IsActive" value="true" @(config.IsActive ? "checked" : "")>
                                    <label for="IsActive-@toolName" class="bx--toggle-input__label" aria-label="Toggle">
                                        <span class="bx--toggle__switch">
                                            <span class="bx--toggle__text--left" aria-hidden="true">@Localizer["Off"]</span>
                                            <span class="bx--toggle__text--right" aria-hidden="true">@Localizer["On"]</span>
                                        </span>
                                        <span style="margin-left: 1rem;">@Localizer["Is Active (Enable/Disable Tool)"]</span>
                                    </label>
                                    <input type="hidden" name="IsActive" value="false">
                                </div>
                            </div>

                            <div class="bx--form-item" style="margin-bottom: 1rem;">
                                <div class="bx--toggle-c">
                                    <input type="checkbox" id="IsMaintenanceMode-@toolName" class="bx--toggle-input" name="IsMaintenanceMode" value="true" @(config.IsMaintenanceMode ? "checked" : "")>
                                    <label for="IsMaintenanceMode-@toolName" class="bx--toggle-input__label" aria-label="Toggle">
                                        <span class="bx--toggle__switch">
                                            <span class="bx--toggle__text--left" aria-hidden="true">@Localizer["Off"]</span>
                                            <span class="bx--toggle__text--right" aria-hidden="true">@Localizer["On"]</span>
                                        </span>
                                        <span style="margin-left: 1rem;">@Localizer["Maintenance Mode"]</span>
                                    </label>
                                    <input type="hidden" name="IsMaintenanceMode" value="false">
                                </div>
                            </div>

                            <div class="bx--form-item" style="margin-bottom: 2rem;">
                                <div class="bx--toggle-c">
                                    <input type="checkbox" id="IsComingSoon-@toolName" class="bx--toggle-input" name="IsComingSoon" value="true" @(config.IsComingSoon ? "checked" : "")>
                                    <label for="IsComingSoon-@toolName" class="bx--toggle-input__label" aria-label="Toggle">
                                        <span class="bx--toggle__switch">
                                            <span class="bx--toggle__text--left" aria-hidden="true">@Localizer["Off"]</span>
                                            <span class="bx--toggle__appearance">
                                                <svg class="bx--toggle__check" width="6px" height="5px" viewBox="0 0 6 5"><path d="M2.2 2.7L5 0 6 1 2.2 5 0 2.7 1 1.5z"/></svg>
                                            </span>
                                            <span class="bx--toggle__text--right" aria-hidden="true">@Localizer["On"]</span>
                                        </span>
                                        <span style="margin-left: 1rem;">@Localizer["Coming Soon"]</span>
                                    </label>
                                    <input type="hidden" name="IsComingSoon" value="false">
                                </div>
                            </div>

                            <div class="bx--form-item" style="margin-bottom: 2rem;">
                                <label class="bx--label">@Localizer["Allowed Wallets for Deduction"]</label>
                                <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.5rem;">
                                    <div class="bx--checkbox-wrapper">
                                        <input id="AllowStandard-@toolName" class="bx--checkbox" type="checkbox" value="true" name="AllowStandardCredits" @(config.AllowStandardCredits ? "checked" : "")>
                                        <label for="AllowStandard-@toolName" class="bx--checkbox-label">
                                            <span class="bx--checkbox-label-text">Standard Credits</span>
                                        </label>
                                        <input type="hidden" value="false" name="AllowStandardCredits">
                                    </div>
                                    <div class="bx--checkbox-wrapper">
                                        <input id="AllowPremium-@toolName" class="bx--checkbox" type="checkbox" value="true" name="AllowPremiumCredits" @(config.AllowPremiumCredits ? "checked" : "")>
                                        <label for="AllowPremium-@toolName" class="bx--checkbox-label">
                                            <span class="bx--checkbox-label-text">Premium Credits</span>
                                        </label>
                                        <input type="hidden" value="false" name="AllowPremiumCredits">
                                    </div>
                                </div>
                                <div class="bx--form__helper-text" style="margin-top: 0.5rem;">@Localizer["Standard Credits are prioritized for deduction. If insufficient, Premium Credits will cover the remainder if checked."]</div>
                            </div>

                            <div class="bx--form-item" style="margin-top: 1rem;">
                                <label for="MaxConcurrentOperations-@toolName" class="bx--label">@Localizer["Max Concurrent Operations"]</label>
                                @{
                                    var limits = ViewBag.ConcurrencyLimits as Dictionary<string, int>;
                                    int currentLimit = limits != null && limits.ContainsKey(toolName) ? limits[toolName] : 10;
                                }
                                <input id="MaxConcurrentOperations-@toolName" type="number" class="bx--text-input" name="MaxConcurrentOperations" value="@currentLimit" min="1" max="1000">
                                <div class="bx--form__helper-text">@Localizer["Limit the number of background jobs running at the same time for this tool."]</div>
                            </div>
                        </div>

                        @{


                            // Try to parse existing prices from config.AdditionalSettings
                            var currentPrices = new Dictionary<string, decimal>();
                            var currentPerSec = new Dictionary<string, bool>();
                            if (!string.IsNullOrEmpty(config.AdditionalSettings))
                            {
                                try {
                                    var jDoc = System.Text.Json.JsonDocument.Parse(config.AdditionalSettings);
                                    foreach (var prop in jDoc.RootElement.EnumerateObject())
                                    {
                                        var mConfig = prop.Value;
                                        if (mConfig.TryGetProperty("IsPerSecond", out var isPerSecProp) && isPerSecProp.GetBoolean())
                                        {
                                            currentPerSec[prop.Name] = true;
                                            if (mConfig.TryGetProperty("CostPerSecond", out var cps) && cps.TryGetProperty("default", out var cpsVal))
                                                currentPrices[prop.Name] = cpsVal.GetDecimal();
                                        }
                                        else
                                        {
                                            currentPerSec[prop.Name] = false;
                                            if (mConfig.TryGetProperty("FixedCost", out var fc) && fc.TryGetProperty("default", out var fcVal))
                                                currentPrices[prop.Name] = fcVal.GetDecimal();
                                        }
                                    }
                                } catch {}
                            }
}
@if (toolName == "text-to-image")
{
    var t2iSetting = ViewBag.TextToImageSetting as NexClone.Backend.Core.Entities.TextToImageSetting;
    var t2iPricing = ViewBag.TextToImageModelPricing as NexClone.Backend.Core.Entities.TextToImageModelPricing;
    var maxPrompt = t2iSetting?.MaxPromptLength ?? 5000;
    var imgCost = t2iPricing?.CostPerImage ?? 4.0m;

    <div style="background: #ffffff; padding: 1.75rem; border: 1px solid #e0e0e0; border-radius: 6px; box-shadow: 0 2px 6px rgba(0,0,0,0.04); margin-bottom: 2rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #f4f4f4; padding-bottom: 1rem; margin-bottom: 1.5rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <span style="background: #0f62fe; color: white; font-weight: bold; font-size: 0.75rem; padding: 4px 10px; border-radius: 12px; letter-spacing: 0.5px;">CRUN AI</span>
                <h3 class="bx--type-productive-heading-03" style="margin: 0; color: #161616;">Grok Imagine (Text to Image)</h3>
            </div>
            <span style="background: #e8f8f0; color: #198038; font-weight: 600; font-size: 0.8rem; padding: 4px 12px; border-radius: 4px; border: 1px solid #a7f0ba;">
                ● @Localizer["Static Active Model"]
            </span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
            <div class="bx--form-item">
                <label class="bx--label" style="font-weight: 600;">@Localizer["Cost per Generation (Credits)"]</label>
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.25rem;">
                    <input type="number" step="0.01" min="0" name="ModelCosts[grok-imagine]" class="bx--text-input" value="@imgCost" style="font-size: 1.1rem; font-weight: bold; width: 140px;" />
                    <span style="color: #525252; font-weight: 500;">Credits / Image</span>
                </div>
                <div class="bx--form__helper-text">@Localizer["The amount deducted from user wallet per generated image."]</div>
            </div>

            <div class="bx--form-item">
                <label class="bx--label" style="font-weight: 600;">@Localizer["Max Prompt Length (Characters)"]</label>
                <input type="number" step="1" min="100" max="10000" name="MaxPromptLength" class="bx--text-input" value="@maxPrompt" style="margin-top: 0.25rem; width: 140px;" />
                <div class="bx--form__helper-text">@Localizer["Maximum character limit for user text prompt (Default: 5000)."]</div>
            </div>
        </div>

        <div style="background: #f4f4f4; padding: 1rem 1.25rem; border-radius: 4px; border-left: 4px solid #0f62fe;">
            <label class="bx--label" style="font-weight: 600; margin-bottom: 0.5rem; display: block;">@Localizer["Supported Aspect Ratios (Fixed)"]</label>
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <span style="background: white; border: 1px solid #c6c6c6; padding: 4px 12px; border-radius: 4px; font-weight: bold; font-size: 0.85rem; color: #161616;">16:9</span>
                <span style="background: white; border: 1px solid #c6c6c6; padding: 4px 12px; border-radius: 4px; font-weight: bold; font-size: 0.85rem; color: #161616;">9:16</span>
                <span style="background: white; border: 1px solid #c6c6c6; padding: 4px 12px; border-radius: 4px; font-weight: bold; font-size: 0.85rem; color: #161616;">1:1</span>
                <span style="background: white; border: 1px solid #c6c6c6; padding: 4px 12px; border-radius: 4px; font-weight: bold; font-size: 0.85rem; color: #161616;">3:2</span>
                <span style="background: white; border: 1px solid #c6c6c6; padding: 4px 12px; border-radius: 4px; font-weight: bold; font-size: 0.85rem; color: #161616;">2:3</span>
            </div>
        </div>
    </div>
}
else if (toolName == "text-to-video" || toolName == "image-to-video" || toolName == "reference-to-video" || toolName == "advanced-lip-sync")
                        {
                            var models = new List<string>();
                            var isVideo = true;
                            var costLabel = "Cost ($)";

                            if (toolName == "text-to-video" || toolName == "image-to-video")
                            {
                                models.AddRange(new[] { 
                                    "veo 3.1 Fast|720p", "veo 3.1 Fast|1080p", "veo 3.1 Fast|4k",
                                    "veo 3.1 Lite|720p", "veo 3.1 Lite|1080p", "veo 3.1 Lite|4k",
                                    "veo 3.1 Quality|720p", "veo 3.1 Quality|1080p", "veo 3.1 Quality|4k",
                                    "grok-imagine|480p", "grok-imagine|720p", "grok-imagine|1080p"
                                });
                            }
                            else if (toolName == "reference-to-video")
                            {
                                models.AddRange(new[] { 
                                    "veo 3.1 Fast|720p", "veo 3.1 Fast|1080p", "veo 3.1 Fast|4k",
                                    "veo 3.1 Lite|720p", "veo 3.1 Lite|1080p", "veo 3.1 Lite|4k",
                                    "veo 3.1 Quality|720p", "veo 3.1 Quality|1080p", "veo 3.1 Quality|4k"
                                });
                            }
                            else if (toolName == "advanced-lip-sync")
                            {
                                models.AddRange(new[] { "vidu-lipsync-std" });
                            }

                            <div class="bx--form-item" style="margin-top: 2rem; margin-bottom: 2rem;">
                                <h4 class="bx--label" style="font-weight: 600; font-size: 1rem; margin-bottom: 0.5rem; color: #0f62fe;">@Localizer["Model Pricing (Automatic)"]</h4>
                                <div style="display: flex; flex-direction: column; gap: 1rem; background: #f4f4f4; padding: 1.5rem; border-radius: 4px; border-left: 4px solid #0f62fe;">
                                    @foreach (var m in models)
                                    {
                                        var mPrice = currentPrices.ContainsKey(m) ? currentPrices[m] : 0.0m;
                                        var isPerSec = currentPerSec.ContainsKey(m) ? currentPerSec[m] : isVideo;
                                        <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #e0e0e0; padding-bottom: 0.5rem;">
                                            <label class="bx--label" style="margin: 0; font-weight: bold; width: 250px; font-size: 0.9rem;">@m</label>
                                            <div style="display: flex; align-items: center; gap: 1rem;">
                                                <input type="number" step="0.0001" min="0" name="ModelCosts[@m]" class="bx--text-input" style="width: 120px;" value="@mPrice" />
                                                <span class="bx--label" style="margin: 0; color: #525252; width: 80px;">@costLabel</span>
                                                
                                                @if (toolName == "advanced-lip-sync")
                                                {
                                                    <div class="bx--checkbox-wrapper">
                                                        <input id="ModelIsPerSecond_@m" class="bx--checkbox" type="checkbox" value="true" name="ModelIsPerSecond[@m]" @(isPerSec ? "checked" : "")>
                                                        <label for="ModelIsPerSecond_@m" class="bx--checkbox-label" title="Charge per second (rounded up to 5s) instead of flat request cost">
                                                             <span class="bx--checkbox-label-text">Per Second (Round up to 5s)</span>
                                                        </label>
                                                        <input type="hidden" value="false" name="ModelIsPerSecond[@m]">
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        
                        @if (toolName != "text-to-video" && toolName != "image-to-video" && toolName != "reference-to-video" && toolName != "text-to-image" && toolName != "advanced-lip-sync")
                        {
                            <div class="bx--form-item" style="margin-top: 2rem; margin-bottom: 2rem;">
                                <h4 class="bx--label" style="font-weight: 600; font-size: 1rem; margin-bottom: 0.5rem; color: #0f62fe;">@Localizer["Model Pricing (Flat Rate)"]</h4>
                                <div style="background: #f4f4f4; padding: 1.5rem; border-radius: 4px; border-left: 4px solid #0f62fe;">
                                    @if (toolName == "text-to-voice")
                                    {
                                        <div style="display: flex; gap: 2rem;">
                                            <div>
                                                <label class="bx--label">Cost Per Char (Standard)</label>
                                                <input type="number" step="0.0001" min="0" name="ModelCosts[default]" class="bx--text-input" style="width: 150px;" value="@(currentPrices.ContainsKey("default") ? currentPrices["default"] : 0.001m)" />
                                            </div>
                                            <div>
                                                <label class="bx--label">Cost Per Char (High/Premium)</label>
                                                <input type="number" step="0.0001" min="0" name="ModelCosts[High]" class="bx--text-input" style="width: 150px;" value="@(currentPrices.ContainsKey("High") ? currentPrices["High"] : 0.01m)" />
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <label class="bx--label">Cost Per Unit (Credits)</label>
                                        <input type="number" step="0.0001" min="0" name="ModelCosts[default]" class="bx--text-input" style="width: 150px;" value="@(currentPrices.ContainsKey("default") ? currentPrices["default"] : 1.0m)" />
                                    }
                                </div>
                            </div>
                        }

@if (toolName != "text-to-image")
                        {
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                                <h3 class="bx--type-productive-heading-03">@Localizer["Routing Rules (Models)"]</h3>
                                <button type="button" class="bx--btn bx--btn--sm bx--btn--secondary" onclick="addRule('@toolName')">
                                    @Localizer["+ Add Model"]
                                </button>
                            </div>
                        
                        <div id="rules-container-@toolName" style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
                            @{
                                var sortedRules = config.RoutingRules?.ToList() ?? new List<NexClone.Backend.Core.Entities.ToolRoutingRule>();
                            }
                            @for (int r = 0; r < sortedRules.Count; r++)
                            {
                                var rule = sortedRules[r];
                                <div class="rule-block" style="background: #ffffff; padding: 1.5rem; border: 1px solid #e0e0e0; border-left: 4px solid #0f62fe; position: relative;">
                                    <button type="button" class="bx--btn bx--btn--sm bx--btn--danger" style="position: absolute; top: 1rem; right: 1rem;" onclick="this.closest('.rule-block').remove(); updateRuleIndices('@toolName');">
                                        @Localizer["Remove"]
                                    </button>
                                    
                                    @if (toolName == "text-to-voice")
                                    {
                                        <div class="bx--form-item" style="margin-bottom: 1rem;">
                                            <label class="bx--label">@Localizer["Quality Level"]</label>
                                            <select name="RoutingRules[@r].QualityLevel" class="bx--select-input rule-quality-input" required>
                                                <option value="Standard" selected="@(rule.QualityLevel == "Standard")">Standard</option>
                                                <option value="High" selected="@(rule.QualityLevel == "High")">High</option>
                                            </select>
                                        </div>
                                    }
                                    else
                                    {
                                        <input type="hidden" name="RoutingRules[@r].QualityLevel" value="Standard" class="rule-quality-input" />
                                    }
                                    
                                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                                        <div class="bx--form-item">
                                            <label class="bx--label">@Localizer["Provider Name"]</label>
                                            <select name="RoutingRules[@r].ProviderName" class="bx--select-input" required>
                                                <option value="">-- Select Provider --</option>
                                                @if (providers != null)
                                                {
                                                    foreach (var p in providers)
                                                    {
                                                        <option value="@p.Text" selected="@(rule.ProviderName == p.Text)">@p.Text</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                        <div class="bx--form-item">
                                            <label class="bx--label">@Localizer["Model Name (Optional)"]</label>
                                            <input type="text" name="RoutingRules[@r].ModelName" class="bx--text-input" value="@rule.ModelName" placeholder="e.g. tts-1 or gemini-2.0" />
                                            <label class="bx--label">@Localizer["Active From Time"]</label>
                                            <input type="time" name="RoutingRules[@r].ActiveFromTime" class="bx--text-input" value="@(rule.ActiveFromTime.HasValue ? rule.ActiveFromTime.Value.ToString(@"hh\:mm") : "")" />
                                        </div>
                                        <div class="bx--form-item">
                                            <label class="bx--label">@Localizer["Active To Time"]</label>
                                            <input type="time" name="RoutingRules[@r].ActiveToTime" class="bx--text-input" value="@(rule.ActiveToTime.HasValue ? rule.ActiveToTime.Value.ToString(@"hh\:mm") : "")" />
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        }

                        <button type="submit" class="bx--btn bx--btn--primary">Save @toolName.ToUpper() Settings</button>
                    </form>
                </div>
            </div>
</div>

@section Scripts {
    <script>

        // Provider options rendered as a JS array
        const providerOptions = [
            @if (providers != null)
            {
                foreach (var p in providers)
                {
                    <text>
                    { value: '@p.Text', text: '@p.Text' },
                    </text>
                }
            }
        ];

        window.addRule = function(toolName) {
            const container = document.getElementById(`rules-container-${toolName}`);
            const count = container.querySelectorAll('.rule-block').length;
            
            let optionsHtml = '<option value="">-- Select Provider --</option>';
            providerOptions.forEach(p => {
                optionsHtml += `<option value="${p.value}">${p.text}</option>`;
            });

            const html = `
                <div class="rule-block" style="background: #ffffff; padding: 1.5rem; border: 1px solid #e0e0e0; border-left: 4px solid #0f62fe; position: relative;">
                    <button type="button" class="bx--btn bx--btn--sm bx--btn--danger" style="position: absolute; top: 1rem; right: 1rem;" onclick="this.closest('.rule-block').remove(); updateRuleIndices('${toolName}');">
                        @Localizer["Remove"]
                    </button>
                    
                    ${toolName === "text-to-voice" ? `
                    <div class="bx--form-item" style="margin-bottom: 1rem;">
                        <label class="bx--label">@Localizer["Quality Level"]</label>
                        <select name="RoutingRules[${count}].QualityLevel" class="bx--select-input rule-quality-input" required>
                            <option value="Standard">Standard</option>
                            <option value="High">High</option>
                        </select>
                    </div>
                    ` : `<input type="hidden" name="RoutingRules[${count}].QualityLevel" value="Standard" class="rule-quality-input" />`}
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                        <div class="bx--form-item">
                            <label class="bx--label">@Localizer["Provider Name"]</label>
                            <select name="RoutingRules[${count}].ProviderName" class="bx--select-input" required>
                                ${optionsHtml}
                            </select>
                        </div>
                        <div class="bx--form-item">
                            <label class="bx--label">@Localizer["Model Name (Optional)"]</label>
                            <input type="text" name="RoutingRules[${count}].ModelName" class="bx--text-input" placeholder="e.g. tts-1 or gemini-2.0" />
                        </div>
                    </div>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                        <div class="bx--form-item">
                            <label class="bx--label">@Localizer["Max Daily Requests"]</label>
                            <input type="number" name="RoutingRules[${count}].MaxDailyRequests" class="bx--text-input" placeholder="Unlimited" min="1" />
                        </div>
                        <div class="bx--form-item">
                            <label class="bx--label">@Localizer["Max Requests/Min"]</label>
                            <input type="number" name="RoutingRules[${count}].MaxRequestsPerMinute" class="bx--text-input" placeholder="Unlimited" min="1" />
                        </div>
                        <div class="bx--form-item">
                            <label class="bx--label">@Localizer["Active From Time"]</label>
                            <input type="time" name="RoutingRules[${count}].ActiveFromTime" class="bx--text-input" />
                        </div>
                        <div class="bx--form-item">
                            <label class="bx--label">@Localizer["Active To Time"]</label>
                            <input type="time" name="RoutingRules[${count}].ActiveToTime" class="bx--text-input" />
                        </div>
                    </div>
                </div>
            `;
            
            container.insertAdjacentHTML('beforeend', html);
        };

        window.updateRuleIndices = function(toolName) {
            const container = document.getElementById(`rules-container-${toolName}`);
            const blocks = container.querySelectorAll('.rule-block');
            
            blocks.forEach((block, index) => {
                const qualityInput = block.querySelector('.rule-quality-input');
                if (qualityInput) qualityInput.name = `RoutingRules[${index}].QualityLevel`;
                
                block.querySelector('select[name^="RoutingRules"][name$=".ProviderName"]').name = `RoutingRules[${index}].ProviderName`;
                block.querySelector('input[name$=".ModelName"]').name = `RoutingRules[${index}].ModelName`;
                block.querySelector('input[name$=".MaxDailyRequests"]').name = `RoutingRules[${index}].MaxDailyRequests`;
                
                const rpmInput = block.querySelector('input[name$=".MaxRequestsPerMinute"]');
                if (rpmInput) rpmInput.name = `RoutingRules[${index}].MaxRequestsPerMinute`;
                
                block.querySelector('input[name$=".ActiveFromTime"]').name = `RoutingRules[${index}].ActiveFromTime`;
                block.querySelector('input[name$=".ActiveToTime"]').name = `RoutingRules[${index}].ActiveToTime`;
            });
        };
    </script>
}

@model IEnumerable<NexClone.Backend.Core.Entities.AppSetting>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

<div class="bx--grid" style="padding-left: 0; max-width: 800px; margin-left: 0;">
    <div class="bx--row" style="margin-bottom: 2rem;">
        <h2 style="margin: 0; font-weight: 400; font-size: 1.5rem;">@ViewData["Title"]</h2>
        <p style="color: #525252; margin-top: 0.5rem;">@Localizer["Manage site configurations, maintenance modes, and storage independently."]</p>
    </div>

    <!-- SITE SETTINGS FORM -->
    <form action="@Url.Action("SaveSettings", "SettingsAdmin")" method="post" style="background: #ffffff; padding: 2rem; border: 1px solid #e0e0e0; margin-bottom: 2rem; border-top: 4px solid #0f62fe;">
        @Html.AntiForgeryToken()

        <h3 style="margin-bottom: 1rem; border-bottom: 1px solid #e0e0e0; padding-bottom: 0.5rem;">@Localizer["Site Settings"]</h3>
        
        <div class="bx--form-item bx--checkbox-wrapper" style="margin-bottom: 1.5rem;">
            @{
                var maintenanceModeStr = Model.FirstOrDefault(s => s.Key == "Site.MaintenanceMode")?.Value ?? "false";
                bool isMaintenanceMode = bool.TryParse(maintenanceModeStr, out var m) && m;
            }
            <input type="hidden" name="settings[Site.MaintenanceMode]" value="false" id="hidden_Site_MaintenanceMode" />
            <input id="Site_MaintenanceMode" class="bx--checkbox" type="checkbox" value="true" name="settings[Site.MaintenanceMode]" @(isMaintenanceMode ? "checked" : "") onchange="document.getElementById('hidden_Site_MaintenanceMode').disabled = this.checked;">
            <label for="Site_MaintenanceMode" class="bx--checkbox-label" title="Enable Global Maintenance Mode">
                <span class="bx--checkbox-label-text">@Localizer["Enable Global Maintenance Mode (Will show maintenance screen to all users)"]</span>
            </label>
            <script>document.getElementById('hidden_Site_MaintenanceMode').disabled = document.getElementById('Site_MaintenanceMode').checked;</script>
        </div>

        <div class="bx--form-item" style="margin-bottom: 1rem;">
            <label for="Site_MaintenanceEndDate" class="bx--label">@Localizer["Maintenance End Date (Optional)"]</label>
            <input id="Site_MaintenanceEndDate" type="datetime-local" class="bx--text-input" name="settings[Site.MaintenanceEndDate]" value="@Model.FirstOrDefault(s => s.Key == "Site.MaintenanceEndDate")?.Value" placeholder="YYYY-MM-DDTHH:MM">
            <div class="bx--form__helper-text">@Localizer["Leave blank for indefinite maintenance."]</div>
        </div>

        <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
            <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Save Site Settings"]</button>
        </div>
    </form>

    <!-- TOOLS MAINTENANCE FORM -->
    <form action="@Url.Action("SaveToolsMaintenance", "SettingsAdmin")" method="post" style="background: #ffffff; padding: 2rem; border: 1px solid #e0e0e0; margin-bottom: 2rem; border-top: 4px solid #da1e28;">
        @Html.AntiForgeryToken()

        <h3 style="margin-bottom: 1rem; border-bottom: 1px solid #e0e0e0; padding-bottom: 0.5rem;">@Localizer["Tools Maintenance"]</h3>
        <p style="color: #525252; margin-bottom: 1rem; font-size: 0.875rem;">@Localizer["Enable maintenance mode for specific tools. This will show a maintenance screen to users attempting to access them."]</p>

        @if (ViewBag.ToolConfigurations != null)
        {
            var tools = (IEnumerable<NexClone.Backend.Core.Entities.ToolConfiguration>)ViewBag.ToolConfigurations;
            foreach (var tool in tools)
            {
                <div style="display: flex; align-items: center; gap: 2rem; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid #f4f4f4;">
                    <div style="min-width: 200px; font-weight: 500;">@tool.ToolName</div>
                    
                    <div class="bx--form-item bx--checkbox-wrapper" style="margin: 0;">
                        <input id="toolMaintenance_@(tool.Id)" class="bx--checkbox" type="checkbox" name="toolMaintenance_@(tool.Id)" value="true" @(tool.IsMaintenanceMode ? "checked" : "")>
                        <label for="toolMaintenance_@(tool.Id)" class="bx--checkbox-label" title="Maintenance Mode">
                            <span class="bx--checkbox-label-text" style="color: #da1e28;">Maintenance</span>
                        </label>
                    </div>

                    <div class="bx--form-item bx--checkbox-wrapper" style="margin: 0;">
                        <input id="toolComingSoon_@(tool.Id)" class="bx--checkbox" type="checkbox" name="toolComingSoon_@(tool.Id)" value="true" @(tool.IsComingSoon ? "checked" : "")>
                        <label for="toolComingSoon_@(tool.Id)" class="bx--checkbox-label" title="Coming Soon Mode">
                            <span class="bx--checkbox-label-text" style="color: #0f62fe;">Coming Soon</span>
                        </label>
                    </div>
                </div>
            }
        }

        <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
            <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Save Tools Maintenance"]</button>
        </div>
    </form>

    <!-- PAYMENT METHODS MAINTENANCE FORM -->
    <form action="@Url.Action("SaveSettings", "SettingsAdmin")" method="post" style="background: #ffffff; padding: 2rem; border: 1px solid #e0e0e0; margin-bottom: 2rem; border-top: 4px solid #f1c21b;">
        @Html.AntiForgeryToken()

        <h3 style="margin-bottom: 1rem; border-bottom: 1px solid #e0e0e0; padding-bottom: 0.5rem;">@Localizer["Payment Methods Maintenance"]</h3>
        <p style="color: #525252; margin-bottom: 1rem; font-size: 0.875rem;">@Localizer["Disable specific payment methods during maintenance. Users will see \"Under Maintenance\" in the checkout page."]</p>

        @{
            var paymentMethods = new[] { 
                new { Id = "Paymob", Name = "Paymob" },
                new { Id = "PayPal", Name = "PayPal" },
                new { Id = "Manual", Name = "Manual Transfer" }
            };
        }

        @foreach (var pm in paymentMethods)
        {
            bool isSuspended = (Model.FirstOrDefault(s => s.Key == $"Payment.{pm.Id}.Suspended")?.Value == "true");
            bool isMaintenance = (Model.FirstOrDefault(s => s.Key == $"Payment.{pm.Id}.Maintenance")?.Value == "true");
            bool isComingSoon = (Model.FirstOrDefault(s => s.Key == $"Payment.{pm.Id}.ComingSoon")?.Value == "true");

            <div style="display: flex; align-items: center; gap: 2rem; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid #f4f4f4;">
                <div style="min-width: 150px; font-weight: 500;">@Localizer[pm.Name]</div>
                
                <div class="bx--form-item bx--checkbox-wrapper" style="margin: 0;">
                    <input type="hidden" name="settings[Payment.@(pm.Id).Suspended]" value="false" id="hidden_Payment_@(pm.Id)_Suspended" />
                    <input id="Payment_@(pm.Id)_Suspended" class="bx--checkbox" type="checkbox" name="settings[Payment.@(pm.Id).Suspended]" value="true" @(isSuspended ? "checked" : "") onchange="document.getElementById('hidden_Payment_@(pm.Id)_Suspended').disabled = this.checked;">
                    <label for="Payment_@(pm.Id)_Suspended" class="bx--checkbox-label" title="Suspended">
                        <span class="bx--checkbox-label-text" style="color: #8a3ffc;">Suspended</span>
                    </label>
                    <script>document.getElementById('hidden_Payment_@(pm.Id)_Suspended').disabled = document.getElementById('Payment_@(pm.Id)_Suspended').checked;</script>
                </div>

                <div class="bx--form-item bx--checkbox-wrapper" style="margin: 0;">
                    <input type="hidden" name="settings[Payment.@(pm.Id).Maintenance]" value="false" id="hidden_Payment_@(pm.Id)_Maintenance" />
                    <input id="Payment_@(pm.Id)_Maintenance" class="bx--checkbox" type="checkbox" name="settings[Payment.@(pm.Id).Maintenance]" value="true" @(isMaintenance ? "checked" : "") onchange="document.getElementById('hidden_Payment_@(pm.Id)_Maintenance').disabled = this.checked;">
                    <label for="Payment_@(pm.Id)_Maintenance" class="bx--checkbox-label" title="Maintenance Mode">
                        <span class="bx--checkbox-label-text" style="color: #da1e28;">Maintenance</span>
                    </label>
                    <script>document.getElementById('hidden_Payment_@(pm.Id)_Maintenance').disabled = document.getElementById('Payment_@(pm.Id)_Maintenance').checked;</script>
                </div>

                <div class="bx--form-item bx--checkbox-wrapper" style="margin: 0;">
                    <input type="hidden" name="settings[Payment.@(pm.Id).ComingSoon]" value="false" id="hidden_Payment_@(pm.Id)_ComingSoon" />
                    <input id="Payment_@(pm.Id)_ComingSoon" class="bx--checkbox" type="checkbox" name="settings[Payment.@(pm.Id).ComingSoon]" value="true" @(isComingSoon ? "checked" : "") onchange="document.getElementById('hidden_Payment_@(pm.Id)_ComingSoon').disabled = this.checked;">
                    <label for="Payment_@(pm.Id)_ComingSoon" class="bx--checkbox-label" title="Coming Soon Mode">
                        <span class="bx--checkbox-label-text" style="color: #0f62fe;">Coming Soon</span>
                    </label>
                    <script>document.getElementById('hidden_Payment_@(pm.Id)_ComingSoon').disabled = document.getElementById('Payment_@(pm.Id)_ComingSoon').checked;</script>
                </div>
            </div>
        }

        <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
            <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Save Payment Settings"]</button>
        </div>
    </form>

    <!-- CORS SETTINGS FORM -->
    <form action="@Url.Action("SaveSettings", "SettingsAdmin")" method="post" style="background: #ffffff; padding: 2rem; border: 1px solid #e0e0e0; margin-bottom: 2rem; border-top: 4px solid #24a148;">
        @Html.AntiForgeryToken()

        <h3 style="margin-bottom: 1rem; border-bottom: 1px solid #e0e0e0; padding-bottom: 0.5rem;">@Localizer["Origin (CORS) Settings"]</h3>
        
        <div class="bx--form-item" style="margin-bottom: 1rem;">
            <label for="Origin_AllowedOrigins" class="bx--label">@Localizer["Allowed Origins"]</label>
            <input id="Origin_AllowedOrigins" type="text" class="bx--text-input" name="settings[Origin.AllowedOrigins]" value="@Model.FirstOrDefault(s => s.Key == "Origin.AllowedOrigins")?.Value" placeholder="http://localhost:3000,https://nexclone.com">
            <div class="bx--form__helper-text">@Localizer["Comma-separated list of allowed origins. Use * to allow all (not recommended)."]</div>
        </div>

        <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
            <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Save Origin Settings"]</button>
        </div>
    </form>


    <!-- RABBITMQ QUEUE SETTINGS FORM -->
    <form action="@Url.Action("SaveSettings", "SettingsAdmin")" method="post" style="background: #ffffff; padding: 2rem; border: 1px solid #e0e0e0; margin-bottom: 2rem; border-top: 4px solid #8a3ffc;">
        @Html.AntiForgeryToken()

        <h3 style="margin-bottom: 1rem; border-bottom: 1px solid #e0e0e0; padding-bottom: 0.5rem;">@Localizer["Background Queues (RabbitMQ) Settings"]</h3>
        <p style="color: #525252; margin-bottom: 1rem; font-size: 0.875rem;">@Localizer["Control whether AI operations are sent to RabbitMQ background queues."]</p>

        @{
            var rabbitMqEnabledStr = Model.FirstOrDefault(s => s.Key == "Site.RabbitMqEnabled")?.Value ?? "true";
            bool isRabbitMqEnabled = bool.TryParse(rabbitMqEnabledStr, out var rmq) ? rmq : true;
        }

        <div class="bx--form-item bx--checkbox-wrapper" style="margin-bottom: 1rem;">
            <input type="hidden" name="settings[Site.RabbitMqEnabled]" value="false" id="hidden_Site_RabbitMqEnabled" />
            <input id="Site_RabbitMqEnabled" class="bx--checkbox" type="checkbox" name="settings[Site.RabbitMqEnabled]" value="true" @(isRabbitMqEnabled ? "checked" : "") onchange="document.getElementById('hidden_Site_RabbitMqEnabled').disabled = this.checked;">
            <label for="Site_RabbitMqEnabled" class="bx--checkbox-label">
                <span class="bx--checkbox-label-text">@Localizer["Enable RabbitMQ Queues (If disabled, requests will be rejected with an error instead of queuing)"]</span>
            </label>
            <script>document.getElementById('hidden_Site_RabbitMqEnabled').disabled = document.getElementById('Site_RabbitMqEnabled').checked;</script>
        </div>

        <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
            <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Save Queue Settings"]</button>
        </div>
    </form>

    <!-- CONCURRENCY LIMITS SETTINGS FORM -->
    <form action="@Url.Action("SaveSettings", "SettingsAdmin")" method="post" style="background: #ffffff; padding: 2rem; border: 1px solid #e0e0e0; margin-bottom: 2rem; border-top: 4px solid #ff832b;">
        @Html.AntiForgeryToken()

        <h3 style="margin-bottom: 1rem; border-bottom: 1px solid #e0e0e0; padding-bottom: 0.5rem;">@Localizer["Concurrent Requests Limits (Queues)"]</h3>
        <p style="color: #525252; margin-bottom: 1rem; font-size: 0.875rem;">@Localizer["Configure how many requests can be processed at the same time for each tool. Requires queue to be enabled."]</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1rem;">
            <div class="bx--form-item">
                <label for="Concurrency_tts" class="bx--label">@Localizer["Text-to-Voice (TTS)"]</label>
                <input id="Concurrency_tts" type="number" class="bx--text-input" name="settings[Concurrency_tts]" value="@(Model.FirstOrDefault(s => s.Key == "Concurrency_tts")?.Value ?? "10")" placeholder="10" min="1">
            </div>

            <div class="bx--form-item">
                <label for="Concurrency_vtt" class="bx--label">@Localizer["Voice-to-Text (STT)"]</label>
                <input id="Concurrency_vtt" type="number" class="bx--text-input" name="settings[Concurrency_vtt]" value="@(Model.FirstOrDefault(s => s.Key == "Concurrency_vtt")?.Value ?? "10")" placeholder="10" min="1">
            </div>

            <div class="bx--form-item">
                <label for="Concurrency_avatar2video" class="bx--label">@Localizer["Avatar Image-to-Video"]</label>
                <input id="Concurrency_avatar2video" type="number" class="bx--text-input" name="settings[Concurrency_avatar2video]" value="@(Model.FirstOrDefault(s => s.Key == "Concurrency_avatar2video")?.Value ?? "10")" placeholder="10" min="1">
            </div>

            <div class="bx--form-item">
                <label for="Concurrency_lipsync" class="bx--label">@Localizer["Advanced Lip-Sync"]</label>
                <input id="Concurrency_lipsync" type="number" class="bx--text-input" name="settings[Concurrency_lipsync]" value="@(Model.FirstOrDefault(s => s.Key == "Concurrency_lipsync")?.Value ?? "10")" placeholder="10" min="1">
            </div>

            <div class="bx--form-item" style="margin-bottom: 1rem; flex: 1; min-width: 250px;">
                <label for="Concurrency_motion_control" class="bx--label">@Localizer["Motion Transfer"]</label>
                <input id="Concurrency_motion_control" type="number" class="bx--text-input" name="settings[Concurrency_motion_control]" value="@(Model.FirstOrDefault(s => s.Key == "Concurrency_motion_control")?.Value ?? "10")" placeholder="10" min="1">
            </div>

            <div class="bx--form-item">
                <label for="Concurrency_email" class="bx--label">@Localizer["System Emails"]</label>
                <input id="Concurrency_email" type="number" class="bx--text-input" name="settings[Concurrency_email]" value="@(Model.FirstOrDefault(s => s.Key == "Concurrency_email")?.Value ?? "10")" placeholder="10" min="1">
            </div>
        </div>

        <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
            <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Save Concurrency Limits"]</button>
        </div>
    </form>

    <!-- GOOGLE OAUTH SETTINGS FORM -->
    <form action="@Url.Action("SaveSettings", "SettingsAdmin")" method="post" style="background: #ffffff; padding: 2rem; border: 1px solid #e0e0e0; margin-bottom: 2rem; border-top: 4px solid #ea4335;">
        @Html.AntiForgeryToken()

        <h3 style="margin-bottom: 1rem; border-bottom: 1px solid #e0e0e0; padding-bottom: 0.5rem;">@Localizer["Google OAuth Settings"]</h3>
        <p style="color: #525252; margin-bottom: 1rem; font-size: 0.875rem;">@Localizer["Configure Google Login for your users."]</p>
        
        <div class="bx--form-item" style="margin-bottom: 1rem;">
            <label for="OAuth_GoogleClientId" class="bx--label">@Localizer["Google Client ID"]</label>
            <input id="OAuth_GoogleClientId" type="text" class="bx--text-input" name="settings[OAuth.GoogleClientId]" value="@Model.FirstOrDefault(s => s.Key == "OAuth.GoogleClientId")?.Value" placeholder="xxxx-xxxx.apps.googleusercontent.com">
            <div class="bx--form__helper-text">Found in Google Cloud Console > APIs & Services > Credentials</div>
        </div>

        <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
            <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Save Google OAuth Settings"]</button>
        </div>
    </form>

    <!-- FREE PLAN SETTINGS FORM -->
    <form action="@Url.Action("SaveSettings", "SettingsAdmin")" method="post" style="background: #ffffff; padding: 2rem; border: 1px solid #e0e0e0; margin-bottom: 2rem; border-top: 4px solid #0043ce;">
        @Html.AntiForgeryToken()

        <h3 style="margin-bottom: 1rem; border-bottom: 1px solid #e0e0e0; padding-bottom: 0.5rem;">@Localizer["Free Plan Limits (Device Fingerprint)"]</h3>
        <p style="color: #525252; margin-bottom: 1rem; font-size: 0.875rem;">@Localizer["Restrict the free plan to a specific number of claims per device to prevent abuse."]</p>
        
        @{
            bool fingerprintCheck = (Model.FirstOrDefault(s => s.Key == "FreePlan.FingerprintCheck")?.Value == "true");
        }
        
        <div class="bx--form-item bx--checkbox-wrapper" style="margin-bottom: 1rem;">
            <input type="hidden" name="settings[FreePlan.FingerprintCheck]" value="false" id="hidden_FreePlan_FingerprintCheck" />
            <input id="FreePlan_FingerprintCheck" class="bx--checkbox" type="checkbox" name="settings[FreePlan.FingerprintCheck]" value="true" @(fingerprintCheck ? "checked" : "") onchange="document.getElementById('hidden_FreePlan_FingerprintCheck').disabled = this.checked;">
            <label for="FreePlan_FingerprintCheck" class="bx--checkbox-label">
                <span class="bx--checkbox-label-text">@Localizer["Enable Fingerprint Limit for Free Plans"]</span>
            </label>
            <script>document.getElementById('hidden_FreePlan_FingerprintCheck').disabled = document.getElementById('FreePlan_FingerprintCheck').checked;</script>
        </div>

        <div class="bx--form-item" style="margin-bottom: 1rem;">
            <label for="FreePlan_MaxUsesPerDevice" class="bx--label">@Localizer["Max Uses Per Device"]</label>
            <input id="FreePlan_MaxUsesPerDevice" type="number" class="bx--text-input" name="settings[FreePlan.MaxUsesPerDevice]" value="@Model.FirstOrDefault(s => s.Key == "FreePlan.MaxUsesPerDevice")?.Value" placeholder="1" min="1">
            <div class="bx--form__helper-text">@Localizer["Number of accounts per device that can claim the free plan (e.g. 1)."]</div>
        </div>

        <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
            <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Save Free Plan Settings"]</button>
        </div>
    </form>

    <!-- AFFILIATE SETTINGS FORM -->
    <form action="@Url.Action("SaveSettings", "SettingsAdmin")" method="post" style="background: #ffffff; padding: 2rem; border: 1px solid #e0e0e0; margin-bottom: 2rem; border-top: 4px solid #8a3ffc;">
        @Html.AntiForgeryToken()

        <h3 style="margin-bottom: 1rem; border-bottom: 1px solid #e0e0e0; padding-bottom: 0.5rem;">@Localizer["Affiliate & Referral Settings"]</h3>
        <p style="color: #525252; margin-bottom: 1rem; font-size: 0.875rem;">@Localizer["Configure rewards for the referral and cash affiliate program."]</p>
        
        <div class="bx--form-item" style="margin-bottom: 1rem;">
            <label for="Affiliate_CreditRewardReferrer" class="bx--label">@Localizer["Credit Reward (Referrer)"]</label>
            <input id="Affiliate_CreditRewardReferrer" type="number" class="bx--text-input" name="settings[Affiliate.CreditRewardReferrer]" value="@Model.FirstOrDefault(s => s.Key == "Affiliate.CreditRewardReferrer")?.Value" placeholder="50">
            <div class="bx--form__helper-text">@Localizer["Amount of credits to give the person who shared their link."]</div>
        </div>

        <div class="bx--form-item" style="margin-bottom: 1rem;">
            <label for="Affiliate_CreditRewardReferred" class="bx--label">@Localizer["Credit Reward (Referred User)"]</label>
            <input id="Affiliate_CreditRewardReferred" type="number" class="bx--text-input" name="settings[Affiliate.CreditRewardReferred]" value="@Model.FirstOrDefault(s => s.Key == "Affiliate.CreditRewardReferred")?.Value" placeholder="50">
            <div class="bx--form__helper-text">@Localizer["Amount of credits to give the new user who signed up using a link."]</div>
        </div>

        <div class="bx--form-item" style="margin-bottom: 1rem;">
            <label for="Affiliate_CashCommissionPercentage" class="bx--label">@Localizer["Cash Affiliate Commission (%)"]</label>
            <input id="Affiliate_CashCommissionPercentage" type="number" step="0.1" class="bx--text-input" name="settings[Affiliate.CashCommissionPercentage]" value="@Model.FirstOrDefault(s => s.Key == "Affiliate.CashCommissionPercentage")?.Value" placeholder="20">
            <div class="bx--form__helper-text">@Localizer["Percentage of cash commission given to Cash Affiliates upon payments."]</div>
        </div>

        <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
            <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Save Affiliate Settings"]</button>
        </div>
    </form>
</div>

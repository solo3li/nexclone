@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer
@inject Microsoft.AspNetCore.Identity.UserManager<NexClone.Backend.Core.Entities.ApplicationUser> UserManager
@{
    var lang = Context.Request.Cookies["AdminLang"]?.Contains("ar") == true ? "ar" : "en";
    var dir = lang == "ar" ? "rtl" : "ltr";
    
    var currentUser = await UserManager.GetUserAsync(User);
    var isSuperAdmin = currentUser?.IsSuperAdmin ?? false;
    var visibleSections = currentUser?.VisibleAdminSections ?? "";
}
<!DOCTYPE html>
<html lang="@lang" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NexClone Admin</title>
    <!-- Carbon Design System CSS -->
    <link rel="stylesheet" href="https://unpkg.com/carbon-components/css/carbon-components.min.css">
    <!-- Boxicons for Modern Icons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <!-- HTMX for SPA-like navigation -->
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <style>
        /* Modern Sidebar Theme Overrides */
        :root {
            --admin-bg: #f4f7f6;
            --sidebar-bg: #161616;
            --sidebar-text: #f4f4f4;
            --sidebar-hover: #393939;
            --primary-color: #0f62fe;
        }

        html[dir="rtl"] {
            text-align: right;
        }
        
        html[dir="rtl"] .modern-sidebar {
            left: auto !important;
            right: 0 !important;
            box-shadow: -4px 0 16px rgba(0,0,0,0.1);
        }

        html[dir="rtl"] .sidebar-menu-item a {
            border-left: none !important;
            border-right: 4px solid transparent !important;
            padding: 1rem 1.5rem 1rem 1rem !important;
        }

        html[dir="rtl"] .sidebar-menu-item.active a {
            border-right-color: var(--primary-color) !important;
        }

        html[dir="rtl"] .sidebar-menu-item a i {
            margin-right: 0 !important;
            margin-left: 1rem !important;
        }

        html[dir="rtl"] .bx--content {
            margin-left: 0 !important;
            margin-right: 256px !important;
        }
        
        html[dir="rtl"] .modern-sidebar.collapsed .sidebar-menu-item a i {
            margin-left: 2rem !important;
            margin-right: 0 !important;
        }
        
        html[dir="rtl"] .sidebar-menu-item.collapsed a {
            padding-right: 1.5rem !important;
            padding-left: 0 !important;
        }

        html[dir="rtl"] .bx--content.expanded-content {
            margin-left: 0 !important;
            margin-right: 72px !important;
        }

        html[dir="rtl"] #desktop-collapse-btn {
            margin-left: 0;
            margin-right: auto;
        }

        html[dir="rtl"] .modern-sidebar.collapsed #desktop-collapse-btn {
            margin-right: 0;
        }

        /* Carbon Overrides for RTL */
        html[dir="rtl"] .bx--data-table th, 
        html[dir="rtl"] .bx--data-table td {
            text-align: right;
            padding-left: 1rem;
            padding-right: 1rem;
        }

        html[dir="rtl"] .bx--pagination {
            flex-direction: row-reverse;
        }

        html[dir="rtl"] .bx--pagination__left {
            margin-right: 0;
            margin-left: auto;
        }

        html[dir="rtl"] .bx--pagination__right {
            margin-left: 0;
            margin-right: auto;
            flex-direction: row-reverse;
        }

        html[dir="rtl"] .bx--btn {
            flex-direction: row;
        }
        html[dir="rtl"] .bx--btn i {
            margin-left: 0;
            margin-right: 0.5rem;
        }

        html[dir="rtl"] .mobile-menu-btn {
            margin-right: 0;
            margin-left: 1rem;
        }

        @@media (max-width: 768px) {
            html[dir="rtl"] .modern-sidebar {
                transform: translateX(100%);
            }
            html[dir="rtl"] .modern-sidebar.open {
                transform: translateX(0);
            }
            html[dir="rtl"] .bx--content {
                margin-right: 0;
            }
            html[dir="rtl"] [style*="align-items: flex-start"] {
                align-items: flex-end !important;
            }
        }

        body { 
            margin: 0; 
            padding: 0; 
            background-color: var(--admin-bg); 
            font-family: 'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif;
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar Styling */
        .modern-sidebar {
            width: 256px;
            background-color: var(--sidebar-bg);
            color: var(--sidebar-text);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 10000;
            box-shadow: 4px 0 16px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
        }

        .sidebar-header {
            padding: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            border-bottom: 1px solid #393939;
        }

        .sidebar-header i {
            font-size: 1.5rem;
            color: var(--primary-color);
        }

        .sidebar-brand {
            font-size: 1.25rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            color: #ffffff;
            text-decoration: none;
        }

        .sidebar-nav {
            padding: 1.5rem 0;
            flex: 1;
            overflow-y: auto;
        }

        /* Custom Scrollbar for Sidebar */
        .sidebar-nav::-webkit-scrollbar {
            width: 6px;
        }
        .sidebar-nav::-webkit-scrollbar-track {
            background: var(--sidebar-bg);
        }
        .sidebar-nav::-webkit-scrollbar-thumb {
            background: #393939;
            border-radius: 4px;
        }
        .sidebar-nav::-webkit-scrollbar-thumb:hover {
            background: #525252;
        }

        .sidebar-menu {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .sidebar-menu-item a {
            display: flex;
            align-items: center;
            padding: 1rem 1.5rem;
            color: #c6c6c6;
            text-decoration: none;
            font-size: 0.875rem;
            transition: all 0.2s;
            border-left: 4px solid transparent;
        }

        .sidebar-menu-item a i {
            font-size: 1.25rem;
            margin-right: 1rem;
        }

        .sidebar-menu-item a:hover {
            background-color: var(--sidebar-hover);
            color: #ffffff;
        }

        .sidebar-menu-item.active a {
            background-color: var(--sidebar-hover);
            color: #ffffff;
            border-left-color: var(--primary-color);
        }

        .sidebar-footer {
            padding: 1rem 1.5rem;
            border-top: 1px solid #393939;
            font-size: 0.75rem;
            color: #8d8d8d;
        }

        /* Main Content Area */
        .bx--content { 
            margin-left: 256px; /* Offset for sidebar */
            padding: 2.5rem; 
            width: calc(100% - 256px);
            min-height: 100vh;
            transition: all 0.3s ease;
        }

        /* Collapse Sidebar Styles */
        .modern-sidebar.collapsed { width: 72px; }
        .modern-sidebar.collapsed .sidebar-brand { display: none; }
        .modern-sidebar.collapsed .sidebar-header > i:first-child { display: none; }
        .modern-sidebar.collapsed .sidebar-header { padding: 1.5rem; justify-content: center; }
        .modern-sidebar.collapsed .sidebar-menu-item a { color: transparent; white-space: nowrap; overflow: hidden; padding-left: 1.5rem; }
        .modern-sidebar.collapsed .sidebar-menu-item a i { color: #c6c6c6; margin-right: 2rem; font-size: 1.5rem; }
        .modern-sidebar.collapsed .sidebar-menu-item.active a i,
        .modern-sidebar.collapsed .sidebar-menu-item a:hover i { color: #ffffff; }
        .modern-sidebar.collapsed .sidebar-footer { color: transparent; white-space: nowrap; overflow: hidden; }
        
        .bx--content.expanded-content { margin-left: 72px; width: calc(100% - 72px); }

        #desktop-collapse-btn {
            background: none; border: none; color: #c6c6c6; cursor: pointer; font-size: 1.5rem; padding: 0; margin-left: auto;
            display: flex; align-items: center; justify-content: center;
        }
        #desktop-collapse-btn:hover { color: #ffffff; }
        .modern-sidebar.collapsed #desktop-collapse-btn { margin-left: 0; }


        /* Modernizing the Carbon Content */
        .page-header {
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #e0e0e0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 300;
            color: #161616;
            margin: 0;
        }

        /* Global Table & Layout Fixes (Applies to all screens) */
        .bx--data-table-container {
            width: 100%;
            overflow-x: auto;
            border: 1px solid #e0e0e0;
        }
        .bx--data-table th, .bx--data-table td {
            white-space: nowrap; /* Prevents text from breaking into multiple lines */
        }
        .bx--tag {
            white-space: nowrap !important;
            word-break: keep-all !important;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* Mobile Responsiveness */
        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            font-size: 2rem;
            cursor: pointer;
            color: #161616;
            padding: 0;
            margin-right: 1rem;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 9999;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        @@media (max-width: 768px) {
            /* Sidebar and Navigation */
            .modern-sidebar { transform: translateX(-100%); }
            .modern-sidebar.open { transform: translateX(0); }
            .bx--content { margin-left: 0; width: 100%; padding: 1rem; overflow-x: hidden; }
            .mobile-menu-btn { display: block; }
            .sidebar-overlay.active { display: block; opacity: 1; }
            
            /* Typography */
            .page-title { font-size: 1.5rem; }
            h1, h2, h3, h4, h5 { font-size: 1.25rem !important; }

            /* Grid Layouts */
            .bx--row { flex-direction: column !important; margin-left: 0 !important; margin-right: 0 !important; }
            .bx--col { padding-left: 0 !important; padding-right: 0 !important; width: 100% !important; margin-bottom: 1rem; }

            /* Fix inline flex containers (e.g., forms, headers) */
            [style*="display: flex"] {
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 0.75rem !important;
            }

            /* Exceptions to column stacking where horizontal layout is critical */
            .bx--pagination, 
            .bx--pagination__right, 
            .page-header > div,
            [style*="justify-content: flex-end"] {
                flex-direction: row !important;
                flex-wrap: wrap !important;
                align-items: center !important;
                gap: 0.5rem !important;
            }

            /* Responsive Data Tables */
            .bx--data-table-container {
                width: 100% !important;
                overflow-x: auto !important;
                -webkit-overflow-scrolling: touch;
                border: 1px solid #e0e0e0;
            }
            .bx--data-table {
                min-width: 800px !important;
            }

            /* Responsive Forms and Inputs */
            form {
                padding: 1rem !important;
            }
            .bx--form-item {
                width: 100% !important;
                flex: none !important;
            }
            .bx--text-input, .bx--select-input {
                width: 100% !important;
            }
            
            /* Button adjustments */
            .bx--btn {
                width: 100%;
                justify-content: center;
                margin-bottom: 0.5rem;
            }
            td .bx--btn, .bx--pagination .bx--btn, .page-header .bx--btn {
                width: auto;
                margin-bottom: 0;
            }
        }
    </style>
</head>
<body>
    
    <!-- Mobile Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebar-overlay"></div>

    <!-- Modern Dark Sidebar -->
    <aside class="modern-sidebar" id="modern-sidebar">
        <div class="sidebar-header">
            <i class='bx bxl-xing'></i>
            <a href="/" class="sidebar-brand">@Localizer["NexClone"]</a>
            <button id="desktop-collapse-btn" title="Toggle Sidebar">
                <i class='bx bx-menu'></i>
            </button>
        </div>
        
        <nav class="sidebar-nav">
            <ul class="sidebar-menu">
                <li class="sidebar-menu-item active">
                    <a href="/">
                        <i class='bx bx-grid-alt'></i>
                        @Localizer["Dashboard"]
                    </a>
                </li>
                @if (isSuperAdmin || visibleSections.Contains("/Users")) {
                    <li class="sidebar-menu-item">
                    <a href="/Users">
                        <i class='bx bx-user'></i>
                        @Localizer["Users Management"]
                    </a>
                </li>
                }
                @if (isSuperAdmin || visibleSections.Contains("/Subscriptions")) {
                    <li class="sidebar-menu-item">
                    <a href="/Subscriptions">
                        <i class='bx bx-credit-card-front'></i>
                        @Localizer["Subscriptions"]
                    </a>
                </li>
                }
                @if (isSuperAdmin || visibleSections.Contains("/PlansAdmin")) {
                    <li class="sidebar-menu-item">
                    <a href="@Url.Action("Index", "PlansAdmin")">
                        <i class='bx bx-layer'></i>
                        @Localizer["Pricing &amp; Plans"]
                    </a>
                </li>
                }

                @if (isSuperAdmin || visibleSections.Contains("/AffiliateAdmin")) {
                    <li class="sidebar-menu-item">
                    <a href="@Url.Action("Index", "AffiliateAdmin")">
                        <i class='bx bx-share-alt'></i>
                        @Localizer["Affiliate"]
                    </a>
                </li>
                }
                @if (isSuperAdmin || visibleSections.Contains("/ToolConfigAdmin")) {
                    <li class="sidebar-menu-item">
                    <a href="@Url.Action("Index", "ToolConfigAdmin")">
                        <i class='bx bx-slider-alt'></i>
                        @Localizer["Tool Settings"]
                    </a>
                </li>
                }
                @if (isSuperAdmin || visibleSections.Contains("/SettingsAdmin")) {
                    <li class="sidebar-menu-item">
                    <a href="@Url.Action("Index", "SettingsAdmin")">
                        <i class='bx bx-cog'></i>
                        @Localizer["Global Settings"]
                    </a>
                </li>
                }
                @if (isSuperAdmin || visibleSections.Contains("/CustomPagesAdmin")) {
                    <li class="sidebar-menu-item">
                    <a href="/CustomPagesAdmin">
                        <i class='bx bx-file'></i>
                        @Localizer["Custom Pages"]
                    </a>
                </li>
                }

                @if (isSuperAdmin || visibleSections.Contains("/BlogAdmin")) {
                    <li class="sidebar-menu-item">
                    <a href="/BlogAdmin">
                        <i class='bx bx-news'></i>
                        @Localizer["Blog"]
                    </a>
                </li>
                }


                @if (isSuperAdmin || visibleSections.Contains("/TicketsAdmin")) {
                    <li class="sidebar-menu-item">
                    <a href="/TicketsAdmin">
                        <i class='bx bx-support'></i>
                        @Localizer["Support Tickets"]
                    </a>
                </li>
                }
                @if (isSuperAdmin || visibleSections.Contains("/HistoryAdmin")) {
                    <li class="sidebar-menu-item">
                    <a href="@Url.Action("Index", "HistoryAdmin")">
                        <i class='bx bx-history'></i>
                        @Localizer["Operations History"]
                    </a>
                </li>
                }

                @if (isSuperAdmin || visibleSections.Contains("/LogsAdmin")) {
                    <li class="sidebar-menu-item">
                    <a href="@Url.Action("Index", "LogsAdmin")">
                        <i class='bx bx-terminal'></i>
                        @Localizer["System Logs"]
                    </a>
                </li>
                }
                @if (isSuperAdmin || visibleSections.Contains("/Voices")) {
                    <li class="sidebar-menu-item">
                    <a href="/Voices">
                        <i class='bx bx-microphone'></i>
                        @Localizer["AI Voices"]
                    </a>
                </li>
                }
                @if (isSuperAdmin || visibleSections.Contains("/PaymentConfigAdmin")) {
                    <li class="sidebar-menu-item">
                    <a href="/PaymentConfigAdmin">
                        <i class='bx bx-credit-card-alt'></i>
                        @Localizer["Payment Gateways"]
                    </a>
                </li>
                }
                @if (isSuperAdmin || visibleSections.Contains("/ApiConfigAdmin")) {
                    <li class="sidebar-menu-item">
                    <a href="/ApiConfigAdmin">
                        <i class='bx bx-key'></i>
                        @Localizer["API Keys"]
                    </a>
                </li>
                }
                @if (isSuperAdmin || visibleSections.Contains("/MailingAdmin")) {
                    <li class="sidebar-menu-item">
                    <a href="/MailingAdmin">
                        <i class='bx bx-envelope'></i>
                        @Localizer["Mailing &amp; Emails"]
                    </a>
                </li>
                }
                @if (isSuperAdmin || visibleSections.Contains("/ManualPaymentsAdmin")) {
                    <li class="sidebar-menu-item">
                    <a href="/ManualPaymentsAdmin">
                        <i class='bx bx-receipt'></i>
                        @Localizer["Pending Payments"]
                    </a>
                </li>
                }
                @if (isSuperAdmin || visibleSections.Contains("/PaymentsAdmin")) {
                    <li class="sidebar-menu-item">
                    <a href="/PaymentsAdmin">
                        <i class='bx bx-history'></i>
                        @Localizer["Payments History"]
                    </a>
                </li>
                }
                @if (isSuperAdmin || visibleSections.Contains("/ManualPaymentMethodsAdmin")) {
                    <li class="sidebar-menu-item">
                    <a href="/ManualPaymentMethodsAdmin">
                        <i class='bx bx-wallet'></i>
                        @Localizer["Payment Methods"]
                    </a>
                </li>
                }

                <li class="sidebar-menu-item">
                    <a href="/AdminAuth/SwitchLang?lang=@(lang == "en" ? "ar" : "en")">
                        <i class='bx bx-globe'></i>
                        @(lang == "en" ? "اللغة العربية" : "English")
                    </a>
                </li>
            </ul>
        </nav>

        <div class="sidebar-footer">
            @Localizer["&copy; 2026 NexClone Admin"]
        </div>
    </aside>

    <!-- Main Content Area where HTMX will load pages -->
    <main class="bx--content" id="main-content">
        <div class="page-header">
            <div style="display: flex; align-items: center;">
                <button id="mobile-menu-btn" class="mobile-menu-btn">
                    <i class='bx bx-menu'></i>
                </button>
                <h1 class="page-title">@ViewData["Title"]</h1>
            </div>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
                <a href="/AdminAuth/SwitchLang?lang=en" class="bx--btn bx--btn--ghost @(lang == "en" ? "bx--btn--primary" : "")" style="padding: 0.5rem; text-decoration: none; @(lang == "en" ? "color: white; background: var(--primary-color);" : "")">English</a>
                <a href="/AdminAuth/SwitchLang?lang=ar" class="bx--btn bx--btn--ghost @(lang == "ar" ? "bx--btn--primary" : "")" style="padding: 0.5rem; text-decoration: none; @(lang == "ar" ? "color: white; background: var(--primary-color);" : "")">عربي</a>
            </div>
        </div>
        
        <!-- Flash messages or notifications could go here -->

        @RenderBody()
    </main>

    <!-- Carbon Design System JS -->
    <script src="https://unpkg.com/carbon-components/scripts/carbon-components.min.js"></script>
    
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <!-- Active Link Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const currentPath = window.location.pathname;
            const menuItems = document.querySelectorAll('.sidebar-menu-item');
            
            menuItems.forEach(item => {
                const link = item.querySelector('a');
                if (link.getAttribute('href') === currentPath) {
                    menuItems.forEach(i => i.classList.remove('active'));
                    item.classList.add('active');
                }
            });
        });

        // Update active link on HTMX navigation
        document.body.addEventListener('htmx:afterOnLoad', function(event) {
            const currentPath = new URL(event.detail.xhr.responseURL).pathname;
            const menuItems = document.querySelectorAll('.sidebar-menu-item');
            
            menuItems.forEach(item => {
                const link = item.querySelector('a');
                if (link.getAttribute('href') === currentPath) {
                    menuItems.forEach(i => i.classList.remove('active'));
                    item.classList.add('active');
                }
            });
        });

        // Mobile Sidebar Toggle Logic
        (function() {
            var mobileMenuBtn = document.getElementById('mobile-menu-btn');
            var sidebar = document.getElementById('modern-sidebar');
            var overlay = document.getElementById('sidebar-overlay');

            function toggleSidebar() {
                if (sidebar) sidebar.classList.toggle('open');
                if (overlay) overlay.classList.toggle('active');
            }

            function closeSidebar() {
                if (sidebar) sidebar.classList.remove('open');
                if (overlay) overlay.classList.remove('active');
            }

            if (mobileMenuBtn) {
                mobileMenuBtn.addEventListener('click', toggleSidebar);
            }
            
            if (overlay) {
                overlay.addEventListener('click', closeSidebar);
            }

            if (!document.body.dataset.sidebarListenerAdded) {
                document.body.addEventListener('htmx:afterOnLoad', function() {
                    var s = document.getElementById('modern-sidebar');
                    var o = document.getElementById('sidebar-overlay');
                    if (window.innerWidth <= 768) {
                        if (s) s.classList.remove('open');
                        if (o) o.classList.remove('active');
                    }
                });
                document.body.dataset.sidebarListenerAdded = "true";
            }

            // Desktop Collapse Logic
            var desktopCollapseBtn = document.getElementById('desktop-collapse-btn');
            var mainContent = document.getElementById('main-content');
            
            // Check localStorage for saved state
            if (localStorage.getItem('sidebar-collapsed') === 'true') {
                if (sidebar) sidebar.classList.add('collapsed');
                if (mainContent) mainContent.classList.add('expanded-content');
            }

            if (desktopCollapseBtn) {
                desktopCollapseBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (sidebar) {
                        sidebar.classList.toggle('collapsed');
                        var isCollapsed = sidebar.classList.contains('collapsed');
                        localStorage.setItem('sidebar-collapsed', isCollapsed);
                    }
                    if (mainContent) mainContent.classList.toggle('expanded-content');
                });
            }

            // Global SweetAlert2 Confirmation for forms
            document.addEventListener('submit', function(e) {
                var form = e.target;
                var submitter = e.submitter;
                var confirmMsg = form.getAttribute('data-confirm') || (submitter ? submitter.getAttribute('data-confirm') : null);

                if (confirmMsg) {
                    e.preventDefault();
                    Swal.fire({
                        title: '@Localizer["Are you sure?"]',
                        text: confirmMsg,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#da1e28',
                        cancelButtonColor: '#393939',
                        confirmButtonText: '@Localizer["Yes, proceed"]',
                        cancelButtonText: '@Localizer["Cancel"]'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            if (form.hasAttribute('data-confirm')) form.removeAttribute('data-confirm');
                            if (submitter && submitter.hasAttribute('data-confirm')) submitter.removeAttribute('data-confirm');
                            
                            if (submitter) {
                                submitter.click();
                            } else {
                                form.submit();
                            }
                        } else if (result.dismiss === Swal.DismissReason.cancel) {
                            Swal.fire({
                                title: '@Localizer["Cancelled"]',
                                text: '@Localizer["No changes were made."]',
                                icon: 'info',
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 3000,
                                timerProgressBar: true
                            });
                        }
                    });
                }
            });

            // Intercept clicks on links or non-submit buttons with data-confirm
            document.addEventListener('click', function(e) {
                var target = e.target.closest('[data-confirm]');
                if (target && target.tagName !== 'FORM' && target.type !== 'submit') {
                    e.preventDefault();
                    var message = target.getAttribute('data-confirm');
                    Swal.fire({
                        title: '@Localizer["Are you sure?"]',
                        text: message,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#da1e28',
                        cancelButtonColor: '#393939',
                        confirmButtonText: '@Localizer["Yes, proceed"]',
                        cancelButtonText: '@Localizer["Cancel"]'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            target.removeAttribute('data-confirm');
                            if (target.tagName === 'A') {
                                window.location.href = target.href;
                            } else {
                                target.click();
                            }
                        } else if (result.dismiss === Swal.DismissReason.cancel) {
                            Swal.fire({
                                title: '@Localizer["Cancelled"]',
                                text: '@Localizer["No changes were made."]',
                                icon: 'info',
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 3000,
                                timerProgressBar: true
                            });
                        }
                    });
                }
            });

            // Global TempData Alerts
            @if (TempData["SuccessMessage"] != null || TempData["Success"] != null)
            {
                var sMsg = (TempData["SuccessMessage"] as string ?? TempData["Success"] as string)?.Replace("'", "\\'").Replace("\n", " ").Replace("\r", "");
                <text>
                Swal.fire({
                    title: '@Localizer["Success"]',
                    text: '@Html.Raw(sMsg)',
                    icon: 'success',
                    confirmButtonColor: '#0f62fe',
                    confirmButtonText: '@Localizer["OK"]'
                });
                </text>
            }
            
            @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
            {
                var eMsg = (TempData["ErrorMessage"] as string ?? TempData["Error"] as string)?.Replace("'", "\\'").Replace("\n", " ").Replace("\r", "");
                <text>
                Swal.fire({
                    title: '@Localizer["Error"]',
                    text: '@Html.Raw(eMsg)',
                    icon: 'error',
                    confirmButtonColor: '#da1e28',
                    confirmButtonText: '@Localizer["OK"]'
                });
                </text>
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

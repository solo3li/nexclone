@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer
@{
    var lang = Context.Request.Cookies["AdminLang"]?.Contains("ar") == true ? "ar" : "en";
    var dir = lang == "ar" ? "rtl" : "ltr";
}
<!DOCTYPE html>
<html lang="@lang" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NexClone Admin</title>
    <!-- Carbon Design System CSS -->
    <link rel="stylesheet" href="https://unpkg.com/carbon-components/css/carbon-components.min.css">
    <!-- Boxicons for Modern Icons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <!-- HTMX for SPA-like navigation -->
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    
    <!-- Mobile Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebar-overlay"></div>

    <!-- Modern Dark Sidebar -->
    <aside class="modern-sidebar" id="modern-sidebar">
        <div class="sidebar-header">
            <i class='bx bxl-xing'></i>
            <a href="/" class="sidebar-brand">@Localizer["NexClone"]</a>
            <button id="desktop-collapse-btn" title="Toggle Sidebar">
                <i class='bx bx-menu'></i>
            </button>
        </div>
        
        <nav class="sidebar-nav">
            <ul class="sidebar-menu">
                <li class="sidebar-menu-item active">
                    <a href="/">
                        <i class='bx bx-grid-alt'></i>
                        @Localizer["Dashboard"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="/Users">
                        <i class='bx bx-user'></i>
                        @Localizer["Users Management"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="/Subscriptions">
                        <i class='bx bx-credit-card-front'></i>
                        @Localizer["Subscriptions"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="@Url.Action("Index", "PlansAdmin")">
                        <i class='bx bx-layer'></i>
                        @Localizer["Pricing &amp; Plans"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="@Url.Action("Index", "WalletTypesAdmin")">
                        <i class='bx bx-wallet-alt'></i>
                        @Localizer["Wallet Types"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="@Url.Action("Index", "ToolConfigAdmin")">
                        <i class='bx bx-slider-alt'></i>
                        @Localizer["Tool Settings"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="@Url.Action("Index", "SettingsAdmin")">
                        <i class='bx bx-cog'></i>
                        @Localizer["Global Settings"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="/CustomPagesAdmin">
                        <i class='bx bx-file'></i>
                        @Localizer["Custom Pages"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="/SocialLinksAdmin">
                        <i class='bx bx-share-alt'></i>
                        @Localizer["Communication Links"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="/BlogAdmin">
                        <i class='bx bx-news'></i>
                        @Localizer["Blog Posts"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="/TicketsAdmin">
                        <i class='bx bx-support'></i>
                        @Localizer["Support Tickets"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="@Url.Action("Index", "HistoryAdmin")">
                        <i class='bx bx-history'></i>
                        @Localizer["Operations History"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="@Url.Action("Index", "SystemUpdatesAdmin")">
                        <i class='bx bx-sync'></i>
                        @Localizer["System Updates"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="@Url.Action("Index", "LogsAdmin")">
                        <i class='bx bx-terminal'></i>
                        @Localizer["System Logs"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="/Voices">
                        <i class='bx bx-microphone'></i>
                        @Localizer["AI Voices"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="/PaymentConfigAdmin">
                        <i class='bx bx-credit-card-alt'></i>
                        @Localizer["Payment Gateways"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="/ApiConfigAdmin">
                        <i class='bx bx-key'></i>
                        @Localizer["API Keys"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="/MailingAdmin">
                        <i class='bx bx-envelope'></i>
                        @Localizer["Mailing &amp; Emails"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="/ManualPaymentsAdmin">
                        <i class='bx bx-receipt'></i>
                        @Localizer["Pending Payments"]
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="/ManualPaymentMethodsAdmin">
                        <i class='bx bx-wallet'></i>
                        @Localizer["Payment Methods"]
                    </a>
                </li>

                <li class="sidebar-menu-item">
                    <a href="/AdminAuth/SwitchLang?lang=@(lang == "en" ? "ar" : "en")">
                        <i class='bx bx-globe'></i>
                        @(lang == "en" ? "اللغة العربية" : "English")
                    </a>
                </li>
            </ul>
        </nav>

        <div class="sidebar-footer">
            @Localizer["&copy; 2026 NexClone Admin"]
        </div>
    </aside>

    <!-- Main Content Area where HTMX will load pages -->
    <main class="bx--content" id="main-content">
        <div class="page-header">
            <div style="display: flex; align-items: center;">
                <button id="mobile-menu-btn" class="mobile-menu-btn">
                    <i class='bx bx-menu'></i>
                </button>
                <h1 class="page-title">@ViewData["Title"]</h1>
            </div>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
                <a href="/AdminAuth/SwitchLang?lang=en" class="bx--btn bx--btn--ghost @(lang == "en" ? "bx--btn--primary" : "")" style="padding: 0.5rem; text-decoration: none; @(lang == "en" ? "color: white; background: var(--primary-color);" : "")">English</a>
                <a href="/AdminAuth/SwitchLang?lang=ar" class="bx--btn bx--btn--ghost @(lang == "ar" ? "bx--btn--primary" : "")" style="padding: 0.5rem; text-decoration: none; @(lang == "ar" ? "color: white; background: var(--primary-color);" : "")">عربي</a>
            </div>
        </div>
        
        <!-- Flash messages or notifications could go here -->

        @RenderBody()
    </main>

    <!-- Carbon Design System JS -->
    <script src="https://unpkg.com/carbon-components/scripts/carbon-components.min.js"></script>
    
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <!-- Active Link Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const currentPath = window.location.pathname;
            const menuItems = document.querySelectorAll('.sidebar-menu-item');
            
            menuItems.forEach(item => {
                const link = item.querySelector('a');
                if (link.getAttribute('href') === currentPath) {
                    menuItems.forEach(i => i.classList.remove('active'));
                    item.classList.add('active');
                }
            });
        });

        // Update active link on HTMX navigation
        document.body.addEventListener('htmx:afterOnLoad', function(event) {
            const currentPath = new URL(event.detail.xhr.responseURL).pathname;
            const menuItems = document.querySelectorAll('.sidebar-menu-item');
            
            menuItems.forEach(item => {
                const link = item.querySelector('a');
                if (link.getAttribute('href') === currentPath) {
                    menuItems.forEach(i => i.classList.remove('active'));
                    item.classList.add('active');
                }
            });
        });

        // Mobile Sidebar Toggle Logic
        (function() {
            var mobileMenuBtn = document.getElementById('mobile-menu-btn');
            var sidebar = document.getElementById('modern-sidebar');
            var overlay = document.getElementById('sidebar-overlay');

            function toggleSidebar() {
                if (sidebar) sidebar.classList.toggle('open');
                if (overlay) overlay.classList.toggle('active');
            }

            function closeSidebar() {
                if (sidebar) sidebar.classList.remove('open');
                if (overlay) overlay.classList.remove('active');
            }

            if (mobileMenuBtn) {
                mobileMenuBtn.addEventListener('click', toggleSidebar);
            }
            
            if (overlay) {
                overlay.addEventListener('click', closeSidebar);
            }

            if (!document.body.dataset.sidebarListenerAdded) {
                var menuItems = document.querySelectorAll('.sidebar-menu-item');
                menuItems.forEach(item => {
                    item.addEventListener('click', () => {
                        if (window.innerWidth <= 1024) {
                            if (sidebar) sidebar.classList.remove('open');
                            if (overlay) overlay.classList.remove('active');
                        }
                    });
                });document.body.dataset.sidebarListenerAdded = "true";
            }

            // Desktop Collapse Logic
            var desktopCollapseBtn = document.getElementById('desktop-collapse-btn');
            var mainContent = document.getElementById('main-content');
            
            // Check localStorage for saved state
            if (localStorage.getItem('sidebar-collapsed') === 'true') {
                if (sidebar) sidebar.classList.add('collapsed');
                if (mainContent) mainContent.classList.add('expanded-content');
            }

            if (desktopCollapseBtn) {
                desktopCollapseBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (sidebar) {
                        sidebar.classList.toggle('collapsed');
                        var isCollapsed = sidebar.classList.contains('collapsed');
                        localStorage.setItem('sidebar-collapsed', isCollapsed);
                    }
                    if (mainContent) mainContent.classList.toggle('expanded-content');
                });
            }

            // Global SweetAlert2 Confirmation for forms
            document.addEventListener('submit', function(e) {
                var form = e.target;
                var submitter = e.submitter;
                var confirmMsg = form.getAttribute('data-confirm') || (submitter ? submitter.getAttribute('data-confirm') : null);

                if (confirmMsg) {
                    e.preventDefault();
                    Swal.fire({
                        title: '@Localizer["Are you sure?"]',
                        text: confirmMsg,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#da1e28',
                        cancelButtonColor: '#393939',
                        confirmButtonText: '@Localizer["Yes, proceed"]',
                        cancelButtonText: '@Localizer["Cancel"]'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            if (form.hasAttribute('data-confirm')) form.removeAttribute('data-confirm');
                            if (submitter && submitter.hasAttribute('data-confirm')) submitter.removeAttribute('data-confirm');
                            
                            if (submitter) {
                                submitter.click();
                            } else {
                                form.submit();
                            }
                        } else if (result.dismiss === Swal.DismissReason.cancel) {
                            Swal.fire({
                                title: '@Localizer["Cancelled"]',
                                text: '@Localizer["No changes were made."]',
                                icon: 'info',
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 3000,
                                timerProgressBar: true
                            });
                        }
                    });
                }
            });

            // Intercept clicks on links or non-submit buttons with data-confirm
            document.addEventListener('click', function(e) {
                var target = e.target.closest('[data-confirm]');
                if (target && target.tagName !== 'FORM' && target.type !== 'submit') {
                    e.preventDefault();
                    var message = target.getAttribute('data-confirm');
                    Swal.fire({
                        title: '@Localizer["Are you sure?"]',
                        text: message,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#da1e28',
                        cancelButtonColor: '#393939',
                        confirmButtonText: '@Localizer["Yes, proceed"]',
                        cancelButtonText: '@Localizer["Cancel"]'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            target.removeAttribute('data-confirm');
                            if (target.tagName === 'A') {
                                window.location.href = target.href;
                            } else {
                                target.click();
                            }
                        } else if (result.dismiss === Swal.DismissReason.cancel) {
                            Swal.fire({
                                title: '@Localizer["Cancelled"]',
                                text: '@Localizer["No changes were made."]',
                                icon: 'info',
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 3000,
                                timerProgressBar: true
                            });
                        }
                    });
                }
            });

            // Global TempData Alerts
            @if (TempData["SuccessMessage"] != null || TempData["Success"] != null)
            {
                var sMsg = (TempData["SuccessMessage"] as string ?? TempData["Success"] as string)?.Replace("'", "\\'").Replace("\n", " ").Replace("\r", "");
                <text>
                Swal.fire({
                    title: '@Localizer["Success"]',
                    text: '@Html.Raw(sMsg)',
                    icon: 'success',
                    confirmButtonColor: '#0f62fe',
                    confirmButtonText: '@Localizer["OK"]'
                });
                </text>
            }
            
            @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
            {
                var eMsg = (TempData["ErrorMessage"] as string ?? TempData["Error"] as string)?.Replace("'", "\\'").Replace("\n", " ").Replace("\r", "");
                <text>
                Swal.fire({
                    title: '@Localizer["Error"]',
                    text: '@Html.Raw(eMsg)',
                    icon: 'error',
                    confirmButtonColor: '#da1e28',
                    confirmButtonText: '@Localizer["OK"]'
                });
                </text>
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

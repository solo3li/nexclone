@model IEnumerable<dynamic>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

<div class="bx--grid" style="padding-left: 0; max-width: 1200px; margin-left: 0;">
    <div class="bx--row" style="margin-bottom: 2rem;">
        <h2 style="margin: 0; font-weight: 400; font-size: 1.5rem;">@Localizer["All Referrals"]</h2>
        <p style="color: #525252; margin-top: 0.5rem;">@Localizer["View all referrals across the system, including regular users and cash affiliates."]</p>
    </div>

    <!-- Referrals Table -->
    <div style="background: #ffffff; padding: 2rem; border: 1px solid #e0e0e0; margin-bottom: 2rem;">
        <table class="bx--data-table bx--data-table--sort">
            <thead>
                <tr>
                    <th><span class="bx--table-header-label">@Localizer["Referrer"]</span></th>
                    <th><span class="bx--table-header-label">@Localizer["Referred User"]</span></th>
                    <th><span class="bx--table-header-label">@Localizer["Joined At"]</span></th>
                    <th><span class="bx--table-header-label">@Localizer["Status"]</span></th>
                    <th><span class="bx--table-header-label">@Localizer["Reason"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.Referrer != null)
                            {
                                @item.Referrer.Email
                                @if (item.Referrer.IsCashAffiliate)
                                {
                                    <span class="bx--tag bx--tag--purple" style="margin-left: 8px;">@Localizer["Cash Affiliate"]</span>
                                }
                            }
                        </td>
                        <td>@(item.ReferredUser != null ? item.ReferredUser.Email : "Unknown")</td>
                        <td>@item.JoinedAt.ToString("g")</td>
                        <td>
                            @if (item.Status == "Active")
                            {
                                <span class="bx--tag bx--tag--green">@Localizer["Active"]</span>
                            }
                            else
                            {
                                <span class="bx--tag bx--tag--red">@item.Status</span>
                            }
                        </td>
                        <td style="max-width: 300px; white-space: normal;">@(string.IsNullOrEmpty(item.Reason) ? "-" : item.Reason)</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align: center; padding: 2rem;">@Localizer["No referrals found."]</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

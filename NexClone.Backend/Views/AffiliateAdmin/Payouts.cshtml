@model IEnumerable<NexClone.Backend.Core.Entities.AffiliateTransaction>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

<div class="bx--grid" style="padding-left: 0; max-width: 1200px; margin-left: 0;">
    <div class="bx--row" style="margin-bottom: 2rem;">
        <h2 style="margin: 0; font-weight: 400; font-size: 1.5rem;">@Localizer["Affiliate Payout Requests"]</h2>
        <p style="color: #525252; margin-top: 0.5rem;">@Localizer["Review and process payout requests from your cash affiliates."]</p>
    </div>

    <div style="background: #ffffff; padding: 2rem; border: 1px solid #e0e0e0; margin-bottom: 2rem;">
        <table class="bx--data-table bx--data-table--sort">
            <thead>
                <tr>
                    <th><span class="bx--table-header-label">@Localizer["Date"]</span></th>
                    <th><span class="bx--table-header-label">@Localizer["Affiliate"]</span></th>
                    <th><span class="bx--table-header-label">@Localizer["Amount"]</span></th>
                    <th><span class="bx--table-header-label">@Localizer["Notes/Details"]</span></th>
                    <th><span class="bx--table-header-label">@Localizer["Status"]</span></th>
                    <th><span class="bx--table-header-label">@Localizer["Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CreatedAt.ToString("g")</td>
                        <td>@item.Affiliate.Email</td>
                        <td>@item.Amount.ToString("0.00") EGP</td>
                        <td style="max-width: 300px; word-wrap: break-word; white-space: normal;">@item.Notes</td>
                        <td>
                            @if (item.Status == "Pending")
                            {
                                <span class="bx--tag bx--tag--warning">@Localizer["Pending"]</span>
                            }
                            else if (item.Status == "Completed")
                            {
                                <span class="bx--tag bx--tag--green">@Localizer["Completed"]</span>
                            }
                            else if (item.Status == "Rejected")
                            {
                                <span class="bx--tag bx--tag--red">@Localizer["Rejected"]</span>
                            }
                        </td>
                        <td>
                            @if (item.Status == "Pending")
                            {
                                <form action="@Url.Action("UpdatePayoutStatus", "AffiliateAdmin")" method="post" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="status" value="Completed" />
                                    <button type="submit" class="bx--btn bx--btn--primary bx--btn--sm" onclick="return confirm('Mark as Paid?');">@Localizer["Mark Paid"]</button>
                                </form>
                                <form action="@Url.Action("UpdatePayoutStatus", "AffiliateAdmin")" method="post" style="display: inline; margin-left: 0.5rem;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="status" value="Rejected" />
                                    <button type="submit" class="bx--btn bx--btn--danger bx--btn--sm" onclick="return confirm('Reject and refund balance?');">@Localizer["Reject"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 2rem;">@Localizer["No payout requests found."]</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

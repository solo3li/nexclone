@model NexClone.Backend.Application.Services.AffiliateSettingsDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

<div class="bx--grid" style="padding-left:0; max-width:700px;">
    <div class="bx--row" style="margin-bottom:1.5rem;">
        <h2 style="margin:0; font-weight:400; font-size:1.5rem;">Affiliate Settings</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bx--inline-notification bx--inline-notification--success" style="margin-bottom:1.5rem;">
            <p>@TempData["Success"]</p>
        </div>
    }

    <form method="post" action="@Url.Action("AffiliateSettings")" style="background:#ffffff; padding:2rem; border:1px solid #e0e0e0;">
        @Html.AntiForgeryToken()

        <!-- Enable / Disable -->
        <div class="bx--form-item bx--checkbox-wrapper" style="margin-bottom:1.5rem;">
            <input id="IsEnabled" type="checkbox" name="IsEnabled" value="true"
                   class="bx--checkbox" @(Model.IsEnabled ? "checked" : "") />
            <label class="bx--checkbox-label" for="IsEnabled">Affiliate System Enabled</label>
        </div>

        <!-- Hold Period -->
        <div class="bx--form-item" style="margin-bottom:1.5rem;">
            <label for="HoldPeriodDays" class="bx--label">Commission Hold Period (days)</label>
            <div class="bx--text-input__field-wrapper">
                <input id="HoldPeriodDays" type="number" min="0" max="365" class="bx--text-input"
                       name="HoldPeriodDays" value="@Model.HoldPeriodDays" style="max-width:200px;" />
            </div>
            <p class="bx--form__helper-text">Number of days a new commission stays PENDING before becoming AVAILABLE.</p>
        </div>

        <!-- Attribution Period -->
        <div class="bx--form-item" style="margin-bottom:1.5rem;">
            <label for="AttributionPeriodDays" class="bx--label">Referral Attribution Period (days)</label>
            <div class="bx--text-input__field-wrapper">
                <input id="AttributionPeriodDays" type="number" min="1" max="365" class="bx--text-input"
                       name="AttributionPeriodDays" value="@Model.AttributionPeriodDays" style="max-width:200px;" />
            </div>
            <p class="bx--form__helper-text">Days after clicking a referral link during which a signup is attributed to the affiliate.</p>
        </div>

        <!-- Recurring Commission -->
        <div class="bx--form-item bx--checkbox-wrapper" style="margin-bottom:1.5rem;">
            <input id="RecurringEnabled" type="checkbox" name="RecurringEnabled" value="true"
                   class="bx--checkbox" @(Model.RecurringEnabled ? "checked" : "") />
            <label class="bx--checkbox-label" for="RecurringEnabled">Recurring Commission Enabled</label>
        </div>

        <!-- Stop on Cancellation -->
        <div class="bx--form-item bx--checkbox-wrapper" style="margin-bottom:1.5rem;">
            <input id="StopOnCancellation" type="checkbox" name="StopOnCancellation" value="true"
                   class="bx--checkbox" @(Model.StopOnCancellation ? "checked" : "") />
            <label class="bx--checkbox-label" for="StopOnCancellation">Stop Recurring Commission After Subscription Cancellation</label>
        </div>

        <!-- Fraud Prevention -->
        <div class="bx--form-item bx--checkbox-wrapper" style="margin-bottom:1.5rem;">
            <input id="PreventFingerprintFraud" type="checkbox" name="PreventFingerprintFraud" value="true"
                   class="bx--checkbox" @(Model.PreventFingerprintFraud ? "checked" : "") />
            <label class="bx--checkbox-label" for="PreventFingerprintFraud">Prevent Self-Referral (Device Fingerprint)</label>
            <p class="bx--form__helper-text" style="margin-top:0.5rem; color:#d12727;">Recommended. Blocks referrals if the new user has the exact same device fingerprint as the affiliate.</p>
        </div>

        <div class="bx--form-item bx--checkbox-wrapper" style="margin-bottom:1.5rem;">
            <input id="PreventIpFraud" type="checkbox" name="PreventIpFraud" value="true"
                   class="bx--checkbox" @(Model.PreventIpFraud ? "checked" : "") />
            <label class="bx--checkbox-label" for="PreventIpFraud">Prevent Self-Referral (IP Address)</label>
            <p class="bx--form__helper-text" style="margin-top:0.5rem;">Blocks referrals if the new user shares the same IP address as the affiliate. (May block users in the same household/office).</p>
        </div>

        <!-- Limits -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; margin-bottom:1.5rem;">
            <div class="bx--form-item">
                <label for="MaxRecurringMonths" class="bx--label">Max Recurring Months (0 for unlimited)</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="MaxRecurringMonths" type="number" min="0" max="120" class="bx--text-input"
                           name="MaxRecurringMonths" value="@Model.MaxRecurringMonths" />
                </div>
            </div>
            <div class="bx--form-item">
                <label for="MaxInactivityDays" class="bx--label">Max Inactivity Days (0 for unlimited)</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="MaxInactivityDays" type="number" min="0" max="3650" class="bx--text-input"
                           name="MaxInactivityDays" value="@Model.MaxInactivityDays" />
                </div>
            </div>
        </div>

        <!-- Minimum Payout -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; margin-bottom:1.5rem;">
            <div class="bx--form-item">
                <label for="MinPayoutUsd" class="bx--label">Minimum Payout (USD)</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="MinPayoutUsd" type="number" min="0" step="0.01" class="bx--text-input"
                           name="MinPayoutUsd" value="@Model.MinPayoutUsd" />
                </div>
            </div>
            <div class="bx--form-item">
                <label for="MinPayoutEgp" class="bx--label">Minimum Payout (EGP)</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="MinPayoutEgp" type="number" min="0" step="0.01" class="bx--text-input"
                           name="MinPayoutEgp" value="@Model.MinPayoutEgp" />
                </div>
            </div>
        </div>

        <button type="submit" class="bx--btn bx--btn--primary">Save Settings</button>
        <a href="@Url.Action("Index")" class="bx--btn bx--btn--ghost" style="margin-left:0.5rem;">Cancel</a>
    </form>
</div>

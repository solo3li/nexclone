@model IEnumerable<NexClone.Backend.Core.Entities.Voice>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

@{
    ViewData["Title"] = "AI Voices Management";
}

<div class="bx--data-table-container">
    <div class="bx--data-table-header">
        <h4 class="bx--data-table-header__title">@Localizer["Manage AI Voices"]</h4>
        <p class="bx--data-table-header__description">@Localizer["View and manage all available AI voice characters imported from the legacy system."]</p>
    </div>

    <table class="bx--data-table bx--data-table--sort">
        <thead>
            <tr>
                <th><span class="bx--table-header-label">@Localizer["ID"]</span></th>
                <th><span class="bx--table-header-label">@Localizer["Name"]</span></th>
                <th><span class="bx--table-header-label">@Localizer["Gender"]</span></th>
                <th><span class="bx--table-header-label">@Localizer["Premium"]</span></th>
                <th><span class="bx--table-header-label">@Localizer["Active"]</span></th>
                <th><span class="bx--table-header-label">@Localizer["Gemini Voice"]</span></th>
                <th><span class="bx--table-header-label">@Localizer["Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td><strong>@item.Name</strong></td>
                    <td>@item.Gender</td>
                    <td>@(item.IsPremium ? "Yes" : "No")</td>
                    <td>
                        <span style="color: @(item.IsActive ? "green" : "red");">
                            @(item.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>@item.GeminiVoice</td>
                    <td>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" data-confirm="Are you sure you want to delete this voice?">
                            <button type="submit" class="bx--btn bx--btn--danger bx--btn--sm" style="padding: 5px 10px; font-size: 12px; height: auto; min-height: unset;">
                                @Localizer["Delete"]
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

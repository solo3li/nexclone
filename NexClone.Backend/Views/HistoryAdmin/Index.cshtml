@model IEnumerable<NexClone.Backend.Core.Entities.GenerationHistory>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

@{
    ViewData["Title"] = "Operations History";

    var toolMeta = new Dictionary<string, (string Label, string Color)>
    {
        ["text-to-voice"]   = ("نص إلى صوت",       "#8b5cf6"),
        ["voice-to-text"]   = ("صوت إلى نص",       "#ec4899"),
        ["lip-sync"]        = ("مزامنة الشفاه",     "#f43f5e"),
        ["image-to-video"]  = ("صورة إلى فيديو",   "#f97316"),
        ["bg-remover"]      = ("إزالة خلفية",       "#10b981"),
        ["gpt"]             = ("GPT",               "#3b82f6"),
    };

    string GetToolLabel(string type)  => toolMeta.TryGetValue(type, out var m) ? m.Label : type;
    string GetToolColor(string type)  => toolMeta.TryGetValue(type, out var m) ? m.Color : "#6b7280";

    string GetStatusColor(string s) => s switch {
        "completed"  => "#22c55e",
        "failed"     => "#ef4444",
        "processing" => "#f59e0b",
        _            => "#6b7280"
    };
}

<style>
    .hist-page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem; }
    .hist-page-header h1 { font-size: 1.8rem; font-weight: 800; margin: 0; color: var(--admin-text-primary); display: flex; align-items: center; gap: 0.6rem; }
    .hist-page-header h1 i { color: var(--admin-primary); }
    .hist-page-header p { margin: 4px 0 0; color: var(--admin-text-secondary); font-size: 0.9rem; }

    .hist-stats { display: grid; grid-template-columns: repeat(4,1fr); gap: 1.5rem; margin-bottom: 2.5rem; }
    .hist-stat { background: var(--admin-surface); border: 1px solid var(--admin-border-light); border-radius: var(--admin-radius-lg); padding: 1.5rem; display: flex; align-items: center; gap: 1.25rem; box-shadow: var(--shadow-soft); transition: var(--trans-smooth); }
    .hist-stat:hover { transform: translateY(-3px); box-shadow: var(--shadow-float); }
    .hist-stat__icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0; }
    .hist-stat__num { font-size: 1.9rem; font-weight: 800; line-height: 1; }
    .hist-stat__label { font-size: 0.75rem; color: var(--admin-text-secondary); margin-top: 4px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }

    .hist-filter-card { background: var(--admin-surface); border: 1px solid var(--admin-border-light); border-radius: var(--admin-radius-lg); padding: 1.5rem; box-shadow: var(--shadow-soft); margin-bottom: 2rem; }
    .hist-filter-card h5 { font-size: 1rem; font-weight: 700; margin: 0 0 1.25rem; display: flex; align-items: center; gap: 0.5rem; color: var(--admin-text-primary); }
    .hist-filter-card h5 i { color: var(--admin-primary); font-size: 1.2rem; }
    .hist-filters { display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: flex-end; }
    .hist-filters .bx--form-item { flex: 1; min-width: 200px; margin-bottom: 0 !important; }

    .btn-hist-filter { display: inline-flex; align-items: center; gap: 6px; padding: 10px 18px; border-radius: 10px; font-size: 0.85rem; font-weight: 700; white-space: nowrap; border: none; cursor: pointer; transition: var(--trans-smooth); text-decoration: none; }
    .btn-hist-primary { background: rgba(139,92,246,.1); color: var(--admin-primary); }
    .btn-hist-primary:hover { background: var(--admin-primary); color: #fff; transform: translateY(-2px); }
    .btn-hist-ghost { background: rgba(107,114,128,.1); color: #6b7280; }
    .btn-hist-ghost:hover { background: #6b7280; color: #fff; transform: translateY(-2px); }

    .hist-table-card { background: var(--admin-surface); border: 1px solid var(--admin-border-light); border-radius: var(--admin-radius-lg); box-shadow: var(--shadow-soft); overflow: hidden; }
    .hist-table-card .t-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--admin-border-light); display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .hist-table-card .t-header h4 { font-size: 1.05rem; font-weight: 700; margin: 0; display: flex; align-items: center; gap: 0.5rem; color: var(--admin-text-primary); }
    .hist-table-card .t-header h4 i { color: var(--admin-primary); }

    .hist-table-scroll { overflow-x: auto; }
    .hist-table { width: 100%; border-collapse: collapse; min-width: 900px; }
    .hist-table thead tr { background: rgba(139,92,246,.06); border-bottom: 2px solid var(--admin-border-light); }
    .hist-table th { padding: 0.85rem 1rem; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--admin-text-secondary); white-space: nowrap; text-align: left; }
    html[dir="rtl"] .hist-table th { text-align: right; }
    .hist-table tbody tr { border-bottom: 1px solid var(--admin-border-light); transition: background 0.2s; }
    .hist-table tbody tr:last-child { border-bottom: none; }
    .hist-table tbody tr:hover { background: rgba(139,92,246,.04); }
    .hist-table td { padding: 0.85rem 1rem; font-size: 0.87rem; color: var(--admin-text-primary); vertical-align: middle; white-space: nowrap; }

    .tool-badge { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 16px; font-size: 0.72rem; font-weight: 700; color: #fff; }
    .status-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 6px; }
    html[dir="rtl"] .status-dot { margin-right: 0; margin-left: 6px; }

    .btn-hist-details {
        display: inline-flex; align-items: center; gap: 4px; padding: 5px 12px; border-radius: 7px;
        background: rgba(139,92,246,.1); color: var(--admin-primary); font-size: 0.8rem; font-weight: 700;
        text-decoration: none; border: none; cursor: pointer; transition: var(--trans-smooth);
    }
    .btn-hist-details:hover { background: var(--admin-primary); color: #fff; transform: translateY(-1px); }

    .empty-hist { text-align: center; padding: 3.5rem 1.5rem; color: var(--admin-text-secondary); }
    .empty-hist i { font-size: 3.5rem; opacity: 0.3; display: block; margin-bottom: 0.75rem; }

    @@media (max-width: 1024px) { .hist-stats { grid-template-columns: repeat(2,1fr); } }
    @@media (max-width: 768px) { .hist-stats { grid-template-columns: 1fr; } .hist-filters { flex-direction: column; } }
</style>

<div class="hist-page-header">
    <div>
        <h1><i class='bx bx-history'></i> @Localizer["Operations History"]</h1>
        <p>@Localizer["View and filter AI operations performed by users."]</p>
    </div>
</div>

<!-- Stats Cards -->
<div class="hist-stats">
    <div class="hist-stat">
        <div class="hist-stat__icon" style="background: rgba(59,130,246,.12);"><i class='bx bx-archive' style="color: #3b82f6;"></i></div>
        <div><div class="hist-stat__num" style="color:#3b82f6">@ViewBag.TotalCount</div><div class="hist-stat__label">Total Operations</div></div>
    </div>
    <div class="hist-stat">
        <div class="hist-stat__icon" style="background: rgba(34,197,94,.12);"><i class='bx bx-check-circle' style="color: #22c55e;"></i></div>
        <div><div class="hist-stat__num" style="color:#22c55e">@ViewBag.CompletedCount</div><div class="hist-stat__label">Completed</div></div>
    </div>
    <div class="hist-stat">
        <div class="hist-stat__icon" style="background: rgba(245,158,11,.12);"><i class='bx bx-loader-alt' style="color: #f59e0b;"></i></div>
        <div><div class="hist-stat__num" style="color:#f59e0b">@ViewBag.ProcessingCount</div><div class="hist-stat__label">Processing</div></div>
    </div>
    <div class="hist-stat">
        <div class="hist-stat__icon" style="background: rgba(239,68,68,.12);"><i class='bx bx-x-circle' style="color: #ef4444;"></i></div>
        <div><div class="hist-stat__num" style="color:#ef4444">@ViewBag.FailedCount</div><div class="hist-stat__label">Failed</div></div>
    </div>
</div>

<!-- Filters Card -->
<div class="hist-filter-card">
    <h5><i class='bx bx-filter-alt'></i> @Localizer["Search & Filter"]</h5>
    <form method="get" asp-action="Index" class="hist-filters">
        <div class="bx--form-item">
            <label for="searchEmail" class="bx--label">@Localizer["User Email"]</label>
            <div class="bx--text-input__field-wrapper">
                <input id="searchEmail" type="text" name="searchEmail" class="bx--text-input"
                       placeholder="user@example.com" value="@ViewBag.CurrentSearch">
            </div>
        </div>

        <div class="bx--form-item">
            <label for="filterType" class="bx--label">@Localizer["Tool Type"]</label>
            <div class="bx--select">
                <select id="filterType" name="filterType" class="bx--select-input">
                    <option value="all" selected="@(ViewBag.FilterType == null || ViewBag.FilterType == "all")">@Localizer["All Tools"]</option>
                    <option value="text-to-voice" selected="@(ViewBag.FilterType == "text-to-voice")">🎙️ نص إلى صوت</option>
                    <option value="voice-to-text" selected="@(ViewBag.FilterType == "voice-to-text")">🎤 صوت إلى نص</option>
                    <option value="lip-sync" selected="@(ViewBag.FilterType == "lip-sync")">💋 مزامنة الشفاه</option>
                    <option value="image-to-video" selected="@(ViewBag.FilterType == "image-to-video")">🎬 صورة إلى فيديو</option>
                    <option value="bg-remover" selected="@(ViewBag.FilterType == "bg-remover")">🖼️ إزالة خلفية</option>
                    <option value="gpt" selected="@(ViewBag.FilterType == "gpt")">🤖 GPT</option>
                </select>
            </div>
        </div>

        <div class="bx--form-item">
            <label for="filterStatus" class="bx--label">@Localizer["Status"]</label>
            <div class="bx--select">
                <select id="filterStatus" name="filterStatus" class="bx--select-input">
                    <option value="all" selected="@(ViewBag.FilterStatus == null || ViewBag.FilterStatus == "all")">@Localizer["All Statuses"]</option>
                    <option value="completed" selected="@(ViewBag.FilterStatus == "completed")">✅ Completed</option>
                    <option value="processing" selected="@(ViewBag.FilterStatus == "processing")">⏳ Processing</option>
                    <option value="failed" selected="@(ViewBag.FilterStatus == "failed")">❌ Failed</option>
                </select>
            </div>
        </div>

        <div style="display:flex;gap:.5rem;align-items:flex-end;flex-shrink:0;">
            <button type="submit" class="btn-hist-filter btn-hist-primary"><i class='bx bx-search'></i> @Localizer["Search"]</button>
            <a href="@Url.Action("Index")" class="btn-hist-filter btn-hist-ghost"><i class='bx bx-x'></i> @Localizer["Reset"]</a>
        </div>
    </form>
</div>

<!-- Table Card -->
<div class="hist-table-card">
    <div class="t-header">
        <h4><i class='bx bx-list-ul'></i> @Localizer["Operations History"]</h4>
        <span class="badge badge-purple" style="background:rgba(139,92,246,.12);color:#7c3aed;padding:4px 12px;border-radius:20px;font-size:.78rem;font-weight:700;">
            @Model.Count() @Localizer["records"]
        </span>
    </div>

    <div class="hist-table-scroll">
        @if (Model.Any())
        {
            <table class="hist-table">
                <thead>
                    <tr>
                        <th>@Localizer["User Email"]</th>
                        <th>@Localizer["Tool"]</th>
                        <th>@Localizer["Task"]</th>
                        <th>@Localizer["Status"]</th>
                        <th>@Localizer["Credits"]</th>
                        <th>@Localizer["Output"]</th>
                        <th>@Localizer["Date"]</th>
                        <th>@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="font-size:0.85rem;font-weight:600;">@item.User?.Email</td>
                            <td>
                                <span class="tool-badge" style="background:@GetToolColor(item.Type)">
                                    @GetToolLabel(item.Type)
                                </span>
                            </td>
                            <td style="font-size:0.82rem;max-width:160px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@item.Title</td>
                            <td>
                                <span class="status-dot" style="background:@GetStatusColor(item.Status)"></span>
                                <span style="font-weight:700;color:@GetStatusColor(item.Status)">@item.Status</span>
                            </td>
                            <td><strong style="color:var(--admin-primary);">@item.CreditsUsed</strong> <span style="font-size:.75rem;color:var(--admin-text-secondary);">cr</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.FileUrl))
                                {
                                    @if (item.Type == "lip-sync" || item.Type == "image-to-video")
                                    {
                                        <span style="background:rgba(249,115,22,.12);color:#f97316;padding:3px 8px;border-radius:10px;font-size:0.75rem;font-weight:700">🎬 Video</span>
                                    }
                                    else if (item.Type == "text-to-voice")
                                    {
                                        <span style="background:rgba(139,92,246,.12);color:#8b5cf6;padding:3px 8px;border-radius:10px;font-size:0.75rem;font-weight:700">🎵 Audio</span>
                                    }
                                    else if (item.Type == "bg-remover")
                                    {
                                        <span style="background:rgba(16,185,129,.12);color:#10b981;padding:3px 8px;border-radius:10px;font-size:0.75rem;font-weight:700">🖼️ Image</span>
                                    }
                                    else
                                    {
                                        <span style="background:rgba(107,114,128,.12);color:#6b7280;padding:3px 8px;border-radius:10px;font-size:0.75rem;font-weight:700">📄 File</span>
                                    }
                                }
                                else if (item.Status == "processing")
                                {
                                    <span style="color:#f59e0b;font-size:0.78rem;font-weight:700">⏳ Pending</span>
                                }
                                else
                                {
                                    <span style="color:#9ca3af;font-size:0.78rem">—</span>
                                }
                            </td>
                            <td style="font-size:0.82rem;color:var(--admin-text-secondary);white-space:nowrap">@item.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                <a href="@Url.Action("Details", new { id = item.Id })" class="btn-hist-details">
                                    <i class='bx bx-show'></i> Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-hist">
                <i class='bx bx-ghost'></i>
                <p>@Localizer["No operations found."]</p>
            </div>
        }
    </div>
</div>

@model NexClone.Backend.Core.Entities.GenerationHistory
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

@{
    ViewData["Title"] = "Operation Details";

    var toolMeta = new Dictionary<string, (string Label, string Color, string Model)>
    {
        ["text-to-voice"]   = ("نص إلى صوت",       "#8b5cf6", "ElevenLabs"),
        ["voice-to-text"]   = ("صوت إلى نص",       "#ec4899", "OpenAI Whisper"),
        ["lip-sync"]        = ("مزامنة الشفاه",     "#f43f5e", "Crun AI (Vidu)"),
        ["image-to-video"]  = ("صورة إلى فيديو",   "#f97316", "CometAPI (Kling)"),
        ["bg-remover"]      = ("إزالة خلفية",       "#10b981", "Clipdrop"),
        ["gpt"]             = ("GPT",               "#3b82f6", "OpenAI GPT"),
    };

    string GetToolModel(string type)  => toolMeta.TryGetValue(type, out var m) ? m.Model : "Unknown";
}

<div class="bx--grid bx--grid--full-width">
    <div class="bx--row" style="margin-bottom: 2rem;">
        <div class="bx--col">
            <h1 class="bx--type-productive-heading-05">Operation Details: @Model.Title</h1>
        </div>
    </div>

    <div class="bx--row">
        <!-- Overview Card -->
        <div class="bx--col-lg-8" style="margin-bottom: 2rem;">
            <div style="background: #f4f4f4; padding: 2rem; border: 1px solid #e0e0e0; height: 100%;">
                <h3 class="bx--type-productive-heading-03" style="margin-bottom: 1.5rem; margin-top: 0;">@Localizer["Overview"]</h3>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 2rem;">
                    <div><strong>Operation ID:</strong> <span style="font-family: monospace;">@Model.Id</span></div>
                    <div><strong>User Email:</strong> @Model.User?.Email</div>
                    <div><strong>Tool/Type:</strong> <span class="bx--tag bx--tag--blue">@Model.Type</span></div>
                    <div><strong>AI Model:</strong> <span>@GetToolModel(Model.Type)</span></div>
                    <div><strong>Status:</strong> 
                        @if (Model.Status == "completed") {
                            <span style="color: green; font-weight: bold;">@Model.Status</span>
                        } else if (Model.Status == "failed") {
                            <span style="color: red; font-weight: bold;">@Model.Status</span>
                        } else {
                            <span style="color: orange; font-weight: bold;">@Model.Status</span>
                        }
                    </div>
                    <div><strong>Date:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                    <div><strong>Credits Used:</strong> @Model.CreditsUsed</div>
                    <div><strong>Duration:</strong> @Model.Duration</div>
                    <div><strong>Language:</strong> @Model.Lang</div>
                    <div><strong>Voice:</strong> @Model.Voice</div>
                </div>

                <div style="margin-top: 2rem; display: flex; gap: 1rem; align-items: center;">
                    <a href="@Url.Action("Index")" class="bx--btn bx--btn--secondary">@Localizer["Back to History"]</a>
                    
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('@Localizer["Are you sure you want to delete this operation?"]');">
                        <button type="submit" class="bx--btn bx--btn--danger">
                            <i class='bx bx-trash'></i> @Localizer["Delete Operation"]
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Inputs / Outputs -->
        <div class="bx--col-lg-8" style="margin-bottom: 2rem;">
            @if (Model.Status == "failed" && !string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div style="background-color: #f8d7da; border-left: 4px solid #dc3545; padding: 1.5rem; margin-bottom: 2rem; color: #721c24;">
                    <h4 style="margin-top: 0; margin-bottom: 0.5rem; font-weight: bold;">@Localizer["Error Details"]</h4>
                    <p style="margin: 0; white-space: pre-wrap;">@Model.ErrorMessage</p>
                </div>
            }

            <div style="background: #f4f4f4; padding: 2rem; border: 1px solid #e0e0e0; height: 100%;">
                <h3 class="bx--type-productive-heading-03" style="margin-bottom: 1.5rem; margin-top: 0;">@Localizer["I/O Details"]</h3>

                @if (!string.IsNullOrEmpty(Model.InputText))
                {
                    <div style="margin-bottom: 1.5rem;">
                        <strong>Input Text:</strong>
                        <div style="background: #fff; padding: 1rem; border: 1px solid #ccc; margin-top: 0.5rem; white-space: pre-wrap;">@Model.InputText</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.ResultText))
                {
                    <div style="margin-bottom: 1.5rem;">
                        <strong>Result Text:</strong>
                        <div style="background: #fff; padding: 1rem; border: 1px solid #ccc; margin-top: 0.5rem; white-space: pre-wrap;">@Model.ResultText</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.FileUrl))
                {
                    <div style="margin-bottom: 1.5rem;">
                        <strong>Generated / Input File:</strong>
                        <div style="margin-top: 0.5rem;">
                            @if (Model.FileUrl.EndsWith(".mp4") || Model.Type.Contains("video") || Model.Type == "lip-sync" || Model.Type == "image-to-video")
                            {
                                <video controls style="width: 100%; max-height: 500px; background: #000;">
                                    <source src="@Model.FileUrl" type="video/mp4">
                                    Your browser does not support the video element.
                                </video>
                            }
                            else if (Model.FileUrl.EndsWith(".mp3") || Model.FileUrl.EndsWith(".wav") || Model.Type.Contains("voice") || Model.Type.Contains("tts"))
                            {
                                <audio controls style="width: 100%;">
                                    <source src="@Model.FileUrl" type="audio/mpeg">
                                    Your browser does not support the audio element.
                                </audio>
                            }
                            else if (Model.FileUrl.EndsWith(".png") || Model.FileUrl.EndsWith(".jpg") || Model.FileUrl.EndsWith(".jpeg") || Model.Type.Contains("img") || Model.Type.Contains("bg-remover"))
                            {
                                <img src="@Model.FileUrl" style="max-width: 100%; border: 1px solid #ccc;" alt="Generated Image" />
                            }
                            else
                            {
                                <a href="@Model.FileUrl" target="_blank" class="bx--btn bx--btn--sm bx--btn--ghost">@Localizer["Download File"]</a>
                            }
                            
                            <div style="margin-top: 1rem;">
                                <a href="@Model.FileUrl" target="_blank" class="bx--btn bx--btn--sm bx--btn--ghost">@Localizer["Open File"]</a>
                            </div>
                        </div>
                    </div>
                }
                
                @if (string.IsNullOrEmpty(Model.InputText) && string.IsNullOrEmpty(Model.ResultText) && string.IsNullOrEmpty(Model.FileUrl))
                {
                    <div class="alert alert-warning">
                        @Localizer["No input/output data available for this operation."]
                    </div>
                }
            </div>
        </div>
    </div>
</div>

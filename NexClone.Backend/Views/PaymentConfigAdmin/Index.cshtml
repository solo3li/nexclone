@model IEnumerable<NexClone.Backend.Core.Entities.PaymentGatewayConfig>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

<div class="bx--grid" style="padding-left: 0;">
    <div class="bx--row" style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center;">
        <h2 style="margin: 0; font-weight: 400; font-size: 1.5rem;">@ViewData["Title"]</h2>
        <a href="@Url.Action("Create")" class="bx--btn bx--btn--primary">
            Add Payment Gateway
            <svg focusable="false" preserveAspectRatio="xMidYMid meet" style="will-change: transform;" xmlns="http://www.w3.org/2000/svg" class="bx--btn__icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M9 7L9 3 7 3 7 7 3 7 3 9 7 9 7 13 9 13 9 9 13 9 13 7z"></path></svg>
        </a>
    </div>

    <div class="bx--row">
        <div class="bx--col">
            <div class="bx--data-table-container">
                <table class="bx--data-table bx--data-table--zebra">
                    <thead>
                        <tr>
                            <th><span class="bx--table-header-label">@Localizer["Provider Name"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Status"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Last Updated"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.ProviderName</strong></td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span style="color: #24a148; font-weight: 600;">@Localizer["Active"]</span>
                                    }
                                    else
                                    {
                                        <span style="color: #da1e28;">@Localizer["Inactive"]</span>
                                    }
                                </td>
                                <td>@item.UpdatedAt.ToString("g")</td>
                                <td>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <a href="@Url.Action("Edit", new { id = item.Id })" class="bx--btn bx--btn--sm bx--btn--ghost">@Localizer["Edit"]</a>
                                        <form action="@Url.Action("Delete", new { id = item.Id })" method="post" data-confirm="Are you sure you want to delete this Payment Gateway Configuration?">
                                            <button type="submit" class="bx--btn bx--btn--sm bx--btn--danger">@Localizer["Delete"]</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.Any())
                {
                    <div style="text-align: center; padding: 2rem; color: #525252; background: #ffffff; border-bottom: 1px solid #e0e0e0;">
                        @Localizer["No Payment Gateways found. Add Paymob or PayPal to start accepting payments."]
                    </div>
                }
            </div>
        </div>
    </div>

    @* Webhook URLs Reference Card *@

    <div class="bx--row" style="margin-top: 2rem;">
        <div class="bx--col">
            <div style="background: #f4f4f4; border: 1px solid #e0e0e0; border-left: 4px solid #0f62fe; padding: 1.5rem; border-radius: 4px;">
                <h4 style="margin: 0 0 1rem 0; font-size: 1rem; font-weight: 600; color: #161616;">
                    🔗 Webhook URLs — Add these in your payment provider dashboard
                </h4>
                <p style="margin: 0 0 1rem 0; font-size: 0.875rem; color: #525252;">
                    These URLs must be configured in your payment provider's dashboard to receive payment notifications.
                </p>

                @{
                    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
                    var paymobWebhook = $"{baseUrl}/api/webhooks/paymob";
                    var paypalWebhook = $"{baseUrl}/api/webhooks/paypal";
                }

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-size: 0.75rem; font-weight: 600; color: #393939; margin-bottom: 0.25rem; text-transform: uppercase; letter-spacing: 0.05em;">
                        Paymob — Transaction Callback URL
                    </label>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <input id="paymob-webhook-url"
                               type="text"
                               readonly
                               value="@paymobWebhook"
                               style="flex: 1; padding: 0.5rem 0.75rem; font-family: 'IBM Plex Mono', monospace; font-size: 0.875rem; background: #ffffff; border: 1px solid #e0e0e0; border-radius: 4px; color: #161616; cursor: text;" />
                        <button type="button"
                                onclick="copyToClipboard('paymob-webhook-url', this)"
                                style="padding: 0.5rem 1rem; background: #0f62fe; color: #ffffff; border: none; border-radius: 4px; font-size: 0.875rem; cursor: pointer; white-space: nowrap; transition: background 0.2s;">
                            Copy
                        </button>
                    </div>
                </div>

                <div>
                    <label style="display: block; font-size: 0.75rem; font-weight: 600; color: #393939; margin-bottom: 0.25rem; text-transform: uppercase; letter-spacing: 0.05em;">
                        PayPal — Webhook URL
                    </label>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <input id="paypal-webhook-url"
                               type="text"
                               readonly
                               value="@paypalWebhook"
                               style="flex: 1; padding: 0.5rem 0.75rem; font-family: 'IBM Plex Mono', monospace; font-size: 0.875rem; background: #ffffff; border: 1px solid #e0e0e0; border-radius: 4px; color: #161616; cursor: text;" />
                        <button type="button"
                                onclick="copyToClipboard('paypal-webhook-url', this)"
                                style="padding: 0.5rem 1rem; background: #0f62fe; color: #ffffff; border: none; border-radius: 4px; font-size: 0.875rem; cursor: pointer; white-space: nowrap; transition: background 0.2s;">
                            Copy
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function copyToClipboard(inputId, btn) {
        const input = document.getElementById(inputId);
        navigator.clipboard.writeText(input.value).then(() => {
            const original = btn.textContent;
            btn.textContent = '✓ Copied!';
            btn.style.background = '#24a148';
            setTimeout(() => {
                btn.textContent = original;
                btn.style.background = '#0f62fe';
            }, 2000);
        }).catch(() => {
            input.select();
            document.execCommand('copy');
        });
    }
</script>


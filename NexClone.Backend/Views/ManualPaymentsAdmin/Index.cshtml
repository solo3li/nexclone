@model IEnumerable<NexClone.Backend.Core.Entities.Payment>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

@{
    ViewData["Title"] = "Pending Manual Payments";
}

<div class="bx--data-table-container">
    <div class="bx--data-table-header">
        <h4 class="bx--data-table-header__title">@ViewData["Title"]</h4>
        <p class="bx--data-table-header__description">@Localizer["Review and approve or reject manual bank/wallet transfers."]</p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-3">@Localizer["No pending payments at this time."]</div>
    }
    else
    {
        <table class="bx--data-table">
            <thead>
                <tr>
                    <th>@Localizer["User Email"]</th>
                    <th>@Localizer["Plan"]</th>
                    <th>@Localizer["Amount"]</th>
                    <th>@Localizer["Date"]</th>
                    <th>@Localizer["Receipt"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in Model)
                {
                    <tr>
                        <td>@payment.User?.Email</td>
                        <td>@payment.Plan?.Name</td>
                        <td>@payment.Amount @payment.Currency</td>
                        <td>@payment.CreatedAt.ToString("g")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(payment.ReceiptUrl))
                            {
                                <span class="bx--tag bx--tag--green">@Localizer["Has Screenshot"]</span>
                            }
                            else
                            {
                                <span class="bx--tag bx--tag--gray">@Localizer["No Screenshot"]</span>
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("Details", new { id = payment.Id })" class="bx--btn bx--btn--sm bx--btn--secondary">
                                <i class='bx bx-detail'></i> Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer
@{
    ViewData["Title"] = "Create New User";
}

<div class="bx--grid bx--grid--full-width">
    <div class="bx--row">
        <div class="bx--col">
            <h1 class="bx--type-productive-heading-05" style="margin-bottom: 2rem;">@Localizer["Create New User"]</h1>
        </div>
    </div>
    
    <div class="bx--row">
        <div class="bx--col-lg-8">
            <div style="background: #ffffff; padding: 2rem; border: 1px solid #e0e0e0;">
                <form method="post" action="@Url.Action("Create")">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="bx--form-requirement"></div>

                    <div class="bx--form-item" style="margin-bottom: 1.5rem;">
                        <label for="fullName" class="bx--label">@Localizer["Full Name"]</label>
                        <input id="fullName" name="fullName" type="text" class="bx--text-input" placeholder="Enter user's full name" required>
                    </div>

                    <div class="bx--form-item" style="margin-bottom: 1.5rem;">
                        <label for="email" class="bx--label">@Localizer["Email Address"]</label>
                        <input id="email" name="email" type="email" class="bx--text-input" placeholder="Enter email address" required>
                    </div>

                    <div class="bx--form-item" style="margin-bottom: 2rem;">
                        <label for="password" class="bx--label">@Localizer["Password"]</label>
                        <input id="password" name="password" type="password" class="bx--text-input" placeholder="Enter initial password" required>
                    </div>

                    <div class="bx--form-item" style="margin-bottom: 1rem;">
                        <div class="bx--checkbox-wrapper">
                            <input name="isStaff" value="true" type="checkbox" class="bx--checkbox" id="isStaffCheckbox">
                            <label for="isStaffCheckbox" class="bx--checkbox-label">@Localizer["Is Admin / Staff Member"]</label>
                        </div>
                    </div>

                    <div class="bx--form-item" style="margin-bottom: 2rem;">
                        <div class="bx--checkbox-wrapper">
                            <input name="isSuperAdmin" value="true" type="checkbox" class="bx--checkbox" id="isSuperAdminCheckbox">
                            <label for="isSuperAdminCheckbox" class="bx--checkbox-label">@Localizer["Is Super Admin (Has access to all sections)"]</label>
                        </div>
                    </div>

                    <div class="bx--form-item" style="margin-bottom: 2rem;">
                        <label class="bx--label">@Localizer["Visible Admin Sections"]</label>
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; margin-top: 1rem;">
                            @foreach (var sec in new Dictionary<string, string> {
                                {"/Users", "Users Management"},
                                {"/Subscriptions", "Subscriptions"},
                                {"/PlansAdmin", "Pricing & Plans"},
                                {"/WalletTypesAdmin", "Wallet Types"},
                                {"/ToolConfigAdmin", "Tool Settings"},
                                {"/SettingsAdmin", "Global Settings"},
                                {"/CustomPagesAdmin", "Custom Pages"},
                                {"/SocialLinksAdmin", "Communication Links"},
                                {"/BlogAdmin", "Blog Posts"},
                                {"/TicketsAdmin", "Support Tickets"},
                                {"/HistoryAdmin", "Operations History"},
                                {"/SystemUpdatesAdmin", "System Updates"},
                                {"/LogsAdmin", "System Logs"},
                                {"/Voices", "AI Voices"},
                                {"/PaymentConfigAdmin", "Payment Gateways"},
                                {"/ApiConfigAdmin", "API Keys"},
                                {"/MailingAdmin", "Mailing & Emails"},
                                {"/ManualPaymentsAdmin", "Pending Payments"},
                                {"/ManualPaymentMethodsAdmin", "Payment Methods"}
                            })
                            {
                                <div class="bx--checkbox-wrapper">
                                    <input type="checkbox" class="bx--checkbox" id="sec_@sec.Key.Replace("/","")" name="visibleSections" value="@sec.Key">
                                    <label for="sec_@sec.Key.Replace("/","")" class="bx--checkbox-label">@Localizer[sec.Value]</label>
                                </div>
                            }
                        </div>
                    </div>

                    <div style="display: flex; gap: 1rem;">
                        <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Create User"]</button>
                        <a href="@Url.Action("Index")" class="bx--btn bx--btn--secondary">@Localizer["Cancel"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@model NexClone.Backend.Core.Entities.ApplicationUser
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

@{
    ViewData["Title"] = "User Details";
    var currentSub = Model.Subscriptions?.FirstOrDefault(s => s.Status != null && s.Status.ToLower() == "active");
}

<div class="bx--grid bx--grid--full-width">
    <div class="bx--row" style="margin-bottom: 2rem;">
        <div class="bx--col">
            @if (TempData["Success"] != null)
            {
                <div class="bx--inline-notification bx--inline-notification--success" role="alert" style="margin-bottom: 1rem; width: 100%; max-width: none;">
                    <div class="bx--inline-notification__details">
                        <div class="bx--inline-notification__text-wrapper">
                            <p class="bx--inline-notification__title">@Localizer["Success:"]</p>
                            <p class="bx--inline-notification__subtitle">@TempData["Success"]</p>
                        </div>
                    </div>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="bx--inline-notification bx--inline-notification--error" role="alert" style="margin-bottom: 1rem; width: 100%; max-width: none;">
                    <div class="bx--inline-notification__details">
                        <div class="bx--inline-notification__text-wrapper">
                            <p class="bx--inline-notification__title">@Localizer["Error:"]</p>
                            <p class="bx--inline-notification__subtitle">@TempData["Error"]</p>
                        </div>
                    </div>
                </div>
            }
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <h1 class="bx--type-productive-heading-05">User Details: @Model.Email</h1>
                <div style="display: flex; gap: 1rem;">
                    <a href="@Url.Action("Edit", new { id = Model.Id })" class="bx--btn bx--btn--primary">@Localizer["Edit User"]</a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Are you sure you want to delete this user? This action cannot be undone." style="margin: 0;">
                        <button type="submit" class="bx--btn bx--btn--danger">@Localizer["Delete User"]</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="bx--row">
        <div class="bx--col-lg-8" style="margin-bottom: 2rem;">
            <!-- User Information Card -->
            <div style="background: #f4f4f4; padding: 2rem; border: 1px solid #e0e0e0;">
                <h3 class="bx--type-productive-heading-03" style="margin-bottom: 1.5rem; margin-top: 0;">@Localizer["Profile Information"]</h3>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 2rem;">
                    <div><strong>Name:</strong> @(string.IsNullOrEmpty(Model.FullName) ? "N/A" : Model.FullName)</div>
                    <div><strong>Email:</strong> @Model.Email</div>
                    <div><strong>Phone:</strong> @(string.IsNullOrEmpty(Model.PhoneNumber) ? "N/A" : Model.PhoneNumber)</div>
                    <div><strong>Country:</strong> @(string.IsNullOrEmpty(Model.Country) ? "N/A" : Model.Country)</div>
                    <div><strong>Joined:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy")</div>
                    <div><strong>Available Credits:</strong> @Model.AvailableCredits</div>
                    <div>
                        <strong>Status:</strong> 
                        @if (Model.EmailConfirmed || Model.IsVerified)
                        {
                            <span class="bx--tag bx--tag--green">@Localizer["Verified"]</span>
                        }
                        else
                        {
                            <span class="bx--tag bx--tag--red">@Localizer["Unverified"]</span>
                        }
                    </div>
                    <div style="grid-column: span 2;">
                        <strong>Current Plan:</strong> 
                        @if (currentSub?.Plan != null)
                        {
                            <span class="bx--tag bx--tag--green" style="margin-bottom: 0.5rem;">@currentSub.Plan.Name</span>
                            <div style="background: #ffffff; padding: 1rem; border: 1px solid #e0e0e0; border-radius: 4px; display: inline-block; margin-top: 0.5rem; width: 100%;">
                                <div style="display: flex; justify-content: space-between; gap: 2rem;">
                                    <div>
                                        <strong style="color: #525252; font-size: 0.875rem;">Started On:</strong><br/>
                                        <span>@currentSub.StartDate.ToString("MMM dd, yyyy HH:mm")</span>
                                    </div>
                                    <div>
                                        <strong style="color: #525252; font-size: 0.875rem;">Expires On:</strong><br/>
                                        <span>@currentSub.EndDate.ToString("MMM dd, yyyy HH:mm")</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="bx--tag bx--tag--gray">@Localizer["None"]</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Change Password Section -->
            <div style="background: #f4f4f4; padding: 2rem; border: 1px solid #e0e0e0; margin-top: 2rem;">
                <h3 class="bx--type-productive-heading-03" style="margin-bottom: 1.5rem; margin-top: 0;">@Localizer["Change Password"]</h3>
                
                <form asp-action="ChangePassword" method="post">
                    <input type="hidden" name="userId" value="@Model.Id" />
                    
                    <div class="bx--form-item" style="margin-bottom: 1rem;">
                        <label for="newPassword" class="bx--label">@Localizer["New Password"]</label>
                        <div class="bx--text-input__field-wrapper">
                            <input id="newPassword" type="password" class="bx--text-input" name="newPassword" required minlength="6" placeholder="Enter new password...">
                        </div>
                    </div>

                    <div>
                        <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Change Password"]</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="bx--col-lg-8">
            <!-- Extend Subscription Section -->
            <div style="background: #f4f4f4; padding: 2rem; border: 1px solid #e0e0e0; margin-bottom: 2rem;">
                <h3 class="bx--type-productive-heading-03" style="margin-bottom: 1.5rem; margin-top: 0;">@Localizer["Extend Active Subscription"]</h3>
                <form asp-action="ExtendSubscription" method="post" style="display: flex; gap: 1rem; align-items: flex-end;">
                    <input type="hidden" name="userId" value="@Model.Id" />
                    <div class="bx--form-item">
                        <label for="extraDays" class="bx--label">@Localizer["Extra Days"]</label>
                        <div class="bx--text-input__field-wrapper">
                            <input id="extraDays" type="number" class="bx--text-input" name="extraDays" required min="1" placeholder="e.g. 10">
                        </div>
                    </div>
                    <div>
                        <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Extend"]</button>
                    </div>
                </form>
            </div>
            <!-- User Wallets Section -->
            <div style="background: #f4f4f4; padding: 2rem; border: 1px solid #e0e0e0; margin-bottom: 2rem;">
                <h3 class="bx--type-productive-heading-03" style="margin-bottom: 1.5rem; margin-top: 0;">@Localizer["User Wallets & Balances"]</h3>
                
                <div style="display: grid; grid-template-columns: 1fr; gap: 1rem;">
                    <!-- Standard Credits -->
                    <div style="background: #ffffff; padding: 1.5rem; border: 1px solid #e0e0e0; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <strong style="font-size: 1.1rem; color: #161616;">Standard Credits</strong>
                            <p style="font-size: 1.25rem; font-weight: bold; color: #0f62fe; margin-top: 0.5rem;">@Model.StandardCredits.ToString("0.00") <span style="font-size: 0.875rem; font-weight: normal; color: #525252;">Credits</span></p>
                        </div>
                        <form asp-action="AddCreditAmount" method="post" style="display: flex; gap: 0.5rem; align-items: flex-end; margin: 0;">
                            <input type="hidden" name="userId" value="@Model.Id" />
                            <input type="hidden" name="creditType" value="Standard" />
                            <div class="bx--form-item">
                                <div class="bx--text-input__field-wrapper">
                                    <input type="number" class="bx--text-input" name="amount" required step="0.01" placeholder="+ or - amount" style="width: 120px;">
                                </div>
                            </div>
                            <button type="submit" class="bx--btn bx--btn--primary bx--btn--sm">@Localizer["Add/Remove"]</button>
                        </form>
                    </div>

                    <!-- Premium Credits -->
                    <div style="background: #ffffff; padding: 1.5rem; border: 1px solid #e0e0e0; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <strong style="font-size: 1.1rem; color: #161616;">Premium Credits</strong>
                            <p style="font-size: 1.25rem; font-weight: bold; color: #0f62fe; margin-top: 0.5rem;">@Model.PremiumCredits.ToString("0.00") <span style="font-size: 0.875rem; font-weight: normal; color: #525252;">Credits</span></p>
                        </div>
                        <form asp-action="AddCreditAmount" method="post" style="display: flex; gap: 0.5rem; align-items: flex-end; margin: 0;">
                            <input type="hidden" name="userId" value="@Model.Id" />
                            <input type="hidden" name="creditType" value="Premium" />
                            <div class="bx--form-item">
                                <div class="bx--text-input__field-wrapper">
                                    <input type="number" class="bx--text-input" name="amount" required step="0.01" placeholder="+ or - amount" style="width: 120px;">
                                </div>
                            </div>
                            <button type="submit" class="bx--btn bx--btn--primary bx--btn--sm">@Localizer["Add/Remove"]</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Assign Plan Section -->
            <div style="background: #f4f4f4; padding: 2rem; border: 1px solid #e0e0e0; height: 100%;">
                <h3 class="bx--type-productive-heading-03" style="margin-bottom: 1.5rem; margin-top: 0;">@Localizer["Assign New Plan"]</h3>
                
                <form asp-action="AssignPlan" method="post">
                    <input type="hidden" name="userId" value="@Model.Id" />
                    
                    <div class="bx--form-item" style="margin-bottom: 2rem;">
                        <label for="planId" class="bx--label">@Localizer["Select a Plan (This will add a new active plan alongside existing ones)"]</label>
                        <div class="bx--select">
                            <select id="planId" name="planId" class="bx--select-input" required>
                                <option value="" disabled selected hidden>Choose a new plan...</option>
                                @if (ViewBag.Plans != null)
                                {
                                    foreach (var item in (SelectList)ViewBag.Plans)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                            <svg focusable="false" preserveAspectRatio="xMidYMid meet" style="will-change: transform;" xmlns="http://www.w3.org/2000/svg" class="bx--select__arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 11L3 6 3.7 5.3 8 9.6 12.3 5.3 13 6z"></path></svg>
                        </div>
                    </div>

                    <div style="display: flex; gap: 1rem;">
                        <a href="@Url.Action("Index")" class="bx--btn bx--btn--secondary">@Localizer["Back to Users"]</a>
                        <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Assign Selected Plan"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Subscriptions History Section -->
    <div class="bx--row" style="margin-top: 2rem;">
        <div class="bx--col">
            <h3 class="bx--type-productive-heading-04" style="margin-bottom: 1rem;">@Localizer["Subscriptions History"]</h3>
            <div class="bx--data-table-container">
                <table class="bx--data-table">
                    <thead>
                        <tr>
                            <th><span class="bx--table-header-label">@Localizer["Plan Name"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Status"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Start Date"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["End Date"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Duration (Months)"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Payment Info"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Subscriptions != null && Model.Subscriptions.Any())
                        {
                            foreach (var sub in Model.Subscriptions.OrderByDescending(s => s.CreatedAt))
                            {
                                int durationMonths = (int)Math.Ceiling((sub.EndDate - sub.StartDate).TotalDays / 30.0);
                                var paymentInfo = sub.Payments != null && sub.Payments.Any() 
                                    ? string.Join(", ", sub.Payments.Select(p => $"{p.Amount} {p.Currency} via {p.Method ?? "Gateway"} ({p.Status})")) 
                                    : "No Payment (Manual/Free)";
                                <tr>
                                    <td>@(sub.Plan?.Name ?? "Unknown Plan")</td>
                                    <td>
                                        @if (sub.Status == "active") { <span class="bx--tag bx--tag--green">Active</span> }
                                        else if (sub.Status == "freeze") { <span class="bx--tag bx--tag--yellow">Freeze</span> }
                                        else { <span class="bx--tag bx--tag--red">@sub.Status</span> }
                                    </td>
                                    <td>@sub.StartDate.ToString("MMM dd, yyyy")</td>
                                    <td>@sub.EndDate.ToString("MMM dd, yyyy")</td>
                                    <td>@durationMonths</td>
                                    <td><span style="font-size: 0.875rem;">@paymentInfo</span></td>
                                    <td>
                                        <div style="display: flex; gap: 0.5rem;">
                                            <button type="button" class="bx--btn bx--btn--sm bx--btn--secondary edit-sub-btn" data-sub-id="@sub.Id" data-current-end="@sub.EndDate.ToString("yyyy-MM-ddTHH:mm")">@Localizer["Edit Date"]</button>
                                            <form action="/Subscriptions/Delete" method="post" data-confirm="@Localizer["Are you sure you want to delete this subscription?"]" style="margin: 0;">
                                                <input type="hidden" name="id" value="@sub.Id" />
                                                <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Users", new { id = Model.Id })" />
                                                <button type="submit" class="bx--btn bx--btn--sm bx--btn--danger">@Localizer["Delete"]</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" style="text-align: center;">@Localizer["No subscriptions found for this user."]</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.edit-sub-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                var subId = this.getAttribute('data-sub-id');
                var currentEnd = this.getAttribute('data-current-end');
                var returnUrl = '@Url.Action("Details", "Users", new { id = Model.Id })';
                
                Swal.fire({
                    title: '@Localizer["Edit Subscription End Date"]',
                    html: '<input type="datetime-local" id="swal-input-date" class="swal2-input" value="' + currentEnd + '">',
                    showCancelButton: true,
                    confirmButtonText: '@Localizer["Save"]',
                    cancelButtonText: '@Localizer["Cancel"]',
                    preConfirm: () => {
                        var newDate = document.getElementById('swal-input-date').value;
                        if (!newDate) {
                            Swal.showValidationMessage('Date is required');
                        }
                        return newDate;
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        var form = document.createElement('form');
                        form.method = 'POST';
                        form.action = '/Subscriptions/UpdateEndDate';
                        
                        var inputId = document.createElement('input');
                        inputId.type = 'hidden';
                        inputId.name = 'id';
                        inputId.value = subId;
                        
                        var inputDate = document.createElement('input');
                        inputDate.type = 'hidden';
                        inputDate.name = 'newEndDate';
                        inputDate.value = result.value;
                        
                        var inputReturn = document.createElement('input');
                        inputReturn.type = 'hidden';
                        inputReturn.name = 'returnUrl';
                        inputReturn.value = returnUrl;
                        
                        form.appendChild(inputId);
                        form.appendChild(inputDate);
                        form.appendChild(inputReturn);
                        document.body.appendChild(form);
                        form.submit();
                    } else if (result.dismiss === Swal.DismissReason.cancel) {
                        Swal.fire({
                            title: '@Localizer["Cancelled"]',
                            text: '@Localizer["No changes were made."]',
                            icon: 'info',
                            timer: 1500,
                            showConfirmButton: false
                        });
                    }
                });
            });
        });
    });
    </script>

    <!-- Devices / Fingerprints Section -->
    <div class="bx--row" style="margin-top: 2rem;">
        <div class="bx--col">
            <h3 class="bx--type-productive-heading-04" style="margin-bottom: 1rem;">@Localizer["Registered Devices & Logins"]</h3>
            <div class="bx--data-table-container">
                <table class="bx--data-table">
                    <thead>
                        <tr>
                            <th><span class="bx--table-header-label">@Localizer["Date/Time"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["IP Address"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Fingerprint Hash"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["User Agent"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.Devices != null)
                        {
                            var devices = ViewBag.Devices as IEnumerable<NexClone.Backend.Core.Entities.DeviceFingerprint>;
                            if (devices != null && devices.Any())
                            {
                                foreach (var device in devices)
                                {
                                    <tr>
                                        <td>@device.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td>@device.IpAddress</td>
                                        <td><code style="background: #e5e5e5; padding: 2px 4px; border-radius: 4px;">@device.FingerprintHash</code></td>
                                        <td><span style="display: inline-block; max-width: 400px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@device.UserAgent">@device.UserAgent</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" style="text-align: center;">@Localizer["No device records found for this user."]</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@model NexClone.Backend.Core.Entities.ApplicationUser
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

@{
    ViewData["Title"] = "Edit User";
}

<div class="bx--grid bx--grid--full-width">
    <div class="bx--row" style="margin-bottom: 2rem;">
        <div class="bx--col" style="display: flex; justify-content: space-between; align-items: center;">
            <h1 class="bx--type-productive-heading-05">Edit User: @Model.Email</h1>
            <a href="@Url.Action("Details", new { id = Model.Id })" class="bx--btn bx--btn--secondary">
                @Localizer["Back to Details"]
            </a>
        </div>
    </div>

    <div class="bx--row">
        <div class="bx--col-lg-8">
            <div style="background: #f4f4f4; padding: 2rem; border: 1px solid #e0e0e0;">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="bx--form-item" style="margin-bottom: 1rem;">
                        <label asp-for="FullName" class="bx--label">@Localizer["Full Name"]</label>
                        <div class="bx--text-input__field-wrapper">
                            <input asp-for="FullName" class="bx--text-input" placeholder="e.g. John Doe">
                        </div>
                        <span asp-validation-for="FullName" class="bx--form-requirement"></span>
                    </div>

                    <div class="bx--form-item" style="margin-bottom: 1rem;">
                        <label asp-for="Email" class="bx--label">@Localizer["Email Address"]</label>
                        <div class="bx--text-input__field-wrapper">
                            <input asp-for="Email" type="email" class="bx--text-input" required>
                        </div>
                        <span asp-validation-for="Email" class="bx--form-requirement"></span>
                    </div>

                    <div class="bx--form-item" style="margin-bottom: 1rem;">
                        <label asp-for="PhoneNumber" class="bx--label">@Localizer["Phone Number"]</label>
                        <div class="bx--text-input__field-wrapper">
                            <input asp-for="PhoneNumber" class="bx--text-input" placeholder="e.g. +201000000000">
                        </div>
                        <span asp-validation-for="PhoneNumber" class="bx--form-requirement"></span>
                    </div>

                    <div class="bx--form-item" style="margin-bottom: 1rem;">
                        <label asp-for="Country" class="bx--label">@Localizer["Country"]</label>
                        <div class="bx--text-input__field-wrapper">
                            <input asp-for="Country" class="bx--text-input" placeholder="e.g. Egypt">
                        </div>
                        <span asp-validation-for="Country" class="bx--form-requirement"></span>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; background: #f4f4f4; padding: 1rem; border-radius: 4px;">
                        <div class="bx--form-item">
                            <label asp-for="StandardCredits" class="bx--label">@Localizer["Standard Credits"]</label>
                            <div class="bx--text-input__field-wrapper">
                                <input asp-for="StandardCredits" type="number" step="0.01" class="bx--text-input">
                            </div>
                        </div>
                        <div class="bx--form-item">
                            <label asp-for="PremiumCredits" class="bx--label">@Localizer["Premium Credits"]</label>
                            <div class="bx--text-input__field-wrapper">
                                <input asp-for="PremiumCredits" type="number" step="0.01" class="bx--text-input">
                            </div>
                        </div>
                    </div>

                    <div class="bx--form-item" style="margin-bottom: 1rem;">
                        <div class="bx--checkbox-wrapper">
                            <input asp-for="IsStaff" type="checkbox" class="bx--checkbox" id="isStaffCheckbox">
                            <label for="isStaffCheckbox" class="bx--checkbox-label">@Localizer["Is Admin / Staff Member"]</label>
                        </div>
                    </div>

                    <div class="bx--form-item" style="margin-bottom: 2rem;">
                        <div class="bx--checkbox-wrapper">
                            <input asp-for="IsSuperAdmin" type="checkbox" class="bx--checkbox" id="isSuperAdminCheckbox">
                            <label for="isSuperAdminCheckbox" class="bx--checkbox-label">@Localizer["Is Super Admin (Has access to all sections)"]</label>
                        </div>
                    </div>

                    <div class="bx--form-item" style="margin-bottom: 2rem;">
                        <label class="bx--label">@Localizer["Visible Admin Sections"]</label>
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; margin-top: 1rem;">
                            @foreach (var sec in new Dictionary<string, string> {
                                {"/Users", "Users Management"},
                                {"/Subscriptions", "Subscriptions"},
                                {"/PlansAdmin", "Pricing & Plans"},
                                {"/WalletTypesAdmin", "Wallet Types"},
                                {"/ToolConfigAdmin", "Tool Settings"},
                                {"/SettingsAdmin", "Global Settings"},
                                {"/CustomPagesAdmin", "Custom Pages"},
                                {"/SocialLinksAdmin", "Communication Links"},
                                {"/BlogAdmin", "Blog Posts"},
                                {"/TicketsAdmin", "Support Tickets"},
                                {"/HistoryAdmin", "Operations History"},
                                {"/SystemUpdatesAdmin", "System Updates"},
                                {"/LogsAdmin", "System Logs"},
                                {"/Voices", "AI Voices"},
                                {"/PaymentConfigAdmin", "Payment Gateways"},
                                {"/ApiConfigAdmin", "API Keys"},
                                {"/MailingAdmin", "Mailing & Emails"},
                                {"/ManualPaymentsAdmin", "Pending Payments"},
                                {"/ManualPaymentMethodsAdmin", "Payment Methods"}
                            })
                            {
                                bool isChecked = !string.IsNullOrEmpty(Model.VisibleAdminSections) && Model.VisibleAdminSections.Contains(sec.Key);
                                <div class="bx--checkbox-wrapper">
                                    <input type="checkbox" class="bx--checkbox" id="sec_@sec.Key.Replace("/","")" name="visibleSections" value="@sec.Key" @(isChecked ? "checked" : "")>
                                    <label for="sec_@sec.Key.Replace("/","")" class="bx--checkbox-label">@Localizer[sec.Value]</label>
                                </div>
                            }
                        </div>
                    </div>

                    <div style="display: flex; gap: 1rem;">
                        <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Save Changes"]</button>
                        <a href="@Url.Action("Details", new { id = Model.Id })" class="bx--btn bx--btn--secondary">@Localizer["Cancel"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

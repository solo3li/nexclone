@model IEnumerable<NexClone.Backend.Core.Entities.ApplicationUser>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

@{
    ViewData["Title"] = "Users Management";
}

<style>
    /* ── Page-level styles (scoped to Users Management) ── */
    .users-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 2.5rem;
        flex-wrap: wrap;
        gap: 1rem;
    }
    .users-header h1 {
        font-size: 1.9rem;
        font-weight: 800;
        background: linear-gradient(135deg, var(--admin-primary) 0%, #a855f7 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 0;
    }
    .users-header .btn-create {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, var(--admin-primary) 0%, #a855f7 100%);
        color: #fff;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 0.7rem 1.5rem;
        border-radius: 10px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        box-shadow: 0 4px 20px rgba(139,92,246,.4);
        transition: var(--trans-bounce);
        letter-spacing: 0.02em;
    }
    .users-header .btn-create:hover {
        transform: translateY(-3px) scale(1.03);
        box-shadow: 0 8px 30px rgba(139,92,246,.5);
    }

    /* Stats row */
    .users-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }
    .users-stat {
        background: var(--admin-surface);
        border: 1px solid var(--admin-border-light);
        border-radius: var(--admin-radius-lg);
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        box-shadow: var(--shadow-soft);
        transition: var(--trans-smooth);
    }
    .users-stat:hover { transform: translateY(-3px); box-shadow: var(--shadow-float); }
    .users-stat__icon {
        width: 52px; height: 52px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.6rem;
        flex-shrink: 0;
    }
    .users-stat__body {}
    .users-stat__num { font-size: 2rem; font-weight: 800; line-height: 1; }
    .users-stat__label { font-size: 0.8rem; color: var(--admin-text-secondary); margin-top: 4px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }

    /* Search / Filter card */
    .users-filter-card {
        background: var(--admin-surface);
        border: 1px solid var(--admin-border-light);
        border-radius: var(--admin-radius-lg);
        padding: 1.75rem;
        box-shadow: var(--shadow-soft);
        margin-bottom: 2rem;
    }
    .users-filter-card h5 {
        font-size: 1rem; font-weight: 700;
        color: var(--admin-text-primary);
        margin: 0 0 1.25rem 0;
        display: flex; align-items: center; gap: 0.5rem;
    }
    .users-filter-card h5 i { color: var(--admin-primary); font-size: 1.2rem; }
    .users-filter-row {
        display: flex; gap: 1.25rem; flex-wrap: wrap; align-items: flex-end;
    }
    .users-filter-row .bx--form-item { flex: 1; min-width: 220px; margin-bottom: 0 !important; }

    /* Table */
    .users-table-card {
        background: var(--admin-surface);
        border: 1px solid var(--admin-border-light);
        border-radius: var(--admin-radius-lg);
        box-shadow: var(--shadow-soft);
        overflow: hidden;
    }
    /* Scrollable table wrapper */
    .users-table-scroll { overflow-x: auto; width: 100%; }
    .users-table-card .table-header {
        padding: 1.5rem 1.75rem;
        border-bottom: 1px solid var(--admin-border-light);
        display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    }
    .users-table-card .table-header h4 {
        font-size: 1.1rem; font-weight: 700;
        color: var(--admin-text-primary);
        margin: 0;
        display: flex; align-items: center; gap: 0.5rem;
    }
    .users-table-card .table-header h4 i { color: var(--admin-primary); }
    .users-table-card .table-header p {
        font-size: 0.85rem; color: var(--admin-text-secondary); margin: 4px 0 0 0;
    }
    .users-table-card table { width: 100%; border-collapse: collapse; min-width: 900px; }
    .users-table-card thead tr {
        background: var(--admin-surface-2, rgba(139,92,246,.06));
        border-bottom: 2px solid var(--admin-border-light);
    }
    .users-table-card th {
        padding: 0.75rem 0.85rem;
        font-size: 0.72rem; font-weight: 800;
        text-transform: uppercase; letter-spacing: 0.06em;
        color: var(--admin-text-secondary);
        white-space: nowrap;
        text-align: left;
    }
    html[dir="rtl"] .users-table-card th { text-align: right; }
    .users-table-card tbody tr {
        border-bottom: 1px solid var(--admin-border-light);
        transition: background 0.2s ease;
    }
    .users-table-card tbody tr:last-child { border-bottom: none; }
    .users-table-card tbody tr:hover { background: rgba(139,92,246,.04); }
    .users-table-card td {
        padding: 0.75rem 0.85rem;
        font-size: 0.85rem;
        color: var(--admin-text-primary);
        vertical-align: middle;
        white-space: nowrap;
    }

    /* User avatar cell */
    .user-avatar-cell { display: flex; align-items: center; gap: 0.6rem; min-width: 160px; max-width: 220px; }
    .user-avatar {
        width: 34px; height: 34px; border-radius: 50%;
        background: linear-gradient(135deg, var(--admin-primary) 0%, #a855f7 100%);
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 0.8rem; color: #fff;
        flex-shrink: 0;
        box-shadow: 0 4px 12px rgba(139,92,246,.3);
    }
    .user-email { font-weight: 600; font-size: 0.82rem; color: var(--admin-text-primary); overflow: hidden; text-overflow: ellipsis; max-width: 170px; }
    .user-id { font-size: 0.68rem; color: var(--admin-text-secondary); margin-top: 1px; font-family: monospace; }

    /* Badges */
    .badge {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 12px; border-radius: 20px;
        font-size: 0.75rem; font-weight: 700; white-space: nowrap;
    }
    .badge-dot { width: 7px; height: 7px; border-radius: 50%; }
    .badge-green  { background: rgba(34,197,94,.12);  color: #16a34a; }
    .badge-green .badge-dot  { background: #22c55e; box-shadow: 0 0 5px #22c55e; }
    .badge-red    { background: rgba(239,68,68,.12);  color: #dc2626; }
    .badge-red .badge-dot    { background: #ef4444; box-shadow: 0 0 5px #ef4444; }
    .badge-purple { background: rgba(139,92,246,.12); color: #7c3aed; }
    .badge-purple .badge-dot { background: #8b5cf6; }
    .badge-blue   { background: rgba(59,130,246,.12); color: #2563eb; }
    .badge-blue .badge-dot   { background: #3b82f6; }
    .badge-gray   { background: rgba(107,114,128,.1); color: #6b7280; }
    .badge-gray .badge-dot   { background: #9ca3af; }
    .badge-orange { background: rgba(249,115,22,.12); color: #ea580c; }
    .badge-orange .badge-dot { background: #f97316; }

    /* Action buttons — icon-only with tooltip */
    .action-btns { display: flex; gap: 0.35rem; align-items: center; }
    .btn-action {
        display: inline-flex; align-items: center; justify-content: center;
        width: 32px; height: 32px; border-radius: 8px;
        font-size: 1rem;
        text-decoration: none; border: none; cursor: pointer;
        transition: var(--trans-smooth);
        position: relative;
    }
    /* Large submit buttons (filter form) */
    .btn-submit {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 10px 20px; border-radius: 10px;
        font-size: 0.85rem; font-weight: 700;
        white-space: nowrap;
        text-decoration: none; border: none; cursor: pointer;
        transition: var(--trans-smooth);
    }
    .btn-submit-primary { background: rgba(139,92,246,.1); color: var(--admin-primary); }
    .btn-submit-primary:hover { background: var(--admin-primary); color: #fff; transform: translateY(-2px); }
    .btn-submit-danger { background: rgba(239,68,68,.1); color: #ef4444; }
    .btn-submit-danger:hover { background: #ef4444; color: #fff; transform: translateY(-2px); }
    /* Tooltip */
    .btn-action[title]:hover::after {
        content: attr(title);
        position: absolute;
        bottom: calc(100% + 6px);
        left: 50%; transform: translateX(-50%);
        background: #1e293b; color: #fff;
        font-size: 0.7rem; font-weight: 600;
        padding: 4px 8px; border-radius: 6px;
        white-space: nowrap; pointer-events: none; z-index: 99;
    }
    .btn-action i { font-size: 1rem; }
    .btn-view   { background: rgba(139,92,246,.1); color: var(--admin-primary); }
    .btn-view:hover   { background: var(--admin-primary); color: #fff; transform: translateY(-2px); }
    .btn-edit   { background: rgba(59,130,246,.1); color: #3b82f6; }
    .btn-edit:hover   { background: #3b82f6; color: #fff; transform: translateY(-2px); }
    .btn-danger { background: rgba(239,68,68,.1); color: #ef4444; }
    .btn-danger:hover { background: #ef4444; color: #fff; transform: translateY(-2px); }
    .btn-wallet { background: rgba(16,185,129,.1); color: #059669; }
    .btn-wallet:hover { background: #059669; color: #fff; transform: translateY(-2px); }

    /* Credits display */
    .credits-display {
        display: flex; align-items: center; gap: 6px;
        font-weight: 700; font-size: 0.9rem;
        color: var(--admin-primary);
    }
    .credits-display i { font-size: 1rem; }

    /* Empty state */
    .empty-state { text-align: center; padding: 4rem 2rem; }
    .empty-state i { font-size: 4rem; color: var(--admin-text-secondary); opacity: 0.4; margin-bottom: 1rem; display: block; }
    .empty-state h3 { font-size: 1.2rem; font-weight: 700; color: var(--admin-text-secondary); margin: 0 0 0.5rem 0; }
    .empty-state p { font-size: 0.9rem; color: var(--admin-text-secondary); opacity: 0.8; }

    /* Pagination */
    .users-pagination {
        display: flex; align-items: center; justify-content: space-between;
        padding: 1.25rem 1.75rem;
        border-top: 1px solid var(--admin-border-light);
        flex-wrap: wrap; gap: 1rem;
    }
    .pagination-info { font-size: 0.85rem; color: var(--admin-text-secondary); font-weight: 600; }
    .pagination-btns { display: flex; gap: 0.4rem; align-items: center; }
    .pg-btn {
        display: inline-flex; align-items: center; justify-content: center;
        width: 36px; height: 36px; border-radius: 8px;
        font-size: 0.85rem; font-weight: 700;
        text-decoration: none; border: 1px solid var(--admin-border-light);
        color: var(--admin-text-secondary);
        background: transparent;
        cursor: pointer; transition: var(--trans-smooth);
    }
    .pg-btn:hover { background: var(--admin-primary); color: #fff; border-color: var(--admin-primary); transform: translateY(-1px); }
    .pg-btn.active { background: var(--admin-primary); color: #fff; border-color: var(--admin-primary); }
    .pg-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
    .pg-btn.pg-text { width: auto; padding: 0 0.75rem; }

    /* Wallets Modal */
    .wallets-modal-overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(15,23,42,.6); backdrop-filter: blur(6px);
        z-index: 99999;
        align-items: center; justify-content: center;
    }
    .wallets-modal-overlay.open { display: flex; }
    .wallets-modal {
        background: var(--admin-surface);
        border: 1px solid var(--admin-border-light);
        border-radius: 20px;
        box-shadow: 0 30px 80px rgba(0,0,0,.25);
        width: 90%; max-width: 480px;
        animation: modalIn .3s cubic-bezier(.34,1.56,.64,1);
        overflow: hidden;
    }
    @@keyframes modalIn {
        from { opacity: 0; transform: scale(.92) translateY(20px); }
        to   { opacity: 1; transform: scale(1) translateY(0); }
    }
    .wallets-modal-header {
        padding: 1.5rem 1.75rem;
        border-bottom: 1px solid var(--admin-border-light);
        display: flex; align-items: center; justify-content: space-between;
    }
    .wallets-modal-header h3 { font-size: 1.1rem; font-weight: 700; margin: 0; display: flex; align-items: center; gap: 0.5rem; }
    .wallets-modal-header h3 i { color: #059669; }
    .modal-close-btn {
        width: 34px; height: 34px; border-radius: 8px;
        background: rgba(107,114,128,.1); border: none; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem; color: var(--admin-text-secondary);
        transition: var(--trans-smooth);
    }
    .modal-close-btn:hover { background: rgba(239,68,68,.1); color: #ef4444; transform: rotate(90deg); }
    .wallets-modal-body { padding: 1.5rem 1.75rem; }
    .wallet-item {
        display: flex; align-items: center; justify-content: space-between;
        padding: 1rem 1.25rem;
        background: var(--admin-bg, #f8fafc);
        border-radius: 12px;
        margin-bottom: 0.75rem;
        border: 1px solid var(--admin-border-light);
    }
    .wallet-item:last-child { margin-bottom: 0; }
    .wallet-name { display: flex; align-items: center; gap: 0.6rem; font-weight: 600; font-size: 0.9rem; }
    .wallet-name i { font-size: 1.2rem; color: #059669; }
    .wallet-balance { font-size: 1.1rem; font-weight: 800; color: var(--admin-primary); }

    @@media (max-width: 1024px) {
        .users-stats { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width: 768px) {
        .users-stats { grid-template-columns: 1fr; }
        .users-filter-row { flex-direction: column; }
        .users-header { flex-direction: column; align-items: flex-start; }
    }
</style>

<!-- ─── Page Header ─── -->
<div class="users-header">
    <div>
        <h1><i class='bx bx-group' style="font-size:1.9rem; -webkit-text-fill-color: unset; background: none; color: var(--admin-primary);"></i> @Localizer["Users Management"]</h1>
        <p style="margin: 6px 0 0; color: var(--admin-text-secondary); font-size: 0.9rem;">@Localizer["Manage all registered users and their permissions."]</p>
    </div>
    <a href="@Url.Action("Create")" class="btn-create">
        <i class='bx bx-user-plus'></i>
        Create User
    </a>
</div>

<!-- ─── Stats Row ─── -->
<div class="users-stats">
    <div class="users-stat">
        <div class="users-stat__icon" style="background: rgba(139,92,246,.15);">
            <i class='bx bx-group' style="color: var(--admin-primary);"></i>
        </div>
        <div class="users-stat__body">
            <div class="users-stat__num" style="color: var(--admin-primary);">@ViewBag.TotalUsers</div>
            <div class="users-stat__label">@Localizer["Total Users"]</div>
        </div>
    </div>
    <div class="users-stat">
        <div class="users-stat__icon" style="background: rgba(34,197,94,.12);">
            <i class='bx bx-check-shield' style="color: #22c55e;"></i>
        </div>
        <div class="users-stat__body">
            <div class="users-stat__num" style="color: #22c55e;">@ViewBag.VerifiedUsers</div>
            <div class="users-stat__label">@Localizer["Verified"]</div>
        </div>
    </div>
    <div class="users-stat">
        <div class="users-stat__icon" style="background: rgba(239,68,68,.12);">
            <i class='bx bx-x-circle' style="color: #ef4444;"></i>
        </div>
        <div class="users-stat__body">
            <div class="users-stat__num" style="color: #ef4444;">@ViewBag.UnverifiedUsers</div>
            <div class="users-stat__label">@Localizer["Unverified"]</div>
        </div>
    </div>
    <div class="users-stat">
        <div class="users-stat__icon" style="background: rgba(249,115,22,.12);">
            <i class='bx bx-crown' style="color: #f97316;"></i>
        </div>
        <div class="users-stat__body">
            <div class="users-stat__num" style="color: #f97316;">@ViewBag.AdminUsers</div>
            <div class="users-stat__label">@Localizer["Admins"]</div>
        </div>
    </div>
</div>

<!-- ─── Filters Card ─── -->
<div class="users-filter-card">
    <h5><i class='bx bx-filter-alt'></i> @Localizer["Search & Filter"]</h5>
    <form method="get" action="@Url.Action("Index")">
        <div class="users-filter-row">
            <div class="bx--form-item">
                <label for="searchString" class="bx--label">@Localizer["Search User (Email, Phone, ID)"]</label>
                <div class="bx--text-input__field-wrapper">
                    <input id="searchString" type="text" class="bx--text-input" name="searchString"
                           value="@ViewBag.CurrentSearch" placeholder="Enter email, phone, or ID...">
                </div>
            </div>
            <div class="bx--form-item">
                <label for="planId" class="bx--label">@Localizer["Filter by Plan"]</label>
                <div class="bx--select">
                    <select id="planId" name="planId" class="bx--select-input" asp-items="ViewBag.Plans">
                        <option value="">All Plans</option>
                    </select>
                </div>
            </div>
            <div style="display: flex; gap: 0.5rem; align-items: flex-end; flex-shrink: 0;">
                <button type="submit" class="btn-submit btn-submit-primary">
                    <i class='bx bx-search'></i> @Localizer["Search & Filter"]
                </button>
                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string) || ViewBag.CurrentPlanId != null)
                {
                    <a href="@Url.Action("Index")" class="btn-submit btn-submit-danger">
                        <i class='bx bx-x'></i> @Localizer["Clear"]
                    </a>
                }
            </div>
        </div>
    </form>
</div>

<!-- ─── Table Card ─── -->
<div class="users-table-card">
    <div class="table-header">
        <div>
            <h4><i class='bx bx-list-ul'></i> @Localizer["All Registered Users"]</h4>
            <p>@Localizer["Manage users and their status"]</p>
        </div>
        <div class="badge badge-purple" style="font-size: 0.85rem; padding: 6px 16px;">
            @Model.Count() @Localizer["users shown"]
        </div>
    </div>

    <div class="users-table-scroll">
    <table>
        <thead>
            <tr>
                <th>@Localizer["User"]</th>
                <th>@Localizer["Phone"]</th>
                <th>@Localizer["Status"]</th>
                <th>@Localizer["Country"]</th>
                <th>@Localizer["Credits"]</th>
                <th>@Localizer["Current Plan"]</th>
                <th>@Localizer["Role"]</th>
                <th>@Localizer["Joined"]</th>
                <th>@Localizer["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9">
                        <div class="empty-state">
                            <i class='bx bx-user-x'></i>
                            <h3>@Localizer["No users found in the database."]</h3>
                            <p>Try adjusting your search or filter criteria.</p>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                foreach (var user in Model)
                {
                    var currentSub = user.Subscriptions?.FirstOrDefault(s => s.Status == "active");
                    var initials = string.IsNullOrEmpty(user.Email) ? "?" : user.Email.Substring(0, 1).ToUpper();
                    <tr>
                        <td>
                            <div class="user-avatar-cell">
                                <div class="user-avatar">@initials</div>
                                <div>
                                    <div class="user-email">@user.Email</div>
                                    <div class="user-id">#@user.Id.ToString().Substring(0, 8)…</div>
                                </div>
                            </div>
                        </td>
                        <td>@(string.IsNullOrEmpty(user.PhoneNumber) ? "—" : user.PhoneNumber)</td>
                        <td>
                            @if (user.EmailConfirmed || user.IsVerified)
                            {
                                <span class="badge badge-green">
                                    <span class="badge-dot"></span>@Localizer["Verified"]
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-red">
                                    <span class="badge-dot"></span>@Localizer["Unverified"]
                                </span>
                            }
                        </td>
                        <td>@(string.IsNullOrEmpty(user.Country) ? "—" : user.Country)</td>
                        <td>
                            @{
                                var walletsJson = System.Text.Json.JsonSerializer.Serialize(user.Wallets.Select(w => new { Name = w.WalletType.Name, Balance = w.Balance }));
                            }
                        <button class="btn-action btn-wallet" onclick="showWalletsModal(this)" data-wallets="@walletsJson" title="View Balances">
                                <i class='bx bx-wallet'></i>
                            </button>
                        </td>
                        <td>
                            @if (currentSub?.Plan != null)
                            {
                                <span class="badge badge-purple">
                                    <i class='bx bx-crown' style="font-size: 0.9rem;"></i>@currentSub.Plan.Name
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-gray">@Localizer["None"]</span>
                            }
                        </td>
                        <td>
                            @if (user.IsStaff)
                            {
                                <span class="badge badge-orange">
                                    <i class='bx bx-shield' style="font-size: 0.9rem;"></i>@Localizer["Admin"]
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-blue">
                                    <span class="badge-dot"></span>@Localizer["User"]
                                </span>
                            }
                        </td>
                        <td>
                            <div style="font-weight: 600; font-size: 0.87rem;">@user.CreatedAt.ToString("MMM dd, yyyy")</div>
                        </td>
                        <td>
                            <div class="action-btns">
                                <a href="@Url.Action("Details", new { id = user.Id })" class="btn-action btn-view" title="@Localizer["View"]">
                                    <i class='bx bx-show'></i>
                                </a>
                                <a href="@Url.Action("Edit", new { id = user.Id })" class="btn-action btn-edit" title="@Localizer["Edit"]">
                                    <i class='bx bx-edit'></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@user.Id" method="post"
                                      data-confirm="Are you sure you want to delete this user? This action cannot be undone."
                                      style="margin: 0;">
                                    <button type="submit" class="btn-action btn-danger" title="@Localizer["Delete"]">
                                        <i class='bx bx-trash'></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div><!-- end users-table-scroll -->

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="users-pagination">
            <div class="pagination-info">
                Page <strong>@ViewBag.PageNumber</strong> of <strong>@ViewBag.TotalPages</strong>
            </div>
            <div class="pagination-btns">
                @if (ViewBag.PageNumber > 1)
                {
                    <a href="@Url.Action("Index", new { searchString = ViewBag.CurrentSearch, planId = ViewBag.CurrentPlanId, pageNumber = ViewBag.PageNumber - 1 })" class="pg-btn pg-text">
                        <i class='bx bx-chevron-left'></i> @Localizer["Previous"]
                    </a>
                }
                else
                {
                    <button class="pg-btn pg-text" disabled><i class='bx bx-chevron-left'></i> @Localizer["Previous"]</button>
                }

                @{
                    int startPage = Math.Max(1, ViewBag.PageNumber - 2);
                    int endPage   = Math.Min(ViewBag.TotalPages, ViewBag.PageNumber + 2);
                }
                @if (startPage > 1)
                {
                    <a href="@Url.Action("Index", new { searchString = ViewBag.CurrentSearch, planId = ViewBag.CurrentPlanId, pageNumber = 1 })" class="pg-btn">1</a>
                    @if (startPage > 2) { <span style="color:var(--admin-text-secondary);padding:0 4px;">…</span> }
                }
                @for (int i = startPage; i <= endPage; i++)
                {
                    if (i == ViewBag.PageNumber)
                    {
                        <button class="pg-btn active" disabled>@i</button>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", new { searchString = ViewBag.CurrentSearch, planId = ViewBag.CurrentPlanId, pageNumber = i })" class="pg-btn">@i</a>
                    }
                }
                @if (endPage < ViewBag.TotalPages)
                {
                    @if (endPage < ViewBag.TotalPages - 1) { <span style="color:var(--admin-text-secondary);padding:0 4px;">…</span> }
                    <a href="@Url.Action("Index", new { searchString = ViewBag.CurrentSearch, planId = ViewBag.CurrentPlanId, pageNumber = ViewBag.TotalPages })" class="pg-btn">@ViewBag.TotalPages</a>
                }

                @if (ViewBag.PageNumber < ViewBag.TotalPages)
                {
                    <a href="@Url.Action("Index", new { searchString = ViewBag.CurrentSearch, planId = ViewBag.CurrentPlanId, pageNumber = ViewBag.PageNumber + 1 })" class="pg-btn pg-text">
                        @Localizer["Next"] <i class='bx bx-chevron-right'></i>
                    </a>
                }
                else
                {
                    <button class="pg-btn pg-text" disabled>@Localizer["Next"] <i class='bx bx-chevron-right'></i></button>
                }
            </div>
        </div>
    }
</div>

<!-- ─── Wallets Modal ─── -->
<div id="walletsModal" class="wallets-modal-overlay">
    <div class="wallets-modal">
        <div class="wallets-modal-header">
            <h3><i class='bx bx-wallet'></i> User Wallets</h3>
            <button class="modal-close-btn" onclick="closeWalletsModal()">
                <i class='bx bx-x'></i>
            </button>
        </div>
        <div class="wallets-modal-body" id="walletsModalContent">
            <!-- Wallets injected here -->
        </div>
    </div>
</div>

<script>
function showWalletsModal(btn) {
    var wallets = JSON.parse(btn.getAttribute('data-wallets'));
    var content = document.getElementById('walletsModalContent');
    content.innerHTML = '';

    if (wallets.length === 0) {
        content.innerHTML = '<div class="empty-state" style="padding:2rem;"><i class=\'bx bx-wallet\' style="font-size:2.5rem;color:#9ca3af;display:block;margin-bottom:.75rem;"></i><h3 style="color:#6b7280;font-size:1rem;">No wallets found</h3></div>';
    } else {
        wallets.forEach(function(w) {
            content.innerHTML += `
                <div class="wallet-item">
                    <div class="wallet-name">
                        <i class='bx bx-coin-stack'></i>
                        <span>${w.Name}</span>
                    </div>
                    <div class="wallet-balance">${w.Balance.toFixed(2)}</div>
                </div>`;
        });
    }

    document.getElementById('walletsModal').classList.add('open');
}

function closeWalletsModal() {
    document.getElementById('walletsModal').classList.remove('open');
}

// Close on overlay click
document.getElementById('walletsModal').addEventListener('click', function(e) {
    if (e.target === this) closeWalletsModal();
});
</script>

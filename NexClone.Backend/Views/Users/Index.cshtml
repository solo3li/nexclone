@model IEnumerable<NexClone.Backend.Core.Entities.ApplicationUser>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

@{
    ViewData["Title"] = "Users Management";
}

<div class="bx--grid bx--grid--full-width">
    <div class="bx--row">
        <div class="bx--col" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
            <h1 class="bx--type-productive-heading-05">@Localizer["Users Management"]</h1>
            <div style="display: flex; gap: 1rem;">
                <button id="bulkDeleteBtn" class="bx--btn bx--btn--danger" onclick="bulkDelete()" disabled>
                    @Localizer["Delete Selected"]
                </button>
                <a href="@Url.Action("Create")" class="bx--btn bx--btn--primary">
                    Create User
                    <svg focusable="false" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" fill="currentColor" width="16" height="16" viewBox="0 0 32 32" aria-hidden="true" class="bx--btn__icon"><path d="M17 15L17 8 15 8 15 15 8 15 8 17 15 17 15 24 17 24 17 17 24 17 24 15z"></path></svg>
                </a>
            </div>
        </div>
    </div>
    
    <div class="bx--row" style="margin-bottom: 2rem;">
        <div class="bx--col">
            <form method="get" action="@Url.Action("Index")" style="display: flex; gap: 1rem; align-items: flex-end; background: #ffffff; padding: 1.5rem; border: 1px solid #e0e0e0;">
                <div class="bx--form-item" style="flex: 1;">
                    <label for="searchString" class="bx--label">@Localizer["Search User (Email, Phone, ID)"]</label>
                    <div class="bx--text-input__field-wrapper">
                        <input id="searchString" type="text" class="bx--text-input" name="searchString" value="@ViewBag.CurrentSearch" placeholder="Enter email, phone, or ID...">
                    </div>
                </div>
                <div class="bx--form-item" style="flex: 1;">
                    <label for="planId" class="bx--label">@Localizer["Filter by Plan"]</label>
                    <div class="bx--select">
                        <select id="planId" name="planId" class="bx--select-input" asp-items="ViewBag.Plans">
                            <option value="">All Plans</option>
                        </select>
                        <svg focusable="false" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" fill="currentColor" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" class="bx--select__arrow"><path d="M8 11L3 6 3.7 5.3 8 9.6 12.3 5.3 13 6z"></path></svg>
                    </div>
                </div>
                <div style="display: flex; gap: 0.5rem;">
                    <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Search & Filter"]</button>
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch) || ViewBag.CurrentPlanId != null)
                    {
                        <a href="@Url.Action("Index")" class="bx--btn bx--btn--secondary">@Localizer["Clear"]</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="bx--row">
        <div class="bx--col">
            <!-- Carbon UI Data Table -->
            <div class="bx--data-table-container" data-table>
                <div class="bx--data-table-header">
                    <h4 class="bx--data-table-header__title">@Localizer["All Registered Users"]</h4>
                    <p class="bx--data-table-header__description">@Localizer["Manage users and their status"]</p>
                </div>

                <table class="bx--data-table">
                    <thead>
                        <tr>
                            <th style="width: 50px; text-align: center;"><input type="checkbox" id="selectAll" onclick="toggleAll(this)" /></th>
                            <th><span class="bx--table-header-label">@Localizer["Email"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Phone"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Status"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Country"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Credits"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Current Plan"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Role"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Joined"]</span></th>
                            <th><span class="bx--table-header-label">@Localizer["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 2rem;">
                                    <p class="bx--type-productive-heading-03">@Localizer["No users found in the database."]</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var user in Model)
                            {
                                var currentSub = user.Subscriptions?.FirstOrDefault(s => s.Status == "active");
                                <tr>
                                    <td style="text-align: center;"><input type="checkbox" class="rowCheckbox" value="@user.Id" onclick="toggleRow()" /></td>
                                    <td>@user.Email</td>
                                    <td>@(string.IsNullOrEmpty(user.PhoneNumber) ? "N/A" : user.PhoneNumber)</td>
                                    <td>
                                        @if (user.EmailConfirmed || user.IsVerified)
                                        {
                                            <span class="bx--tag bx--tag--green">@Localizer["Verified"]</span>
                                        }
                                        else
                                        {
                                            <span class="bx--tag bx--tag--red">@Localizer["Unverified"]</span>
                                        }
                                    </td>
                                    <td>@user.Country</td>
                                    <td>
                                        <div style="font-size: 0.85rem;">
                                            <div><strong>SC:</strong> @user.StandardCredits.ToString("0.##")</div>
                                            <div><strong>PC:</strong> @user.PremiumCredits.ToString("0.##")</div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (currentSub?.Plan != null)
                                        {
                                            <span class="bx--tag bx--tag--green">@currentSub.Plan.Name</span>
                                        }
                                        else
                                        {
                                            <span class="bx--tag bx--tag--gray">@Localizer["None"]</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsStaff)
                                        {
                                            <span class="bx--tag bx--tag--purple">@Localizer["Admin"]</span>
                                        }
                                        else
                                        {
                                            <span class="bx--tag bx--tag--blue">@Localizer["User"]</span>
                                        }
                                    </td>
                                    <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td style="display: flex; gap: 0.5rem; align-items: center;">
                                        <button type="button" class="bx--btn bx--btn--tertiary bx--btn--sm" onclick="openAddBalanceModal('@user.Id', '@user.Email')">@Localizer["Add Balance"]</button>
                                        <a href="@Url.Action("Details", new { id = user.Id })" class="bx--btn bx--btn--ghost bx--btn--sm">@Localizer["View"]</a>
                                        <a href="@Url.Action("Edit", new { id = user.Id })" class="bx--btn bx--btn--primary bx--btn--sm">@Localizer["Edit"]</a>
                                        <form asp-action="Delete" asp-route-id="@user.Id" method="post" data-confirm="Are you sure you want to delete this user? This action cannot be undone." style="margin: 0;">
                                            <button type="submit" class="bx--btn bx--btn--danger bx--btn--sm">@Localizer["Delete"]</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination Controls -->
            @if (ViewBag.TotalPages > 1)
            {
                <div class="bx--pagination" data-pagination style="border: 1px solid #e0e0e0; border-top: none; display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 1rem; background: #ffffff;">
                    <div class="bx--pagination__left">
                        <span class="bx--pagination__text">
                            Page @ViewBag.PageNumber of @ViewBag.TotalPages
                        </span>
                    </div>
                    <div class="bx--pagination__right" style="display: flex; gap: 0.5rem; align-items: center;">
                        @if (ViewBag.PageNumber > 1)
                        {
                            <a href="@Url.Action("Index", new { searchString = ViewBag.CurrentSearch, planId = ViewBag.CurrentPlanId, pageNumber = ViewBag.PageNumber - 1 })" class="bx--btn bx--btn--ghost bx--btn--sm" style="padding: 0 1rem;">
                                @Localizer["Previous"]
                            </a>
                        }
                        else
                        {
                            <button class="bx--btn bx--btn--ghost bx--btn--sm" disabled style="padding: 0 1rem; opacity: 0.5;">
                                @Localizer["Previous"]
                            </button>
                        }

                        <div style="display: flex; gap: 0.25rem; align-items: center; margin: 0 0.5rem;">
                            @{
                                int startPage = Math.Max(1, ViewBag.PageNumber - 2);
                                int endPage = Math.Min(ViewBag.TotalPages, ViewBag.PageNumber + 2);
                            }

                            @if (startPage > 1)
                            {
                                <a href="@Url.Action("Index", new { searchString = ViewBag.CurrentSearch, planId = ViewBag.CurrentPlanId, pageNumber = 1 })" class="bx--btn bx--btn--ghost bx--btn--sm" style="padding: 0 0.5rem;">1</a>
                                @if (startPage > 2)
                                {
                                    <span style="padding: 0 0.5rem; color: #525252;">...</span>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                if (i == ViewBag.PageNumber)
                                {
                                    <button class="bx--btn bx--btn--primary bx--btn--sm" disabled style="padding: 0 0.5rem; background-color: #0f62fe; color: white; opacity: 1;">@i</button>
                                }
                                else
                                {
                                    <a href="@Url.Action("Index", new { searchString = ViewBag.CurrentSearch, planId = ViewBag.CurrentPlanId, pageNumber = i })" class="bx--btn bx--btn--ghost bx--btn--sm" style="padding: 0 0.5rem;">@i</a>
                                }
                            }

                            @if (endPage < ViewBag.TotalPages)
                            {
                                @if (endPage < ViewBag.TotalPages - 1)
                                {
                                    <span style="padding: 0 0.5rem; color: #525252;">...</span>
                                }
                                <a href="@Url.Action("Index", new { searchString = ViewBag.CurrentSearch, planId = ViewBag.CurrentPlanId, pageNumber = ViewBag.TotalPages })" class="bx--btn bx--btn--ghost bx--btn--sm" style="padding: 0 0.5rem;">@ViewBag.TotalPages</a>
                            }
                        </div>

                        @if (ViewBag.PageNumber < ViewBag.TotalPages)
                        {
                            <a href="@Url.Action("Index", new { searchString = ViewBag.CurrentSearch, planId = ViewBag.CurrentPlanId, pageNumber = ViewBag.PageNumber + 1 })" class="bx--btn bx--btn--primary bx--btn--sm" style="padding: 0 1rem;">
                                @Localizer["Next"]
                            </a>
                        }
                        else
                        {
                            <button class="bx--btn bx--btn--primary bx--btn--sm" disabled style="padding: 0 1rem; opacity: 0.5;">
                                @Localizer["Next"]
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div id="walletsModal" class="bx--modal" role="dialog" aria-modal="true" tabindex="-1">
    <div class="bx--modal-container">
        <div class="bx--modal-header">
            <p class="bx--modal-header__label bx--type-delta">User Wallets</p>
            <p class="bx--modal-header__heading bx--type-beta">Balances</p>
            <button class="bx--modal-close" type="button" data-modal-close aria-label="close modal" onclick="closeWalletsModal()">
                <svg focusable="false" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" fill="currentColor" width="16" height="16" viewBox="0 0 32 32" aria-hidden="true" class="bx--modal-close__icon"><path d="M24 9.4L22.6 8 16 14.6 9.4 8 8 9.4 14.6 16 8 22.6 9.4 24 16 17.4 22.6 24 24 22.6 17.4 16 24 9.4z"></path></svg>
            </button>
        </div>
        <div class="bx--modal-content" id="walletsModalContent">
            <!-- Wallets will be injected here -->
        </div>
    </div>
</div>

<script>
function showWalletsModal(btn) {
    var wallets = JSON.parse(btn.getAttribute('data-wallets'));
    var content = document.getElementById('walletsModalContent');
    content.innerHTML = '';
    
    if (wallets.length === 0) {
        content.innerHTML = '<p style="margin-bottom: 1rem;">No wallets found for this user.</p>';
    } else {
        var table = '<table class="bx--data-table" style="margin-bottom: 2rem;"><thead><tr><th>Wallet</th><th>Balance</th></tr></thead><tbody>';
        wallets.forEach(function(w) {
            table += '<tr><td>' + w.Name + '</td><td>' + w.Balance.toFixed(2) + '</td></tr>';
        });
        table += '</tbody></table>';
        content.innerHTML = table;
    }
    
    document.getElementById('walletsModal').classList.add('is-visible');
}

function closeWalletsModal() {
    document.getElementById('walletsModal').classList.remove('is-visible');
    }
</script>

<div data-modal id="addBalanceModal" class="bx--modal" role="dialog" aria-modal="true" tabindex="-1">
    <div class="bx--modal-container">
        <div class="bx--modal-header">
            <p class="bx--modal-header__label bx--type-delta" id="addBalanceModalUserEmail"></p>
            <p class="bx--modal-header__heading bx--type-beta">@Localizer["Add Balance"]</p>
            <button class="bx--modal-close" type="button" data-modal-close aria-label="Close modal" onclick="closeAddBalanceModal()">
                <svg focusable="false" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" fill="currentColor" width="16" height="16" viewBox="0 0 32 32" aria-hidden="true" class="bx--modal-close__icon"><path d="M24 9.4L22.6 8 16 14.6 9.4 8 8 9.4 14.6 16 8 22.6 9.4 24 16 17.4 22.6 24 24 22.6 17.4 16 24 9.4z"></path></svg>
            </button>
        </div>
        <form asp-action="AdjustCredits" method="post" style="margin: 0;">
            <div class="bx--modal-content">
                <input type="hidden" id="addBalanceUserId" name="userId" value="" />
                
                <div class="bx--form-item" style="margin-bottom: 1.5rem;">
                    <label for="operation" class="bx--label">@Localizer["Operation"]</label>
                    <div class="bx--select">
                        <select id="operation" name="operation" class="bx--select-input" required>
                            <option value="add">@Localizer["Add Credits"]</option>
                            <option value="remove">@Localizer["Remove Credits"]</option>
                        </select>
                        <svg focusable="false" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" fill="currentColor" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" class="bx--select__arrow"><path d="M8 11L3 6 3.7 5.3 8 9.6 12.3 5.3 13 6z"></path></svg>
                    </div>
                </div>
                
                <div class="bx--form-item">
                    <label for="amount" class="bx--label">@Localizer["Amount (Credits)"]</label>
                    <div class="bx--text-input__field-wrapper">
                        <input id="amount" type="number" class="bx--text-input" name="amount" required step="0.01" placeholder="e.g. 100 or -50">
                    </div>
                </div>
            </div>
            <div class="bx--modal-footer">
                <button class="bx--btn bx--btn--secondary" type="button" data-modal-close onclick="closeAddBalanceModal()">@Localizer["Cancel"]</button>
                <button class="bx--btn bx--btn--primary" type="submit">@Localizer["Apply Balance"]</button>
            </div>
        </form>
    </div>
</div>

<script>
function openAddBalanceModal(userId, email) {
    document.getElementById('addBalanceUserId').value = userId;
    document.getElementById('addBalanceModalUserEmail').innerText = 'User: ' + email;
    document.getElementById('addBalanceModal').classList.add('is-visible');
}

function closeAddBalanceModal() {
    document.getElementById('addBalanceModal').classList.remove('is-visible');
}
</script>

@section Scripts {
    <script>
        function toggleAll(source) {
            checkboxes = document.querySelectorAll('.rowCheckbox');
            for (var i = 0; i < checkboxes.length; i++) {
                checkboxes[i].checked = source.checked;
            }
            toggleRow();
        }

        function toggleRow() {
            var checkboxes = document.querySelectorAll('.rowCheckbox:checked');
            var bulkDeleteBtn = document.getElementById('bulkDeleteBtn');
            bulkDeleteBtn.disabled = checkboxes.length === 0;
        }

        function bulkDelete() {
            if (!confirm('@Localizer["Are you sure you want to delete the selected users? This action cannot be undone."]')) {
                return;
            }

            var checkboxes = document.querySelectorAll('.rowCheckbox:checked');
            var ids = Array.from(checkboxes).map(cb => cb.value);

            fetch('@Url.Action("BulkDelete", "Users")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(ids)
            })
            .then(response => {
                if (response.ok) {
                    window.location.reload();
                } else {
                    alert('@Localizer["Failed to delete selected users."]');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('@Localizer["An error occurred while deleting."]');
            });
        }
    </script>
}

@model NexClone.Backend.Core.Entities.Subscription
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer
@using NexClone.Backend.Core.Entities

@{
    ViewData["Title"] = "Subscription Details";
    var history = ViewBag.History as IEnumerable<GenerationHistory> ?? Enumerable.Empty<GenerationHistory>();
}

<div class="bx--grid">
    <div class="bx--row">
        <div class="bx--col">
            <h4 style="margin-bottom: 1rem;">@Localizer["Subscription Details"]</h4>
            <a href="@Url.Action("Index", "Subscriptions")" class="bx--btn bx--btn--secondary" style="margin-bottom: 2rem;">@Localizer["Back to List"]</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div data-notification class="bx--inline-notification bx--inline-notification--success" role="alert" style="margin-bottom: 1rem;">
            <div class="bx--inline-notification__details">
                <svg focusable="false" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bx--inline-notification__icon" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M10,1c-4.9,0-9,4.1-9,9s4.1,9,9,9s9-4.1,9-9S14.9,1,10,1z M8.7,13.5l-3.2-3.2l1-1l2.2,2.2l4.8-4.8l1,1L8.7,13.5z"></path></svg>
                <div class="bx--inline-notification__text-wrapper">
                    <p class="bx--inline-notification__title">@Localizer["Success"]</p>
                    <p class="bx--inline-notification__subtitle">@TempData["SuccessMessage"]</p>
                </div>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div data-notification class="bx--inline-notification bx--inline-notification--error" role="alert" style="margin-bottom: 1rem;">
            <div class="bx--inline-notification__details">
                <svg focusable="false" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bx--inline-notification__icon" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M10,1c-5,0-9,4-9,9s4,9,9,9s9-4,9-9S15,1,10,1z M13.5,14.5l-8-8l1-1l8,8L13.5,14.5z"></path></svg>
                <div class="bx--inline-notification__text-wrapper">
                    <p class="bx--inline-notification__title">@Localizer["Error"]</p>
                    <p class="bx--inline-notification__subtitle">@TempData["ErrorMessage"]</p>
                </div>
            </div>
        </div>
    }

    <div class="bx--row" style="margin-bottom: 2rem;">
        <!-- User Info -->
        <div class="bx--col-md-4">
            <div class="bx--tile">
                <h5 style="margin-bottom: 1rem;">@Localizer["User Information"]</h5>
                <p><strong>Name:</strong> @(Model.User?.FullName)</p>
                <p><strong>Email:</strong> @(Model.User?.Email)</p>
                <p><strong>Standard Credits:</strong> @(Model.User?.StandardCredits ?? 0) &nbsp;|&nbsp; <strong>Premium Credits:</strong> @(Model.User?.PremiumCredits ?? 0)</p>
                <p><strong>Joined:</strong> @(Model.User?.CreatedAt.ToString("g"))</p>
            </div>
        </div>

        <!-- Subscription Info -->
        <div class="bx--col-md-4">
            <div class="bx--tile">
                <h5 style="margin-bottom: 1rem;">@Localizer["Subscription Info"]</h5>
                <p><strong>Plan Name:</strong> @(Model.Plan?.Name)</p>
                <p><strong>Status:</strong> 
                    <span class="bx--tag @(Model.Status == "active" ? "bx--tag--green" : "bx--tag--red")">
                        @(Model.Status ?? "unknown")
                    </span>
                </p>
                <p><strong>Start Date:</strong> @Model.StartDate.ToString("g")</p>
                <p><strong>Current End Date:</strong> @Model.EndDate.ToString("g")</p>
                @if (ViewBag.Invoice != null)
                {
                    <p style="margin-top: 1rem;">
                        <strong>@Localizer["Tax Invoice"]:</strong> 
                        <a href="@ViewBag.Invoice.MinioPdfUrl" target="_blank" class="bx--link">@ViewBag.Invoice.InvoiceNumber (PDF)</a>
                    </p>
                }
            </div>
        </div>

        <!-- Edit Subscription -->
        <div class="bx--col-md-4">
            <div class="bx--tile">
                <h5 style="margin-bottom: 1rem;">@Localizer["Update Subscription"]</h5>
                <form asp-action="UpdateEndDate" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="bx--form-item">
                        <label class="bx--label">@Localizer["New End Date"]</label>
                        <input type="datetime-local" name="newEndDate" class="bx--text-input" value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                    <button type="submit" class="bx--btn bx--btn--primary" style="margin-top: 1rem;">@Localizer["Update Date"]</button>
                </form>
            </div>
        </div>
    </div>

    <!-- History Table -->
    <div class="bx--row">
        <div class="bx--col">
            <h5 style="margin-bottom: 1rem;">@Localizer["User Generation History"]</h5>
            @if (history.Any())
            {
                <table class="bx--data-table">
                    <thead>
                        <tr>
                            <th>@Localizer["Tool Name"]</th>
                            <th>@Localizer["Cost"]</th>
                            <th>@Localizer["Prompt / Input"]</th>
                            <th>@Localizer["Date"]</th>
                            <th>@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in history)
                        {
                            <tr>
                                <td>@item.Type</td>
                                <td>@item.CreditsUsed</td>
                                <td>@(string.IsNullOrEmpty(item.InputText) ? "-" : (item.InputText.Length > 50 ? item.InputText.Substring(0, 50) + "..." : item.InputText))</td>
                                <td>@item.CreatedAt.ToString("g")</td>
                                <td>
                                    <a href="@Url.Action("Details", "HistoryAdmin", new { id = item.Id })" class="bx--btn bx--btn--secondary bx--btn--sm" style="padding: 5px 10px; font-size: 12px; height: 30px; min-height: unset; text-decoration: none; display: inline-block;">
                                        @Localizer["View Details"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>@Localizer["No generation history found for this user."]</p>
            }
        </div>
    </div>
</div>

@model IEnumerable<NexClone.Backend.Core.Entities.Subscription>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

@{
    ViewData["Title"] = "User Subscriptions";
    var lastUsedDates = ViewBag.LastUsedDates as Dictionary<Guid, DateTime?> ?? new Dictionary<Guid, DateTime?>();
}

<style>
    /* ── Sub Index shared helpers ── */
    .sub-page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem; }
    .sub-page-header h1 { font-size: 1.7rem; font-weight: 800; margin: 0; color: var(--admin-text-primary); display: flex; align-items: center; gap: .6rem; }
    .sub-page-header h1 i { color: var(--admin-primary); }
    .sub-page-header p  { margin: 5px 0 0; color: var(--admin-text-secondary); font-size: .9rem; }

    /* Stats */
    .sub-stats { display: grid; grid-template-columns: repeat(4,1fr); gap:1.5rem; margin-bottom:2.5rem; }
    .sub-stat  { background: var(--admin-surface); border:1px solid var(--admin-border-light); border-radius:var(--admin-radius-lg); padding:1.5rem; display:flex; align-items:center; gap:1.25rem; box-shadow:var(--shadow-soft); transition:var(--trans-smooth); }
    .sub-stat:hover { transform:translateY(-3px); box-shadow:var(--shadow-float); }
    .sub-stat__icon { width:48px; height:48px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.5rem; flex-shrink:0; }
    .sub-stat__num   { font-size:1.9rem; font-weight:800; line-height:1; }
    .sub-stat__label { font-size:.75rem; color:var(--admin-text-secondary); margin-top:4px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; }

    /* Filter card */
    .sub-filter-card { background:var(--admin-surface); border:1px solid var(--admin-border-light); border-radius:var(--admin-radius-lg); padding:1.5rem; box-shadow:var(--shadow-soft); margin-bottom:2rem; }
    .sub-filter-card h5 { font-size:1rem; font-weight:700; margin:0 0 1.25rem; display:flex; align-items:center; gap:.5rem; color:var(--admin-text-primary); }
    .sub-filter-card h5 i { color:var(--admin-primary); font-size:1.2rem; }
    .sub-filter-row { display:flex; gap:1.25rem; flex-wrap:wrap; align-items:flex-end; }
    .sub-filter-row .bx--form-item { flex:1; min-width:180px; margin-bottom:0 !important; }

    /* Table card */
    .sub-table-card { background:var(--admin-surface); border:1px solid var(--admin-border-light); border-radius:var(--admin-radius-lg); box-shadow:var(--shadow-soft); overflow:hidden; }
    .sub-table-card .t-header { padding:1.25rem 1.5rem; border-bottom:1px solid var(--admin-border-light); display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
    .sub-table-card .t-header h4 { font-size:1rem; font-weight:700; margin:0; display:flex; align-items:center; gap:.5rem; color:var(--admin-text-primary); }
    .sub-table-card .t-header h4 i { color:var(--admin-primary); }
    .sub-table-scroll { overflow-x:auto; }
    .sub-table { width:100%; border-collapse:collapse; min-width:1000px; }
    .sub-table thead tr { background:rgba(139,92,246,.06); border-bottom:2px solid var(--admin-border-light); }
    .sub-table th { padding:.75rem 1rem; font-size:.72rem; font-weight:800; text-transform:uppercase; letter-spacing:.06em; color:var(--admin-text-secondary); white-space:nowrap; text-align:left; }
    html[dir="rtl"] .sub-table th { text-align:right; }
    .sub-table tbody tr { border-bottom:1px solid var(--admin-border-light); transition:background .2s; }
    .sub-table tbody tr:last-child { border-bottom:none; }
    .sub-table tbody tr:hover { background:rgba(139,92,246,.04); }
    .sub-table td { padding:.75rem 1rem; font-size:.87rem; color:var(--admin-text-primary); vertical-align:middle; white-space:nowrap; }

    /* Badges */
    .badge { display:inline-flex; align-items:center; gap:5px; padding:4px 12px; border-radius:20px; font-size:.75rem; font-weight:700; white-space:nowrap; }
    .badge-dot { width:7px; height:7px; border-radius:50%; }
    .badge-green  { background:rgba(34,197,94,.12);  color:#16a34a; } .badge-green .badge-dot  { background:#22c55e; box-shadow:0 0 5px #22c55e; }
    .badge-red    { background:rgba(239,68,68,.12);  color:#dc2626; } .badge-red .badge-dot    { background:#ef4444; }
    .badge-yellow { background:rgba(234,179,8,.12);  color:#ca8a04; } .badge-yellow .badge-dot { background:#eab308; }
    .badge-gray   { background:rgba(107,114,128,.1); color:#6b7280; }
    .badge-purple { background:rgba(139,92,246,.12); color:#7c3aed; }

    /* Action buttons */
    .act-btns { display:flex; gap:.35rem; align-items:center; }
    .act-btn { display:inline-flex; align-items:center; justify-content:center; width:32px; height:32px; border-radius:8px; font-size:1rem; text-decoration:none; border:none; cursor:pointer; transition:var(--trans-smooth); }
    .act-btn-view   { background:rgba(139,92,246,.1); color:var(--admin-primary); }
    .act-btn-view:hover   { background:var(--admin-primary); color:#fff; transform:translateY(-2px); }
    .act-btn-danger { background:rgba(239,68,68,.1); color:#ef4444; }
    .act-btn-danger:hover { background:#ef4444; color:#fff; transform:translateY(-2px); }
    .act-btn-warn   { background:rgba(234,179,8,.1); color:#ca8a04; }
    .act-btn-warn:hover   { background:#eab308; color:#fff; transform:translateY(-2px); }

    /* Inline date update */
    .date-form { display:flex; gap:.4rem; align-items:center; }
    .date-input { height:30px; font-size:.78rem; padding:0 6px; border-radius:6px; border:1px solid var(--admin-border-light); background:var(--admin-bg, #f8fafc); color:var(--admin-text-primary); width:170px; }
    .date-input:focus { outline:none; border-color:var(--admin-primary); box-shadow:0 0 0 3px rgba(139,92,246,.1); }
    .btn-update { display:inline-flex; align-items:center; height:30px; padding:0 12px; border-radius:6px; background:var(--admin-primary); color:#fff; font-size:.75rem; font-weight:700; border:none; cursor:pointer; white-space:nowrap; transition:var(--trans-smooth); }
    .btn-update:hover { background:#7c3aed; transform:translateY(-1px); }

    /* Filter submit buttons */
    .btn-filter { display:inline-flex; align-items:center; gap:6px; padding:10px 18px; border-radius:10px; font-size:.85rem; font-weight:700; white-space:nowrap; border:none; cursor:pointer; transition:var(--trans-smooth); text-decoration:none; }
    .btn-filter-primary { background:rgba(139,92,246,.1); color:var(--admin-primary); }
    .btn-filter-primary:hover { background:var(--admin-primary); color:#fff; transform:translateY(-2px); }
    .btn-filter-ghost { background:rgba(107,114,128,.1); color:#6b7280; }
    .btn-filter-ghost:hover { background:#6b7280; color:#fff; transform:translateY(-2px); }

    /* Notif */
    .sub-notif { padding:1rem 1.5rem; border-radius:12px; margin-bottom:1.5rem; display:flex; align-items:center; gap:.75rem; font-weight:600; font-size:.9rem; }
    .sub-notif i { font-size:1.3rem; }
    .sub-notif-ok  { background:rgba(34,197,94,.1);  color:#16a34a; border:1px solid rgba(34,197,94,.2); }
    .sub-notif-err { background:rgba(239,68,68,.1);  color:#dc2626; border:1px solid rgba(239,68,68,.2); }

    @@media (max-width:1024px) { .sub-stats { grid-template-columns:repeat(2,1fr); } }
    @@media (max-width:768px)  { .sub-stats { grid-template-columns:1fr; } .sub-filter-row { flex-direction:column; } }
</style>

<!-- Notifications -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="sub-notif sub-notif-ok"><i class='bx bx-check-circle'></i> @TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="sub-notif sub-notif-err"><i class='bx bx-x-circle'></i> @TempData["ErrorMessage"]</div>
}

<!-- Page Header -->
<div class="sub-page-header">
    <div>
        <h1><i class='bx bx-credit-card-front'></i> @Localizer["User Subscriptions"]</h1>
        <p>@Localizer["View and manage all active and past user subscriptions."]</p>
    </div>
</div>

<!-- Stats -->
@{
    var totalSubs  = Model.Count();
    var activeSubs = Model.Count(s => s.Status?.ToLower() == "active");
    var expiredSubs= Model.Count(s => s.Status?.ToLower() == "expired");
    var frozenSubs = Model.Count(s => s.Status?.ToLower() == "freeze");
}
<div class="sub-stats">
    <div class="sub-stat">
        <div class="sub-stat__icon" style="background:rgba(139,92,246,.12);"><i class='bx bx-list-ul' style="color:var(--admin-primary);"></i></div>
        <div><div class="sub-stat__num" style="color:var(--admin-primary);">@totalSubs</div><div class="sub-stat__label">Total</div></div>
    </div>
    <div class="sub-stat">
        <div class="sub-stat__icon" style="background:rgba(34,197,94,.12);"><i class='bx bx-check-shield' style="color:#22c55e;"></i></div>
        <div><div class="sub-stat__num" style="color:#22c55e;">@activeSubs</div><div class="sub-stat__label">Active</div></div>
    </div>
    <div class="sub-stat">
        <div class="sub-stat__icon" style="background:rgba(239,68,68,.12);"><i class='bx bx-x-circle' style="color:#ef4444;"></i></div>
        <div><div class="sub-stat__num" style="color:#ef4444;">@expiredSubs</div><div class="sub-stat__label">Expired</div></div>
    </div>
    <div class="sub-stat">
        <div class="sub-stat__icon" style="background:rgba(234,179,8,.12);"><i class='bx bx-pause-circle' style="color:#eab308;"></i></div>
        <div><div class="sub-stat__num" style="color:#eab308;">@frozenSubs</div><div class="sub-stat__label">Frozen</div></div>
    </div>
</div>

<!-- Filter Card -->
<div class="sub-filter-card">
    <h5><i class='bx bx-filter-alt'></i> @Localizer["Advanced Filters"]</h5>
    <form method="get" action="@Url.Action("Index")">
        <div class="sub-filter-row">
            <div class="bx--form-item">
                <label for="planId" class="bx--label">@Localizer["Plan Type"]</label>
                <div class="bx--select">
                    <select id="planId" name="planId" class="bx--select-input">
                        <option value="" selected="@(ViewBag.SelectedPlanId == null ? "selected" : null)">All Plans</option>
                        @if (ViewBag.Plans != null)
                        {
                            foreach (var plan in (IEnumerable<NexClone.Backend.Core.Entities.Plan>)ViewBag.Plans)
                            {
                                <option value="@plan.Id" selected="@(ViewBag.SelectedPlanId != null && ViewBag.SelectedPlanId.ToString() == plan.Id.ToString() ? "selected" : null)">@plan.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="bx--form-item">
                <label for="status" class="bx--label">@Localizer["Status"]</label>
                <div class="bx--select">
                    <select id="status" name="status" class="bx--select-input">
                        <option value="" selected="@(string.IsNullOrEmpty(ViewBag.SelectedStatus) ? "selected" : null)">All Statuses</option>
                        <option value="active"   selected="@(ViewBag.SelectedStatus == "active"   ? "selected" : null)">Active</option>
                        <option value="expired"  selected="@(ViewBag.SelectedStatus == "expired"  ? "selected" : null)">Expired</option>
                        <option value="freeze"   selected="@(ViewBag.SelectedStatus == "freeze"   ? "selected" : null)">Freeze</option>
                        <option value="canceled" selected="@(ViewBag.SelectedStatus == "canceled" ? "selected" : null)">Canceled</option>
                    </select>
                </div>
            </div>
            <div class="bx--form-item">
                <label for="datePeriod" class="bx--label">@Localizer["Creation Period"]</label>
                <div class="bx--select">
                    <select id="datePeriod" name="datePeriod" class="bx--select-input" onchange="toggleCustomDates()">
                        <option value="" selected="@(string.IsNullOrEmpty(ViewBag.SelectedDatePeriod) ? "selected" : null)">All Time</option>
                        <option value="last7days"  selected="@(ViewBag.SelectedDatePeriod == "last7days"  ? "selected" : null)">Last 7 Days</option>
                        <option value="last30days" selected="@(ViewBag.SelectedDatePeriod == "last30days" ? "selected" : null)">Last 30 Days</option>
                        <option value="last90days" selected="@(ViewBag.SelectedDatePeriod == "last90days" ? "selected" : null)">Last 90 Days</option>
                        <option value="custom"     selected="@(ViewBag.SelectedDatePeriod == "custom"     ? "selected" : null)">Custom Range</option>
                    </select>
                </div>
            </div>
            <div id="customDatesContainer" style="display:@(ViewBag.SelectedDatePeriod == "custom" ? "flex" : "none"); gap:1rem; flex:2; min-width:280px;">
                <div class="bx--form-item" style="flex:1;">
                    <label for="startDate" class="bx--label">@Localizer["Start Date"]</label>
                    <input id="startDate" type="date" name="startDate" class="bx--text-input" value="@ViewBag.SelectedStartDate">
                </div>
                <div class="bx--form-item" style="flex:1;">
                    <label for="endDate" class="bx--label">@Localizer["End Date"]</label>
                    <input id="endDate" type="date" name="endDate" class="bx--text-input" value="@ViewBag.SelectedEndDate">
                </div>
            </div>
            <div style="display:flex; gap:.5rem; align-items:flex-end; flex-shrink:0;">
                <button type="submit" class="btn-filter btn-filter-primary">
                    <i class='bx bx-search'></i> Apply Filters
                </button>
                <a href="@Url.Action("Index")" class="btn-filter btn-filter-ghost">
                    <i class='bx bx-x'></i> @Localizer["Clear"]
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Table Card -->
<div class="sub-table-card">
    <div class="t-header">
        <div>
            <h4><i class='bx bx-table'></i> @Localizer["Manage Subscriptions"]</h4>
        </div>
        <div class="badge badge-purple" style="font-size:.85rem; padding:6px 16px;">@Model.Count() @Localizer["results"]</div>
    </div>
    <div class="sub-table-scroll">
        <table class="sub-table">
            <thead>
                <tr>
                    <th>@Localizer["User"]</th>
                    <th>@Localizer["Plan"]</th>
                    <th>@Localizer["Price"]</th>
                    <th>@Localizer["Balance"]</th>
                    <th>@Localizer["Last Used"]</th>
                    <th>@Localizer["Start Date"]</th>
                    <th>@Localizer["End Date"]</th>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["Created At"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var lastUsed = lastUsedDates.ContainsKey(item.UserId) ? lastUsedDates[item.UserId] : null;
                    var statusClass = item.Status?.ToLower() switch {
                        "active"  => "badge-green",
                        "expired" => "badge-red",
                        "freeze"  => "badge-yellow",
                        _         => "badge-gray"
                    };
                    <tr>
                        <td>
                            <div style="font-weight:600;font-size:.85rem;">@(item.User?.Email ?? "Unknown")</div>
                        </td>
                        <td><span class="badge badge-purple"><i class='bx bx-crown' style="font-size:.9rem;"></i>@item.Plan.Name</span></td>
                        <td><strong style="color:var(--admin-primary);">$@item.Plan.PriceUsd</strong></td>
                        <td><span style="font-weight:700;">@(item.User != null ? item.User.AvailableCredits.ToString("0.##") : "0")</span> <span style="font-size:.75rem;color:var(--admin-text-secondary);">cr</span></td>
                        <td style="color:var(--admin-text-secondary);font-size:.82rem;">@(lastUsed.HasValue ? lastUsed.Value.ToString("MMM dd, yyyy") : "Never")</td>
                        <td>@item.StartDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            <form asp-action="UpdateEndDate" method="post" class="date-form">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="datetime-local" name="newEndDate" class="date-input" value="@item.EndDate.ToString("yyyy-MM-ddTHH:mm")" required />
                                <button type="submit" class="btn-update"><i class='bx bx-save'></i></button>
                            </form>
                        </td>
                        <td><span class="badge @statusClass"><span class="badge-dot"></span>@item.Status?.ToUpper()</span></td>
                        <td style="color:var(--admin-text-secondary);font-size:.82rem;">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            <div class="act-btns">
                                <a href="@Url.Action("Details", "Subscriptions", new { id = item.Id })" class="act-btn act-btn-view" title="@Localizer["Details"]">
                                    <i class='bx bx-show'></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" data-confirm="Are you sure you want to delete this subscription?" style="margin:0;">
                                    <button type="submit" class="act-btn act-btn-danger" title="@Localizer["Delete"]">
                                        <i class='bx bx-trash'></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
function toggleCustomDates() {
    var period = document.getElementById('datePeriod').value;
    var container = document.getElementById('customDatesContainer');
    if (period === 'custom') {
        container.style.display = 'flex';
    } else {
        container.style.display = 'none';
        var sd = document.getElementById('startDate');
        var ed = document.getElementById('endDate');
        if (sd) sd.value = '';
        if (ed) ed.value = '';
    }
}
</script>

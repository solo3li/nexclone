@model NexClone.Backend.Core.Entities.WalletType
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

<div class="bx--grid" style="padding-left: 0;">
    <div class="bx--row" style="margin-bottom: 2rem;">
        <div class="bx--col">
            <h2 style="margin: 0; font-weight: 400; font-size: 1.5rem;">@ViewData["Title"]</h2>
            <p style="color: #525252; margin-top: 0.5rem;">@Localizer["Add a new type of wallet (e.g. AUDIO, VIDEO) to segregate user balances."]</p>
        </div>
    </div>

    <div class="bx--row">
        <div class="bx--col" style="max-width: 600px;">
            <form asp-action="Create" method="post" style="background: #ffffff; padding: 2rem; border: 1px solid #e0e0e0;">
                <div class="bx--form-item">
                    <label asp-for="Name" class="bx--label">@Localizer["Wallet Name"]</label>
                    <div class="bx--text-input__field-wrapper">
                        <input asp-for="Name" class="bx--text-input" placeholder="e.g. Audio Generator Wallet" required />
                    </div>
                    <span asp-validation-for="Name" class="bx--form-requirement"></span>
                </div>

                <div class="bx--form-item" style="margin-top: 1.5rem;">
                    <label asp-for="Code" class="bx--label">@Localizer["Wallet Code (Unique Identifier)"]</label>
                    <div class="bx--text-input__field-wrapper">
                        <input asp-for="Code" class="bx--text-input" placeholder="e.g. AUDIO" style="text-transform: uppercase;" required />
                    </div>
                    <span asp-validation-for="Code" class="bx--form-requirement"></span>
                    <div class="bx--form__helper-text">@Localizer["Used internally by the system to match tools to wallets."]</div>
                </div>

                <div class="bx--form-item bx--checkbox-wrapper" style="margin-top: 1.5rem;">
                    <input asp-for="IsActive" class="bx--checkbox" checked />
                    <label asp-for="IsActive" class="bx--checkbox-label" title="Enable this wallet type">
                        <span class="bx--checkbox-label-text">@Localizer["Is Active"]</span>
                    </label>
                </div>

                <div style="margin-top: 2.5rem; display: flex; gap: 1rem;">
                    <button type="submit" class="bx--btn bx--btn--primary">@Localizer["Save"]</button>
                    <a href="@Url.Action("Index")" class="bx--btn bx--btn--secondary">@Localizer["Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

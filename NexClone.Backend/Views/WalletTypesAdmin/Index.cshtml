@model IEnumerable<NexClone.Backend.Core.Entities.WalletType>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

@{
    ViewData["Title"] = "Wallet Types Management";
}

<style>
    .wt-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem; }
    .wt-header h1 { font-size: 1.8rem; font-weight: 800; margin: 0; color: var(--admin-text-primary); display: flex; align-items: center; gap: 0.6rem; }
    .wt-header h1 i { color: var(--admin-primary); }
    .wt-header p { margin: 4px 0 0; color: var(--admin-text-secondary); font-size: 0.9rem; }

    .btn-create-wt {
        display: inline-flex; align-items: center; gap: 0.5rem;
        background: linear-gradient(135deg, var(--admin-primary) 0%, #a855f7 100%);
        color: #fff; font-weight: 700; font-size: 0.88rem;
        padding: 0.7rem 1.4rem; border-radius: 10px; text-decoration: none; border: none; cursor: pointer;
        box-shadow: 0 4px 18px rgba(139,92,246,.35); transition: var(--trans-bounce);
    }
    .btn-create-wt:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(139,92,246,.45); color: #fff; }

    .wt-table-card {
        background: var(--admin-surface);
        border: 1px solid var(--admin-border-light);
        border-radius: var(--admin-radius-lg);
        box-shadow: var(--shadow-soft);
        overflow: hidden;
    }
    .wt-table-card .t-header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--admin-border-light);
        display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    }
    .wt-table-card .t-header h4 { font-size: 1.05rem; font-weight: 700; margin: 0; color: var(--admin-text-primary); display: flex; align-items: center; gap: 0.5rem; }
    .wt-table-card .t-header h4 i { color: var(--admin-primary); }

    .wt-table-scroll { overflow-x: auto; }
    .wt-table { width: 100%; border-collapse: collapse; min-width: 700px; }
    .wt-table thead tr { background: rgba(139,92,246,.06); border-bottom: 2px solid var(--admin-border-light); }
    .wt-table th { padding: 0.85rem 1rem; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--admin-text-secondary); white-space: nowrap; text-align: left; }
    html[dir="rtl"] .wt-table th { text-align: right; }
    .wt-table tbody tr { border-bottom: 1px solid var(--admin-border-light); transition: background 0.2s; }
    .wt-table tbody tr:last-child { border-bottom: none; }
    .wt-table tbody tr:hover { background: rgba(139,92,246,.04); }
    .wt-table td { padding: 0.9rem 1rem; font-size: 0.88rem; color: var(--admin-text-primary); vertical-align: middle; white-space: nowrap; }

    .badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; }
    .badge-dot { width: 7px; height: 7px; border-radius: 50%; }
    .badge-green { background: rgba(34,197,94,.12); color: #16a34a; }
    .badge-green .badge-dot { background: #22c55e; box-shadow: 0 0 5px #22c55e; }
    .badge-red { background: rgba(239,68,68,.12); color: #dc2626; }
    .badge-red .badge-dot { background: #ef4444; }
    .badge-purple { background: rgba(139,92,246,.12); color: #7c3aed; }

    .code-tag { font-family: monospace; background: rgba(139,92,246,.08); color: var(--admin-primary); padding: 3px 8px; border-radius: 6px; font-weight: 700; font-size: 0.82rem; }

    .wt-actions { display: flex; gap: 0.4rem; align-items: center; }
    .wt-act-btn {
        display: inline-flex; align-items: center; justify-content: center;
        width: 32px; height: 32px; border-radius: 8px; font-size: 1rem;
        text-decoration: none; border: none; cursor: pointer; transition: var(--trans-smooth);
    }
    .wt-act-edit { background: rgba(139,92,246,.1); color: var(--admin-primary); }
    .wt-act-edit:hover { background: var(--admin-primary); color: #fff; transform: translateY(-1px); }
    .wt-act-delete { background: rgba(239,68,68,.1); color: #ef4444; }
    .wt-act-delete:hover { background: #ef4444; color: #fff; transform: translateY(-1px); }

    .empty-wt { text-align: center; padding: 3.5rem 1.5rem; color: var(--admin-text-secondary); }
    .empty-wt i { font-size: 3.5rem; opacity: 0.3; display: block; margin-bottom: 0.75rem; }
</style>

<div class="wt-header">
    <div>
        <h1><i class='bx bx-wallet'></i> @Localizer["Wallet Types Management"]</h1>
        <p>@Localizer["Manage virtual wallet categories and credit types available in the platform."]</p>
    </div>
    <a href="@Url.Action("Create")" class="btn-create-wt">
        <i class='bx bx-plus-circle'></i> @Localizer["Add New Wallet Type"]
    </a>
</div>

<div class="wt-table-card">
    <div class="t-header">
        <h4><i class='bx bx-coin-stack'></i> @Localizer["Configured Wallet Types"]</h4>
        <span class="badge badge-purple">@Model.Count() @Localizer["types"]</span>
    </div>
    <div class="wt-table-scroll">
        @if (Model.Any())
        {
            <table class="wt-table">
                <thead>
                    <tr>
                        <th>@Localizer["Name"]</th>
                        <th>@Localizer["Code"]</th>
                        <th>@Localizer["Status"]</th>
                        <th>@Localizer["Created At"]</th>
                        <th>@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Name</strong></td>
                            <td><span class="code-tag">@item.Code</span></td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-green"><span class="badge-dot"></span>@Localizer["Active"]</span>
                                }
                                else
                                {
                                    <span class="badge badge-red"><span class="badge-dot"></span>@Localizer["Inactive"]</span>
                                }
                            </td>
                            <td style="color: var(--admin-text-secondary);">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <div class="wt-actions">
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="wt-act-btn wt-act-edit" title="@Localizer["Edit"]">
                                        <i class='bx bx-edit'></i>
                                    </a>
                                    <form action="@Url.Action("Delete", new { id = item.Id })" method="post" data-confirm="@Localizer["Are you sure you want to delete this Wallet Type? This might affect users and plans."]" style="margin: 0;">
                                        <button type="submit" class="wt-act-btn wt-act-delete" title="@Localizer["Delete"]">
                                            <i class='bx bx-trash'></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-wt">
                <i class='bx bx-wallet'></i>
                <p>@Localizer["No wallet types found. Create one to get started."]</p>
            </div>
        }
    </div>
</div>

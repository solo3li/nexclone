@model IEnumerable<NexClone.Backend.Core.Entities.Plan>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NexClone.Backend.Localization.SharedResource> Localizer

@{
    ViewData["Title"] = "Pricing Plans";
}

<div class="bx--data-table-container">
    <div class="bx--data-table-header">
        <h4 class="bx--data-table-header__title">@Localizer["Manage Pricing Plans"]</h4>
        <p class="bx--data-table-header__description">@Localizer["View and manage all subscription plans imported from the legacy database."]</p>
    </div>

    <!-- Carbon Data Table -->
    <table class="bx--data-table bx--data-table--sort">
        <thead>
            <tr>
                <th><span class="bx--table-header-label">@Localizer["ID"]</span></th>
                <th><span class="bx--table-header-label">@Localizer["Plan Name"]</span></th>
                <th><span class="bx--table-header-label">@Localizer["Duration (Days)"]</span></th>
                <th><span class="bx--table-header-label">@Localizer["Price (USD)"]</span></th>
                <th><span class="bx--table-header-label">@Localizer["Price (EGP)"]</span></th>
                <th><span class="bx--table-header-label">@Localizer["Created At"]</span></th>
                <th><span class="bx--table-header-label">@Localizer["Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td><strong>@item.Name</strong></td>
                    <td>@item.DurationDays</td>
                    <td>$@item.PriceUsd</td>
                    <td>EGP @item.PriceEgp</td>
                    <td>@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                    <td>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" data-confirm="Are you sure you want to delete this plan?">
                            <button type="submit" class="bx--btn bx--btn--danger bx--btn--sm" style="padding: 5px 10px; font-size: 12px; height: auto; min-height: unset;">
                                @Localizer["Delete"]
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
